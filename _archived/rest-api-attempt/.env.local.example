# LPG-EHL API Local Development Environment Configuration
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control!

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lpg_ehl
DB_USER=lpg_user
DB_PASSWORD=lpg_dev_password

# Azure Storage (for cloud sync)
AZURE_ENABLED=false
AZURE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_QUEUE_NAME=lpg-transactions

# Security
API_AUTH_TOKEN=dev-token-12345

# Nets Cloud Connect Configuration
# Enable when you have credentials from Nets
NETS_CLOUD_ENABLED=false

# Nets API Credentials (provided by Nets)
NETS_CLOUD_URL=https://api.nets.eu/terminal/v1
NETS_CLOUD_USERNAME=your_username_here
NETS_CLOUD_PASSWORD=your_password_here
NETS_TERMINAL_ID=42696609
NETS_MERCHANT_ID=your_merchant_id_here

# Nets Polling Configuration (optional - defaults are usually fine)
NETS_TIMEOUT_SECONDS=30
NETS_POLLING_INTERVAL_MS=500
NETS_MAX_POLL_ATTEMPTS=120

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=local
