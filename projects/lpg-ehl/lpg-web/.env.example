# API Configuration - for LOCAL DEV only (npm run dev)
# For production build (build_monolith.sh): leave unset or use .env.production (empty)
# Production uses relative URLs so app works on any host (e.g. http://10.0.0.169:8080)
VITE_API_BASE_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080/api/v1
VITE_EMULATOR_BASE_URL=http://localhost:8080