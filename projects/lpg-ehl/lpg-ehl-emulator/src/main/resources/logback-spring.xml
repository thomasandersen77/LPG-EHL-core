<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- Custom appender to capture logs in memory for streaming to frontend -->
    <appender name="LOG_BUFFER" class="no.cloudberries.lpg.emulator.LogBufferAppender">
        <!-- No encoder needed - we capture structured data -->
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOG_BUFFER" />
    </root>

    <logger name="no.cloudberries.lpg" level="DEBUG" />
    <logger name="org.springframework" level="INFO" />
</configuration>
