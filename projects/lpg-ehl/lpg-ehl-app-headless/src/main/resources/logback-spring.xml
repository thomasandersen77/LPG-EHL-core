<?xml version="1.0" encoding="UTF-8"?>
<!--
  ═══════════════════════════════════════════════════════════════════════════════
  LPG-EHL HEADLESS - Logback konfigurasjon
  ═══════════════════════════════════════════════════════════════════════════════

  Bruker felles konfigurasjon fra lpg-ehl-core/logback-include.xml

  LOGGFILER (i ${LOG_DIR:-./logs}/):
    application.log  - App-logger (startup, services, transaksjoner)
    protocol.log     - TX/RX HEX + protokollmeldinger

  KONFIGURASJON:
    LOG_DIR=./release/logs java -jar lpg-ehl-headless.jar

  DEBUG AKTIVERING:
    java -Dlogging.level.no.cloudberries.lpg.protocol=DEBUG \
         -Dlogging.level.no.cloudberries.lpg.communication=DEBUG \
         -jar lpg-ehl-headless.jar

  ═══════════════════════════════════════════════════════════════════════════════
-->
<configuration>
    <!-- Inkluder felles konfigurasjon -->
    <include resource="logback-include.xml"/>

    <!-- Headless-spesifikke loggere -->
    <logger name="no.cloudberries.lpg.headless" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_APPLICATION"/>
    </logger>

    <logger name="no.cloudberries.lpg.headless.service.HeartbeatScheduler" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_APPLICATION"/>
    </logger>

    <logger name="no.cloudberries.lpg.headless.debug" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_APPLICATION"/>
    </logger>
</configuration>
