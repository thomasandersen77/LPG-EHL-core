# dnsmasq configuration for ARK fleet
# Managed by Ansible - do not edit manually

# Listen on specific interfaces only
{% for interface in ark_dnsmasq_listen_interfaces %}
interface={{ interface }}
{% endfor %}

# Don't read /etc/resolv.conf or /etc/hosts
no-resolv
no-hosts

# Bind to interfaces and don't listen on 0.0.0.0
bind-interfaces

# Add any custom configuration below
{% if ark_dnsmasq_dhcp_range is defined %}
dhcp-range={{ ark_dnsmasq_dhcp_range }}
{% endif %}
