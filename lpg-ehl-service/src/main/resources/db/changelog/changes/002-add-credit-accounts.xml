<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-customers-table" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="customers"/>
            </not>
        </preConditions>

        <createTable tableName="customers">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_number" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="phone" type="VARCHAR(50)"/>
            <column name="address_line1" type="VARCHAR(255)"/>
            <column name="address_line2" type="VARCHAR(255)"/>
            <column name="postal_code" type="VARCHAR(20)"/>
            <column name="city" type="VARCHAR(100)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="customers" indexName="idx_customers_number">
            <column name="customer_number"/>
        </createIndex>
        <createIndex tableName="customers" indexName="idx_customers_active">
            <column name="active"/>
        </createIndex>
        <createIndex tableName="customers" indexName="idx_customers_name">
            <column name="name"/>
        </createIndex>
    </changeSet>

    <changeSet id="002-create-credit-accounts-table" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="credit_accounts"/>
            </not>
        </preConditions>

        <createTable tableName="credit_accounts">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="UUID">
                <constraints nullable="false" 
                            foreignKeyName="fk_credit_account_customer"
                            references="customers(id)" 
                            deleteCascade="true"
                            unique="true"/>
            </column>
            <column name="balance_cents" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="credit_limit_cents" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_activity_at" type="TIMESTAMP"/>
            <column name="last_transaction_id" type="UUID">
                <constraints foreignKeyName="fk_credit_account_last_transaction"
                            references="transactions(id)"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="credit_accounts" indexName="idx_credit_customer">
            <column name="customer_id"/>
        </createIndex>
        <createIndex tableName="credit_accounts" indexName="idx_credit_active">
            <column name="active"/>
        </createIndex>
        <createIndex tableName="credit_accounts" indexName="idx_credit_balance">
            <column name="balance_cents"/>
        </createIndex>
    </changeSet>

    <changeSet id="002-add-credit-accounts-constraints" author="system">
        <sql>
            ALTER TABLE credit_accounts ADD CONSTRAINT balance_within_limit CHECK (balance_cents &lt;= credit_limit_cents);
        </sql>
    </changeSet>

    <changeSet id="002-add-payment-fields-to-transactions" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="transactions" columnName="payment_type"/>
            </not>
        </preConditions>

        <addColumn tableName="transactions">
            <column name="payment_type" type="VARCHAR(20)" defaultValue="CASH"/>
            <column name="customer_id" type="UUID">
                <constraints foreignKeyName="fk_transaction_customer"
                            references="customers(id)"/>
            </column>
            <column name="customer_name" type="VARCHAR(255)"/>
            <column name="includes_road_tax" type="BOOLEAN" defaultValueBoolean="true"/>
        </addColumn>

        <createIndex tableName="transactions" indexName="idx_transactions_customer">
            <column name="customer_id"/>
        </createIndex>
        <createIndex tableName="transactions" indexName="idx_transactions_payment_type">
            <column name="payment_type"/>
        </createIndex>
    </changeSet>

    <changeSet id="002-add-payment-type-constraints" author="system">
        <sql>
            ALTER TABLE transactions ADD CONSTRAINT valid_payment_type CHECK (payment_type IN ('CASH', 'CARD', 'CREDIT', 'VIPPS'));
        </sql>
    </changeSet>

</databaseChangeLog>
