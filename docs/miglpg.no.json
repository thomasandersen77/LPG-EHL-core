$done_url = '';
if ( 'accepted' === $status ) {
$done_url = wp_nonce_url(
add_query_arg(
array(
'minlpg_delivery_action' => 'deliver',
'order_id'               => $order_id,
)
),
'minlpg_delivery_action_' . $order_id
);
}
?>
<tr>
<td><?php echo esc_html( $date ); ?></td>
<td><?php echo esc_html( $cust_name ); ?></td>
<td><?php echo esc_html( $items ); ?></td>
