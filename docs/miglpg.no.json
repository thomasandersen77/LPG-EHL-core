 * (brukes både av kunde‑ og sjåfør‑dashbord)
 */
if ( ! function_exists( 'minlpg_get_delivery_items_summary' ) ) {
function minlpg_get_delivery_items_summary( $order_id ) {
$order_id = (int) $order_id;
if ( ! $order_id ) {
return '';
}

$map = array(
array(
'new'    => '_minlpg_qty_10kg',
'legacy' => '_minlpg_qty_small',
'label'  => '10 kg propan',
),
array(
'new'    => '_minlpg_qty_17kg',
'legacy' => '',
'label'  => '17 kg propan',
),
array(
'new'    => '_minlpg_qty_33kg',
'legacy' => '_minlpg_qty_big',
'label'  => '33 kg propan',
),
array(
'new'    => '_minlpg_qty_co2_13l',
'legacy' => '_minlpg_qty_co2',
'label'  => 'CO₂ 13 l',
),
array(
'new'    => '_minlpg_qty_nc20',
'legacy' => '',
'label'  => 'NC20',
),
array(
'new'    => '_minlpg_qty_nc50',
'legacy' => '',
'label'  => 'NC50',
),
);

$parts = array();

foreach ( $map as $info ) {
$q = get_post_meta( $order_id, $info['new'], true );
if ( '' === $q && $info['legacy'] ) {
$q = get_post_meta( $order_id, $info['legacy'], true );
}

$q = (int) $q;
if ( $q > 0 ) {
$parts[] = sprintf( '%d x %s', $q, $info['label'] );
}
}

return implode( ', ', $parts );
}
}

/**
 * Felles: håndter innsending av bestillingsskjema (privat/bedrift)
 *
 * @return array [ 'success' => bool, 'message' => string ]
 */
if ( ! function_exists( 'minlpg_handle_delivery_order_form' ) ) {
function minlpg_handle_delivery_order_form( WP_User $user, $order_type ) {

if ( empty( $_POST['minlpg_delivery_form'] ) ) {
return array(
'success' => false,
'message' => '',
);
}

if (
empty( $_POST['minlpg_delivery_nonce'] )
|| ! wp_verify_nonce(
sanitize_text_field( wp_unslash( $_POST['minlpg_delivery_nonce'] ) ),
'minlpg_delivery_order'
)
) {
return array(
'success' => false,
'message' => 'Ugyldig forespørsel. Last inn siden på nytt og prøv igjen.',
);
}

$order_type = ( 'bedrift_levering' === $order_type ) ? 'bedrift_levering' : 'priv_levering';

$station_id = minlpg_get_station_for_customer( $user->ID );
if ( ! $station_id ) {
return array(
'success' => false,
'message' => 'Denne brukeren er ikke koblet til en stasjon enda.',
);
}

// Mengder – alle negative verdier klippes til 0.
$qty_10   = isset( $_POST['minlpg_qty_10kg'] ) ? (int) $_POST['minlpg_qty_10kg'] : 0;
$qty_17   = isset( $_POST['minlpg_qty_17kg'] ) ? (int) $_POST['minlpg_qty_17kg'] : 0;
$qty_33   = isset( $_POST['minlpg_qty_33kg'] ) ? (int) $_POST['minlpg_qty_33kg'] : 0;
$qty_13l  = isset( $_POST['minlpg_qty_co2_13l'] ) ? (int) $_POST['minlpg_qty_co2_13l'] : 0;
$qty_nc20 = isset( $_POST['minlpg_qty_nc20'] ) ? (int) $_POST['minlpg_qty_nc20'] : 0;
$qty_nc50 = isset( $_POST['minlpg_qty_nc50'] ) ? (int) $_POST['minlpg_qty_nc50'] : 0;

$qty_10   = max( 0, $qty_10 );
$qty_17   = max( 0, $qty_17 );
$qty_33   = max( 0, $qty_33 );
$qty_13l  = max( 0, $qty_13l );
$qty_nc20 = max( 0, $qty_nc20 );
$qty_nc50 = max( 0, $qty_nc50 );

$total = $qty_10 + $qty_17 + $qty_33 + $qty_13l + $qty_nc20 + $qty_nc50;

if ( $total <= 0 ) {
return array(
'success' => false,
'message' => 'Velg minst én flaske eller CO₂‑levering.',
);
}

// Leveringsdato – må være kalenderfelt.
$today      = current_time( 'Y-m-d' );
$date_raw   = isset( $_POST['minlpg_delivery_date'] )
? sanitize_text_field( wp_unslash( $_POST['minlpg_delivery_date'] ) )
: '';
$valid_date = $today;

if ( $date_raw && preg_match( '/^\d{4}-\d{2}-\d{2}$/', $date_raw ) ) {
$valid_date = $date_raw;
}

// Kontaktinfo
$address = isset( $_POST['minlpg_delivery_address'] )
? sanitize_textarea_field( wp_unslash( $_POST['minlpg_delivery_address'] ) )
: '';

$contact_name = isset( $_POST['minlpg_delivery_contact'] )
? sanitize_text_field( wp_unslash( $_POST['minlpg_delivery_contact'] ) )
: '';

$phone = isset( $_POST['minlpg_delivery_phone'] )
? sanitize_text_field( wp_unslash( $_POST['minlpg_delivery_phone'] ) )
: '';

$note = isset( $_POST['minlpg_delivery_note'] )
? sanitize_textarea_field( wp_unslash( $_POST['minlpg_delivery_note'] ) )
: '';

$po_reference = '';
if ( 'bedrift_levering' === $order_type && isset( $_POST['minlpg_po_reference'] ) ) {
$po_reference = sanitize_text_field( wp_unslash( $_POST['minlpg_po_reference'] ) );
}

// Tittel – basert på produkter + stasjon + dato
$title_parts = array();
if ( $qty_10 ) {
$title_parts[] = $qty_10 . ' x 10 kg propan';
}
if ( $qty_17 ) {
$title_parts[] = $qty_17 . ' x 17 kg propan';
}
if ( $qty_33 ) {
$title_parts[] = $qty_33 . ' x 33 kg propan';
}
if ( $qty_13l ) {
$title_parts[] = $qty_13l . ' x CO₂ 13 l';
}
if ( $qty_nc20 ) {
$title_parts[] = $qty_nc20 . ' x NC20';
}
if ( $qty_nc50 ) {
$title_parts[] = $qty_nc50 . ' x NC50';
}

$station_label = minlpg_get_station_label( $station_id );
$date_label    = date_i18n( 'd.m.Y', strtotime( $valid_date ) );

$title = sprintf(
'%s – %s – levering %s',
implode( ', ', $title_parts ),
$station_label,
$date_label
);

$post_id = wp_insert_post(
array(
'post_type'   => 'minlpg_delivery',
'post_title'  => $title,
'post_status' => 'publish',
),
true
);

if ( is_wp_error( $post_id ) ) {
return array(
'success' => false,
'message' => 'Teknisk feil ved lagring av ordre.',
);
}

// Standard meta
update_post_meta( $post_id, '_minlpg_order_type', $order_type );
update_post_meta( $post_id, '_minlpg_order_station', $station_id );
update_post_meta( $post_id, '_minlpg_order_customer', $user->ID );
update_post_meta( $post_id, '_minlpg_order_status', 'new' );
update_post_meta( $post_id, '_minlpg_delivery_date', $valid_date );
update_post_meta( $post_id, '_minlpg_created_at', current_time( 'mysql' ) );

// Mengder – nye nøkler + gamle for bakoverkomp.
update_post_meta( $post_id, '_minlpg_qty_10kg', $qty_10 );
update_post_meta( $post_id, '_minlpg_qty_17kg', $qty_17 );
update_post_meta( $post_id, '_minlpg_qty_33kg', $qty_33 );
update_post_meta( $post_id, '_minlpg_qty_co2_13l', $qty_13l );
update_post_meta( $post_id, '_minlpg_qty_nc20', $qty_nc20 );
update_post_meta( $post_id, '_minlpg_qty_nc50', $qty_nc50 );

// gamle nøkler
update_post_meta( $post_id, '_minlpg_qty_small', $qty_10 );
update_post_meta( $post_id, '_minlpg_qty_big', $qty_33 );
update_post_meta( $post_id, '_minlpg_qty_co2', $qty_13l );

// Øvrig info
update_post_meta( $post_id, '_minlpg_delivery_address', $address );
update_post_meta( $post_id, '_minlpg_delivery_contact', $contact_name );
update_post_meta( $post_id, '_minlpg_delivery_phone', $phone );
update_post_meta( $post_id, '_minlpg_delivery_note', $note );
update_post_meta( $post_id, '_minlpg_po_reference', $po_reference );

return array(
'success' => true,
'message' => 'Bestillingen er registrert og sendes til stasjonen.',
);
}
}

