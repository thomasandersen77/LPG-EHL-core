if ( ! function_exists( 'minlpg_bootstrap_caps' ) ) {
function minlpg_bootstrap_caps() {
$version = '2025-12-16.1';
$opt_key = 'minlpg_caps_version';

if ( get_option( $opt_key ) === $version ) {
return;
}

$map = array(
'stasjonseier'   => array(
'minlpg_manage_station_pricing',
'minlpg_manage_klippekort',
),
'lpg_admin'      => array(
'minlpg_manage_station_pricing',
'minlpg_manage_klippekort',
'minlpg_manage_credit',
),
'administrator'  => array(
'minlpg_manage_station_pricing',
'minlpg_manage_klippekort',
'minlpg_manage_credit',
),
);

foreach ( $map as $role_name => $caps ) {
$role = get_role( $role_name );
if ( ! $role ) {
continue;
}
foreach ( $caps as $cap ) {
$role->add_cap( $cap, true );
}
}

update_option( $opt_key, $version, false );
}
add_action( 'init', 'minlpg_bootstrap_caps', 1 );
}

/**
 * Audit-logg: wp_{prefix}minlpg_audit_log
 */
if ( ! function_exists( 'minlpg_audit_install' ) ) {
function minlpg_audit_install() {
global $wpdb;

$version = '2025-12-16.1';
$opt_key = 'minlpg_audit_table_version';

if ( get_option( $opt_key ) === $version ) {
return;
}

$table_name      = $wpdb->prefix . 'minlpg_audit_log';
$charset_collate = $wpdb->get_charset_collate();

$sql = "CREATE TABLE {$table_name} (
id BIGINT(20) UNSIGNED NOT NULL AUTO_INCREMENT,
created_at DATETIME NOT NULL,
action VARCHAR(64) NOT NULL,
actor_user_id BIGINT(20) UNSIGNED NOT NULL DEFAULT 0,
station_id BIGINT(20) UNSIGNED NULL DEFAULT NULL,
target_user_id BIGINT(20) UNSIGNED NULL DEFAULT NULL,
dispenser_id VARCHAR(64) NULL DEFAULT NULL,
ip VARCHAR(45) NULL DEFAULT NULL,
user_agent TEXT NULL,
old_value LONGTEXT NULL,
new_value LONGTEXT NULL,
meta LONGTEXT NULL,
PRIMARY KEY  (id),
KEY action (action),
KEY actor_user_id (actor_user_id),
KEY station_id (station_id),
KEY target_user_id (target_user_id),
KEY created_at (created_at)
) {$charset_collate};";

if ( defined( 'ABSPATH' ) ) {
require_once ABSPATH . 'wp-admin/includes/upgrade.php';
dbDelta( $sql );
update_option( $opt_key, $version, false );
}
}
add_action( 'init', 'minlpg_audit_install', 2 );
}

if ( ! function_exists( 'minlpg_audit_log_event' ) ) {
function minlpg_audit_log_event( $action, array $data = array() ) {
global $wpdb;

$table_name = $wpdb->prefix . 'minlpg_audit_log';
$now_gmt    = current_time( 'mysql', true );

$actor_id  = get_current_user_id();
$station_id = isset( $data['station_id'] ) ? (int) $data['station_id'] : null;
$target_id  = isset( $data['target_user_id'] ) ? (int) $data['target_user_id'] : null;
$disp_id    = isset( $data['dispenser_id'] ) ? sanitize_title( (string) $data['dispenser_id'] ) : null;

$old_value = isset( $data['old'] ) ? wp_json_encode( $data['old'], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES ) : null;
$new_value = isset( $data['new'] ) ? wp_json_encode( $data['new'], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES ) : null;

$meta = $data;
unset( $meta['old'], $meta['new'] );
$meta_json = wp_json_encode( $meta, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES );

$wpdb->insert(
$table_name,
array(
'created_at'    => $now_gmt,
'action'        => sanitize_key( (string) $action ),
'actor_user_id' => (int) $actor_id,
'station_id'    => $station_id,
'target_user_id'=> $target_id,
'dispenser_id'  => $disp_id,
'ip'            => minlpg_get_client_ip(),
'user_agent'    => isset( $_SERVER['HTTP_USER_AGENT'] ) ? substr( (string) $_SERVER['HTTP_USER_AGENT' ], 0, 1000 ) : '',
'old_value'     => $old_value,
'new_value'     => $new_value,
'meta'          => $meta_json,
),
array(
'%s','%s','%d','%d','%d','%s','%s','%s','%s','%s','%s',
)
);
}
}

