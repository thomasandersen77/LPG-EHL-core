'omsetning' => 'Omsetningsrapport',
'veibruk'   => 'Veibruksavgift',
'uttak'     => 'Uttaksrapport',
);

// Unikt navn for avgifts-radioer → ingen kollisjon hvis flere pumper på samme side
$group_suffix      = $station_id ? $station_id . '_' . $dispenser_id : 'x_' . $dispenser_id;
$avgift_group_name = 'minlpg_avgift_mode_' . $group_suffix;

// Unique scope for the arm-flow JS
$arm_scope = preg_replace( '/[^a-zA-Z0-9_\-]/', '_', (string) $group_suffix );

// Print arm-modal CSS once (only when needed)
static $minlpg_arm_assets_printed = false;
