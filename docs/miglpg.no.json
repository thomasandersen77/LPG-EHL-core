$address    = ! empty( $header['address'] ) ? $header['address'] : get_user_meta( $station_id, 'minlpg_address', true );

$credit  = (float) get_user_meta( $user->ID, 'minlpg_credit_limit', true );
$balance = (float) get_user_meta( $user->ID, 'minlpg_credit_balance', true );

