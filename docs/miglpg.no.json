if ( ! function_exists( 'minlpg_get_allowed_receipt_hosts' ) ) {
function minlpg_get_allowed_receipt_hosts() {
$hosts = array();

$home_host = wp_parse_url( home_url(), PHP_URL_HOST );
if ( $home_host ) {
$hosts[] = strtolower( $home_host );
}

// Demo PDF-host (brukes i demo-data i portalen)
$hosts[] = 'www.w3.org';

$hosts = array_values( array_unique( array_filter( $hosts ) ) );

/**
         * Filter: legg til API-host(s) her.
         * Eksempel:
         * add_filter('minlpg_allowed_receipt_hosts', fn($h) => array_merge($h, ['api.dittdomene.no']));
         */
return apply_filters( 'minlpg_allowed_receipt_hosts', $hosts );
}
}

if ( ! function_exists( 'minlpg_validate_receipt_remote_url' ) ) {
function minlpg_validate_receipt_remote_url( $url ) {
$url = trim( (string) $url );
if ( '' === $url ) {
return false;
}

$url = esc_url_raw( $url );
if ( ! $url ) {
return false;
}

// wp_http_validate_url finnes i WP core (nyttig ekstra sjekk)
if ( function_exists( 'wp_http_validate_url' ) && ! wp_http_validate_url( $url ) ) {
return false;
}

$parts = wp_parse_url( $url );
if ( ! is_array( $parts ) ) {
return false;
}

$scheme = isset( $parts['scheme'] ) ? strtolower( (string) $parts['scheme'] ) : '';
$host   = isset( $parts['host'] ) ? strtolower( (string) $parts['host'] ) : '';
$port   = isset( $parts['port'] ) ? (int) $parts['port'] : 0;

if ( 'https' !== $scheme ) {
return false;
}
if ( ! $host ) {
return false;
}
if ( $port && 443 !== $port ) {
return false;
}

$allowed_hosts = minlpg_get_allowed_receipt_hosts();
if ( ! in_array( $host, $allowed_hosts, true ) ) {
return false;
}

// Blokker direkte private/reserverte IP-er.
if ( filter_var( $host, FILTER_VALIDATE_IP ) ) {
if ( ! filter_var( $host, FILTER_VALIDATE_IP, FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE ) ) {
return false;
}
} else {
$ip = gethostbyname( $host );
if ( $ip && $ip !== $host ) {
if ( filter_var( $ip, FILTER_VALIDATE_IP ) && ! filter_var( $ip, FILTER_VALIDATE_IP, FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE ) ) {
return false;
}
}
}

return true;
}
}

if ( ! function_exists( 'minlpg_receipt_register_remote_url' ) ) {
function minlpg_receipt_register_remote_url( $url, $ttl = 21600 ) {
$url = trim( (string) $url );
if ( '' === $url ) {
return '';
}

// Vi validerer ved henting også, men vi kan stoppe tidlig for bedre UX.
if ( ! minlpg_validate_receipt_remote_url( $url ) ) {
return '';
}

try {
$token = bin2hex( random_bytes( 16 ) );
} catch ( Exception $e ) {
$token = wp_generate_password( 32, false, false );
}

$key = 'minlpg_receipt_src_' . $token;
set_transient( $key, $url, (int) $ttl );

return $token;
}
}

if ( ! function_exists( 'minlpg_receipt_lookup_remote_url' ) ) {
function minlpg_receipt_lookup_remote_url( $token ) {
$token = preg_replace( '/[^a-f0-9]/', '', strtolower( (string) $token ) );
if ( ! $token ) {
return '';
}

$key = 'minlpg_receipt_src_' . $token;
$url = get_transient( $key );
return is_string( $url ) ? $url : '';
}
}



