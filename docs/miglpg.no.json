// Lagre klippekort-størrelse for denne stasjonen (standard kortstørrelse)
if (
isset( $_POST['minlpg_klippekort_size_nonce'], $_POST['minlpg_klippekort_size'] )
&& wp_verify_nonce( $_POST['minlpg_klippekort_size_nonce'], 'minlpg_klippekort_size_save' )
) {
$new_size = (int) $_POST['minlpg_klippekort_size'];
if ( $new_size < 2 ) {
$new_size = 2;
}

if ( function_exists( 'minlpg_update_station_klippekort_size' ) ) {
minlpg_update_station_klippekort_size( $user->ID, $new_size );
} else {
update_user_meta( $user->ID, 'minlpg_klippekort_default', $new_size );
}
}

