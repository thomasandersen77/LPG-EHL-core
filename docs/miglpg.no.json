/**
 * STASJONSEIER DASHBOARD – shortcode: [minlpg_stasjonseier]
 *
 * Denne bruker den delte dispenser-komponenten.
 */
function minlpg_owner_dashboard_shortcode() {
list( $ok, $data ) = minlpg_require_role( array( 'stasjonseier', 'lpg_admin', 'administrator' ) );
if ( ! $ok ) {
return $data;
}

/** @var WP_User $user */
$user = $data;

// Admin AJAX + nonce (stasjonsstatus)
$admin_ajax_url      = admin_url( 'admin-ajax.php' );
$station_status_nonce = wp_create_nonce( 'minlpg_station_status' );

// Stasjons-ID (S001 etc.)
$station_code = minlpg_get_station_code( $user->ID );

// Lagre klippekort-størrelse for denne stasjonen (standard kortstørrelse)
if (
isset( $_POST['minlpg_klippekort_size_nonce'], $_POST['minlpg_klippekort_size'] )
&& wp_verify_nonce( $_POST['minlpg_klippekort_size_nonce'], 'minlpg_klippekort_size_save' )
) {
$new_size = (int) $_POST['minlpg_klippekort_size'];
if ( $new_size < 2 ) {
$new_size = 2;
}

if ( function_exists( 'minlpg_update_station_klippekort_size' ) ) {
minlpg_update_station_klippekort_size( $user->ID, $new_size );
} else {
update_user_meta( $user->ID, 'minlpg_klippekort_default', $new_size );
}
}

if ( function_exists( 'minlpg_get_station_klippekort_size' ) ) {
$klippekort_size = minlpg_get_station_klippekort_size( $user->ID );
} else {
$klippekort_size = (int) get_user_meta( $user->ID, 'minlpg_klippekort_default', true );
if ( $klippekort_size < 2 ) {
$klippekort_size = 8;
}
}

// Hent juridisk navn + org.nr + adresse fra brukerprofil
$legal_name = get_user_meta( $user->ID, 'minlpg_legal_name', true );
$org_number = get_user_meta( $user->ID, 'minlpg_org_number', true );
