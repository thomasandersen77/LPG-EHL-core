<script>
(function () {
try { console.debug('[Min LPG] Dashboard JS v3.8 loaded'); } catch (e) {}

function minlpgOnReady(fn) {
if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', fn);
} else {
fn();
}
}

function minlpgEach(list, fn) {
if (!list || !fn) return;
for (var i = 0; i < list.length; i++) {
fn(list[i], i);
}
}

function minlpgFormatNOK(value) {
var num = parseFloat(String(value).replace(',', '.'));
if (isNaN(num)) {
num = 0;
}
return num.toFixed(2).replace('.', ',');
}

function minlpgMatches(el, selector) {
if (!el || el.nodeType !== 1) return false;
var proto = el.matches || el.msMatchesSelector || el.webkitMatchesSelector || el.mozMatchesSelector;
if (proto) {
return proto.call(el, selector);
}
// Very old fallback
var nodes = (el.ownerDocument || document).querySelectorAll(selector);
for (var i = 0; i < nodes.length; i++) {
if (nodes[i] === el) return true;
}
return false;
}

function minlpgClosest(el, selector) {
var cur = el;
while (cur && cur.nodeType === 1) {
if (minlpgMatches(cur, selector)) return cur;
cur = cur.parentElement;
}
return null;
}

function minlpgPostJSON(url, formData, onOk, onErr) {
onOk = onOk || function () {};
onErr = onErr || function () {};

if (!url) {
onErr(new Error('Mangler AJAX URL.'));
return;
}

// Prefer fetch when available
if (window.fetch) {
try {
window.fetch(url, {
method: 'POST',
credentials: 'same-origin',
body: formData
})
.then(function (r) { return r.json(); })
.then(function (json) { onOk(json); })
.catch(function (err) { onErr(err); });
return;
} catch (e) {
// fall through to XHR
}
}

// XHR fallback
try {
var xhr = new XMLHttpRequest();
xhr.open('POST', url, true);
try { xhr.withCredentials = true; } catch (e) {}

xhr.onreadystatechange = function () {
if (xhr.readyState !== 4) return;
var text = xhr.responseText || '';
var json = null;
try {
json = JSON.parse(text);
} catch (e) {
onErr(new Error('Ugyldig JSON-respons fra server.'));
return;
}
onOk(json);
};

xhr.onerror = function () {
onErr(new Error('Nettverksfeil ved kall til server.'));
};

xhr.send(formData);
} catch (e) {
onErr(e);
}
}

function minlpgSafe(fn) {
try {
fn();
} catch (e) {
if (window.console && console.error) {
console.error('MinLPG JS error:', e);
}
}
}

function minlpgSetClass(el, cls, on) {
if (!el || !cls) return;
cls = String(cls);

if (el.classList && el.classList.add && el.classList.remove) {
if (on) {
el.classList.add(cls);
} else {
el.classList.remove(cls);
}
return;
}

var cur = (el.className || '').toString();
var parts = cur.split(/\s+/);
var out = [];

for (var i = 0; i < parts.length; i++) {
var p = parts[i];
if (!p) continue;
if (p === cls) continue;
out.push(p);
}

if (on) {
out.push(cls);
}

el.className = out.join(' ');
}

function initPumpCardsPriceMode() {
minlpgEach(document.querySelectorAll('.minlpg-pump-card'), function (card) {
if (!card || card._minlpgPriceInit) return;
card._minlpgPriceInit = true;

var radios       = card.querySelectorAll('input[type="radio"][data-minlpg-avgift="1"]');
var boxes        = card.querySelectorAll('.minlpg-price-box-toggle');
var priceDisplay = card.querySelector('.minlpg-metric-display-price');

function getMode() {
var checked = card.querySelector('input[type="radio"][data-minlpg-avgift="1"]:checked');
return checked ? checked.value : 'med';
}

function getPriceForMode(mode) {
if (mode === 'uten') {
return card.dataset.priceUten || card.getAttribute('data-price-uten') || '0';
}
return card.dataset.priceMed || card.getAttribute('data-price-med') || '0';
}

function updateUI() {
var mode = getMode();

// Toggle blå/oransje kort
minlpgEach(boxes, function (box) {
if (!box) return;
var should = (box.getAttribute('data-price') === mode);
minlpgSetClass(box, 'is-active', should);
});

// Oppdater store "Pris, KR/L"-kortet
if (priceDisplay) {
var raw = getPriceForMode(mode);
priceDisplay.textContent = minlpgFormatNOK(raw);
}
}

minlpgEach(radios, function (radio) {
if (!radio) return;
radio.addEventListener('change', updateUI);
});

// eksponer så modal-save kan trigge oppdatering
card._minlpgUpdateUI = updateUI;

// init
updateUI();
});
}

function initPayMethodButtons() {
minlpgEach(document.querySelectorAll('.minlpg-pump-card'), function (card) {
if (!card || card._minlpgPayInit) return;

var payButtons = card.querySelectorAll('[data-minlpg-pay-method]');
if (!payButtons || payButtons.length === 0) {
return;
}

card._minlpgPayInit = true;

function setActive(method) {
method = (method || 'terminal').toString().toLowerCase();
if (method !== 'credit' && method !== 'terminal') {
method = 'terminal';
}

// Persist on the card (readable by integrations)
card.dataset.minlpgPaymentMethod = method;

