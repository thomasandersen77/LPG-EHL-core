/**
 * Helper to build a secure download URL for en kvittering / rapport.
 *
 * Når API-et gir deg en kvitterings‑URL eller et rapport‑URL,
 * kan du bare sende den inn her.
 *
 * NYTT:
 *  - valgfri $station_id gjør at vi kan lage en PDF-template med header for stasjonen.
 *  - valgfri $period (tekst) gjør at PDF-templaten kan vise "Valgt periode" i headeren.
 */
function minlpg_get_receipt_download_url( $remote_pdf_url, $receipt_id = 'kvittering', $station_id = 0, $period = '' ) {
$query_args = array(
'action'   => 'minlpg_download_receipt',
'_wpnonce' => wp_create_nonce( 'minlpg_download_receipt' ),
'src'      => rawurlencode( base64_encode( $remote_pdf_url ) ),
'id'       => sanitize_title( $receipt_id ),
);

$station_id = (int) $station_id;
if ( $station_id > 0 ) {
$query_args['station_id'] = $station_id;
}

if ( '' !== $period ) {
$period = sanitize_text_field( $period );
if ( '' !== $period ) {
$query_args['period'] = $period;
}
}

return add_query_arg( $query_args, admin_url( 'admin-ajax.php' ) );
}

/**
 * Helper: escape tekst for PDF content stream.
 * Nå med støtte for norske tegn (ÅÆØåæø) via Windows-1252 / WinAnsiEncoding.
 */
if ( ! function_exists( 'minlpg_pdf_escape_text' ) ) {
function minlpg_pdf_escape_text( $text ) {
$text = (string) $text;

// Konverter fra UTF-8 til Windows-1252 (samme som WinAnsiEncoding i PDF).
// //IGNORE = behold tegn som finnes i 1252 (inkl. norske bokstaver),
// dropp kun de som ikke støttes.
if ( function_exists( 'iconv' ) ) {
$converted = @iconv( 'UTF-8', 'Windows-1252//IGNORE', $text );
if ( false !== $converted ) {
$text = $converted;
}
} elseif ( function_exists( 'utf8_decode' ) ) {
// Fallback – ISO-8859-1 ligger tett nok på for våre vestlige tegn.
$text = utf8_decode( $text );
}

// Escape spesialtegn i PDF-strenger
$text = str_replace(
array( '\\', '(', ')' ),
array( '\\\\', '\\(', '\\)' ),
$text
);

// Fjern rare kontrolltegn
$text = preg_replace( '/[^\x09\x0A\x0D\x20-\x7E\x80-\xFF]/', '', $text );

return $text;
}
}


/**
 * Bygg en veldig enkel PDF med kun header (tittel + linjer).
 * Body kan fylles inn senere når API kobles til.
 * Bruker /Helvetica med /WinAnsiEncoding slik at ÅÆØåæø vises riktig.
 */
if ( ! function_exists( 'minlpg_build_simple_pdf' ) ) {
function minlpg_build_simple_pdf( $title, $lines = array() ) {
$title = minlpg_pdf_escape_text( $title );
$lines = array_map( 'minlpg_pdf_escape_text', $lines );

$stream_parts   = array();

// Tittel
$stream_parts[] = 'BT';
$stream_parts[] = '/F1 18 Tf';
$stream_parts[] = '50 800 Td';
$stream_parts[] = '(' . $title . ') Tj';
$stream_parts[] = 'ET';

// Header-linjer
$y = 770;
foreach ( $lines as $line ) {
$stream_parts[] = 'BT';
$stream_parts[] = '/F1 11 Tf';
$stream_parts[] = '50 ' . $y . ' Td';
$stream_parts[] = '(' . $line . ') Tj';
$stream_parts[] = 'ET';
$y -= 16;
}

$stream = implode( "\n", $stream_parts ) . "\n";
$len    = strlen( $stream );

// Minimal PDF-struktur
$pdf     = "%PDF-1.4\n";
$offsets = array();

// 1: Catalog
$offsets[1] = strlen( $pdf );
$pdf       .= "1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n";

// 2: Pages
$offsets[2] = strlen( $pdf );
$pdf       .= "2 0 obj\n<< /Type /Pages /Count 1 /Kids [3 0 R] >>\nendobj\n";

// 5: Font – viktig del: /Encoding /WinAnsiEncoding
$offsets[5] = strlen( $pdf );
$pdf       .= "5 0 obj\n"
. "<< /Type /Font /Subtype /Type1 "
. "/BaseFont /Helvetica "
. "/Encoding /WinAnsiEncoding >>\n"
. "endobj\n";

// 4: Content stream
$offsets[4] = strlen( $pdf );
$pdf       .= "4 0 obj\n<< /Length $len >>\nstream\n$stream\nendstream\nendobj\n";

// 3: Page
$offsets[3] = strlen( $pdf );
$pdf       .= "3 0 obj\n"
. "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] "
. "/Contents 4 0 R "
. "/Resources << /Font << /F1 5 0 R >> >> >>\n"
. "endobj\n";

// xref
$xref_offset = strlen( $pdf );
$pdf        .= "xref\n0 6\n";
$pdf        .= "0000000000 65535 f \n";
for ( $i = 1; $i <= 5; $i++ ) {
$off = isset( $offsets[ $i ] ) ? $offsets[ $i ] : 0;
$pdf .= sprintf( "%010d 00000 n \n", $off );
}

$pdf .= "trailer\n<< /Size 6 /Root 1 0 R >>\n";
$pdf .= "startxref\n" . $xref_offset . "\n%%EOF";

return $pdf;
}
}


/**
 * AJAX handler that proxies a remote PDF and forces download
 *
 * Nå også: hvis station_id er satt, lager vi en tom PDF-template
 * med korrekt stasjons-header.
 */
function minlpg_ajax_download_receipt() {

if ( ! is_user_logged_in() ) {
wp_die( __( 'Du må være innlogget for å laste ned kvitteringen.', 'minlpg' ) );
}

if ( ! check_ajax_referer( 'minlpg_download_receipt', '_wpnonce', false ) ) {
wp_die( __( 'Ugyldig forespørsel.', 'minlpg' ) );
}

$receipt_id = isset( $_GET['id'] )
? sanitize_title( wp_unslash( $_GET['id'] ) )
: 'kvittering';

$station_id = isset( $_GET['station_id'] ) ? (int) $_GET['station_id'] : 0;

$chosen_period = '';
if ( isset( $_GET['period'] ) ) {
$chosen_period = sanitize_text_field( wp_unslash( $_GET['period'] ) );
}

/**
     * NY MODE: hvis vi har station_id → generer en enkel PDF med header.
     * Body er tom nå, og kan fylles inn når API-et er koblet til.
     */
if ( $station_id > 0 ) {
$header = minlpg_get_station_header_data( $station_id );

// Tittel basert på id-slug (veldig enkel heuristikk)
$title = 'Kvittering';
if ( false !== strpos( $receipt_id, 'omsetning' ) ) {
$title = 'Omsetningsrapport';
} elseif ( false !== strpos( $receipt_id, 'veibruk' ) || false !== strpos( $receipt_id, 'veibruksavgift' ) ) {
$title = 'Veibruksavgift';
} elseif ( false !== strpos( $receipt_id, 'uttak' ) ) {
$title = 'Uttaksrapport';
} elseif ( false !== strpos( $receipt_id, 'rapport' ) ) {
$title = 'Rapport';
}

$header_lines = array();

$station_label = trim(
$header['station_name'] .
( $header['station_code'] ? ' – ' . $header['station_code'] : '' )
);
if ( $station_label ) {
$header_lines[] = $station_label;
}

if ( $header['legal_name'] ) {
$header_lines[] = 'Juridisk navn: ' . $header['legal_name'];
}

if ( $header['org_number'] ) {
$header_lines[] = 'Org.nr: ' . $header['org_number'];
}

if ( $header['address'] ) {
$header_lines[] = 'Adresse: ' . $header['address'];
}

if ( empty( $header_lines ) ) {
$header_lines[] = 'Stasjons-ID: ' . $station_id;
}

if ( $chosen_period ) {
$header_lines[] = 'Valgt periode: ' . $chosen_period;
}

$pdf_body = minlpg_build_simple_pdf( $title, $header_lines );

if ( ob_get_length() ) {
ob_end_clean();
}

nocache_headers();
header( 'Content-Type: application/pdf' );
header( 'Content-Disposition: attachment; filename="' . $receipt_id . '.pdf"' );
header( 'Content-Length: ' . strlen( $pdf_body ) );

echo $pdf_body;
exit;
}

/**
     * Fallback: gammel logikk – proxy et ferdig PDF-dokument fra et eksternt API.
     * Denne brukes fortsatt for gamle lenker uten station_id.
     */
$src_param  = isset( $_GET['src'] ) ? wp_unslash( $_GET['src'] ) : '';
$src_param  = $src_param ? rawurldecode( $src_param ) : '';
$remote_url = $src_param ? base64_decode( $src_param ) : '';

if ( ! $remote_url || ! filter_var( $remote_url, FILTER_VALIDATE_URL ) ) {
wp_die( __( 'Kvitteringsfil er ikke konfigurert enda.', 'minlpg' ) );
}

$response = wp_remote_get( $remote_url, array( 'timeout' => 20 ) );

if ( is_wp_error( $response ) ) {
wp_die( __( 'Kunne ikke hente kvitteringen fra serveren.', 'minlpg' ) );
}

$code = (int) wp_remote_retrieve_response_code( $response );
if ( 200 !== $code ) {
wp_die( sprintf( __( 'Serveren returnerte en feil (%d).', 'minlpg' ), $code ) );
}

$body = wp_remote_retrieve_body( $response );
if ( '' === $body ) {
wp_die( __( 'Kvitteringen er tom eller utilgjengelig.', 'minlpg' ) );
}

$content_type = wp_remote_retrieve_header( $response, 'content-type' );
if ( ! $content_type ) {
$content_type = 'application/pdf';
}

if ( ob_get_length() ) {
ob_end_clean();
}

nocache_headers();
header( 'Content-Type: ' . $content_type );
header( 'Content-Disposition: attachment; filename="' . $receipt_id . '.pdf"' );
header( 'Content-Length: ' . strlen( $body ) );

echo $body;
exit;
}
add_action( 'wp_ajax_minlpg_download_receipt', 'minlpg_ajax_download_receipt' );

/**
 * Helper: hent / oppdater dispenser-priser per stasjon.
 *
 * Lagres i user_meta på stasjonseier:
 *  meta-key: minlpg_dispenser_prices
 *  value: array(
 *      'main' => array( 'med' => 18.9, 'uten' => 14.5 ),
 *      'pump2' => ...
 *  )
 */
if ( ! function_exists( 'minlpg_get_dispenser_prices' ) ) {
function minlpg_get_dispenser_prices( $station_id, $dispenser_id = 'main', $defaults = array() ) {
$station_id   = (int) $station_id;
$dispenser_id = sanitize_title( $dispenser_id );

$defaults = wp_parse_args(
$defaults,
array(
'med'  => '18.90',
'uten' => '14.50',
)
);

if ( ! $station_id || ! $dispenser_id ) {
return $defaults;
}

$all = get_user_meta( $station_id, 'minlpg_dispenser_prices', true );
if ( ! is_array( $all ) || ! isset( $all[ $dispenser_id ] ) || ! is_array( $all[ $dispenser_id ] ) ) {
return $defaults;
}

$prices = wp_parse_args( $all[ $dispenser_id ], $defaults );

// Normaliser til "18.90" / "14.50" (punkt som desimal)
foreach ( $prices as $key => $val ) {
$num            = (float) str_replace( ',', '.', (string) $val );
$prices[ $key ] = number_format( $num, 2, '.', '' );
}

return $prices;
}
}

if ( ! function_exists( 'minlpg_update_dispenser_prices' ) ) {
function minlpg_update_dispenser_prices( $station_id, $dispenser_id, $price_med, $price_uten ) {
$station_id   = (int) $station_id;
$dispenser_id = sanitize_title( $dispenser_id );

if ( ! $station_id || ! $dispenser_id ) {
return false;
}

$all = get_user_meta( $station_id, 'minlpg_dispenser_prices', true );
if ( ! is_array( $all ) ) {
$all = array();
}

$all[ $dispenser_id ] = array(
'med'  => (float) str_replace( ',', '.', (string) $price_med ),
'uten' => (float) str_replace( ',', '.', (string) $price_uten ),
);

return (bool) update_user_meta( $station_id, 'minlpg_dispenser_prices', $all );
}
}

/**
 * AJAX: lagre nye priser fra "Endre pris"-modalen (stasjonseier)
 */
function minlpg_ajax_save_price() {

if ( ! is_user_logged_in() ) {
wp_send_json_error( 'Du må være innlogget for å endre pris.' );
}

$current_user = wp_get_current_user();
$roles        = (array) $current_user->roles;
$allowed      = array( 'stasjonseier', 'lpg_admin', 'administrator' );
$has_role     = false;

foreach ( $allowed as $role ) {
if ( in_array( $role, $roles, true ) ) {
$has_role = true;
break;
}
}

if ( ! $has_role ) {
wp_send_json_error( 'Du har ikke rettigheter til å endre pris.' );
}

$nonce = isset( $_POST['nonce'] ) ? sanitize_text_field( wp_unslash( $_POST['nonce'] ) ) : '';
if ( ! wp_verify_nonce( $nonce, 'minlpg_save_price' ) ) {
wp_send_json_error( 'Ugyldig forespørsel.' );
}

$station_id = isset( $_POST['station_id'] ) ? (int) $_POST['station_id'] : 0;
if ( ! $station_id ) {
// fallback til innlogget stasjonseier
$station_id = (int) $current_user->ID;
}

$dispenser_id_raw = isset( $_POST['dispenser_id'] ) ? wp_unslash( $_POST['dispenser_id'] ) : 'main';
$dispenser_id     = sanitize_title( $dispenser_id_raw );

$price_med_raw  = isset( $_POST['price_med'] ) ? wp_unslash( $_POST['price_med'] ) : '';
$price_uten_raw = isset( $_POST['price_uten'] ) ? wp_unslash( $_POST['price_uten'] ) : '';

$price_med  = (float) str_replace( ',', '.', (string) $price_med_raw );
$price_uten = (float) str_replace( ',', '.', (string) $price_uten_raw );

if ( $price_med < 0 || $price_uten < 0 ) {
wp_send_json_error( 'Pris kan ikke være negativ.' );
}

$ok = minlpg_update_dispenser_prices( $station_id, $dispenser_id, $price_med, $price_uten );
if ( ! $ok ) {
wp_send_json_error( 'Kunne ikke lagre pris.' );
}

// Normaliser tall til "18.90" / "14.50" for frontenden
$price_med_str  = number_format( $price_med, 2, '.', '' );
$price_uten_str = number_format( $price_uten, 2, '.', '' );

wp_send_json_success(
array(
'station_id'   => $station_id,
'dispenser_id' => $dispenser_id,
'price_med'    => $price_med_str,
'price_uten'   => $price_uten_str,
)
);
}
add_action( 'wp_ajax_minlpg_save_price', 'minlpg_ajax_save_price' );

/**
 * AJAX: set station status (ACTIVE/INACTIVE) – admin only
 * action: minlpg_set_station_status
 */
if ( ! function_exists( 'minlpg_ajax_set_station_status' ) ) {
function minlpg_ajax_set_station_status() {

if ( ! is_user_logged_in() ) {
wp_send_json_error( array( 'message' => 'Ikke innlogget.' ), 401 );
}

// Nonce
$nonce = isset( $_POST['nonce'] ) ? sanitize_text_field( wp_unslash( $_POST['nonce'] ) ) : '';
if ( ! wp_verify_nonce( $nonce, 'minlpg_station_status' ) ) {
wp_send_json_error( array( 'message' => 'Ugyldig sikkerhetstoken.' ), 403 );
}

// Role gate
$user  = wp_get_current_user();
$roles = $user ? (array) $user->roles : array();
if ( ! ( in_array( 'administrator', $roles, true ) || in_array( 'lpg_admin', $roles, true ) ) ) {
wp_send_json_error( array( 'message' => 'Du har ikke tilgang.' ), 403 );
}

$station_id = isset( $_POST['station_id'] ) ? (int) $_POST['station_id'] : 0;
$status     = isset( $_POST['status'] ) ? sanitize_text_field( wp_unslash( $_POST['status'] ) ) : '';

if ( ! $station_id ) {
wp_send_json_error( array( 'message' => 'Mangler station_id.' ), 400 );
}

$station_user = get_user_by( 'id', $station_id );
if ( ! ( $station_user instanceof WP_User ) ) {
wp_send_json_error( array( 'message' => 'Ugyldig stasjon.' ), 404 );
}

$station_roles = (array) $station_user->roles;
if ( ! in_array( 'stasjonseier', $station_roles, true ) ) {
wp_send_json_error( array( 'message' => 'Brukeren er ikke en stasjonseier.' ), 400 );
}

if ( function_exists( 'minlpg_set_station_status' ) ) {
minlpg_set_station_status( $station_id, $status );
} else {
$status = strtolower( trim( (string) $status ) );
$status = ( 'inactive' === $status ) ? 'inactive' : 'active';
update_user_meta( $station_id, 'minlpg_station_status', $status );
}

$new_status = function_exists( 'minlpg_get_station_status' )
? minlpg_get_station_status( $station_id )
: ( ( 'inactive' === strtolower( $status ) ) ? 'inactive' : 'active' );

$label      = ( 'inactive' === $new_status ) ? 'INACTIVE' : 'ACTIVE';
$pill_class = ( 'inactive' === $new_status ) ? 'minlpg-status-off' : 'minlpg-status-ok';

wp_send_json_success(
array(
'station_id'  => $station_id,
'status'      => $new_status,
'label'       => $label,
'pill_class'  => $pill_class,
)
);
}
}
add_action( 'wp_ajax_minlpg_set_station_status', 'minlpg_ajax_set_station_status' );

/**
 * AJAX: trekk kreditt for Bedrift – dispenserfylling
 * action: minlpg_credit_charge
 *
 * Forventet POST:
 *  - nonce  (wp_create_nonce('minlpg_credit_charge'))
 *  - amount (NOK)  f.eks "234.36" eller "234,36"
 *  - tx_id  (valgfri) unik id for fyllingen (idempotens)
 *
 * Oppdaterer:
 *  - user_meta: minlpg_credit_balance
 *  - user_meta: minlpg_credit_charged_tx_ids (array, valgfri)
 */
if ( ! function_exists( 'minlpg_ajax_credit_charge' ) ) {
function minlpg_ajax_credit_charge() {
global $wpdb;

if ( ! is_user_logged_in() ) {
wp_send_json_error( array( 'message' => 'Ikke innlogget.' ), 401 );
}

// Nonce
$nonce = isset( $_POST['nonce'] ) ? sanitize_text_field( wp_unslash( $_POST['nonce'] ) ) : '';
if ( ! wp_verify_nonce( $nonce, 'minlpg_credit_charge' ) ) {
wp_send_json_error( array( 'message' => 'Ugyldig sikkerhetstoken.' ), 403 );
}

$user = wp_get_current_user();
if ( ! ( $user instanceof WP_User ) ) {
wp_send_json_error( array( 'message' => 'Ugyldig bruker.' ), 403 );
}

// Gate: kun Bedrift – dispenserfylling (eller adminroller)
$roles       = (array) $user->roles;
$is_adminish = in_array( 'administrator', $roles, true ) || in_array( 'lpg_admin', $roles, true );
$user_type   = get_user_meta( $user->ID, 'minlpg_user_type', true );

if ( ! $is_adminish && 'bedrift_dispenser' !== $user_type ) {
wp_send_json_error( array( 'message' => 'Du har ikke tilgang.' ), 403 );
}

// Beløp
$amount_raw = isset( $_POST['amount'] ) ? wp_unslash( $_POST['amount'] ) : '';
$amount_s   = preg_replace( '/[^0-9,\.\-]/', '', (string) $amount_raw );
$amount_num = (float) str_replace( ',', '.', $amount_s );

if ( $amount_num <= 0 ) {
wp_send_json_error( array( 'message' => 'Ugyldig beløp.' ), 400 );
}

// Idempotensnøkkel (valgfri)
$tx_id = isset( $_POST['tx_id'] ) ? sanitize_text_field( wp_unslash( $_POST['tx_id'] ) ) : '';
$tx_id = trim( $tx_id );
if ( strlen( $tx_id ) > 120 ) {
$tx_id = substr( $tx_id, 0, 120 );
}

// Lock per user for å unngå race conditions
$lock_name = 'minlpg_credit_lock_' . (int) $user->ID;
$locked    = $wpdb->get_var( $wpdb->prepare( 'SELECT GET_LOCK(%s, 5)', $lock_name ) );
$has_lock  = ( '1' === (string) $locked );

$success   = false;
$http_code = 200;
$payload   = array();

try {

// Use a single breakable block (avoids early exits that can skip lock release)
do {

// Optional idempotency by tx_id
if ( '' !== $tx_id ) {
$charged = get_user_meta( $user->ID, 'minlpg_credit_charged_tx_ids', true );
if ( ! is_array( $charged ) ) {
$charged = array();
}

if ( in_array( $tx_id, $charged, true ) ) {

$limit_raw   = get_user_meta( $user->ID, 'minlpg_credit_limit', true );
$balance_raw = get_user_meta( $user->ID, 'minlpg_credit_balance', true );

$limit_num   = (float) str_replace( ',', '.', (string) $limit_raw );
$balance_num = (float) str_replace( ',', '.', (string) $balance_raw );

$success = true;
$payload = array(
'balance'           => $balance_num,
'balance_formatted' => number_format( $balance_num, 2, ',', ' ' ),
'limit'             => $limit_num,
'limit_formatted'   => number_format( $limit_num, 0, ',', ' ' ),
'already_charged'   => true,
'tx_id'             => $tx_id,
);
break;
}
}

// Status gate (hvis satt) – admin kan overstyre
$status = get_user_meta( $user->ID, 'minlpg_credit_status', true );
if ( '' !== (string) $status && 'approved' !== (string) $status && ! $is_adminish ) {
$success   = false;
$http_code = 403;
$payload   = array( 'message' => 'Kreditt er ikke godkjent.' );
break;
}

$balance_raw = get_user_meta( $user->ID, 'minlpg_credit_balance', true );
$balance_num = ( '' !== (string) $balance_raw )
? (float) str_replace( ',', '.', (string) $balance_raw )
: 0.0;

$new_balance = $balance_num - $amount_num;

// Ikke tillat overtrekk (med mindre admin)
if ( $new_balance < -0.0001 && ! $is_adminish ) {
$success   = false;
$http_code = 400;
$payload   = array( 'message' => 'Ikke nok kreditt tilgjengelig.' );
break;
}

// Clamp -0.00 til 0.00
if ( abs( $new_balance ) < 0.0001 ) {
$new_balance = 0.0;
}

update_user_meta( $user->ID, 'minlpg_credit_balance', $new_balance );

// Lagre tx_id for idempotens
if ( '' !== $tx_id ) {
$charged = get_user_meta( $user->ID, 'minlpg_credit_charged_tx_ids', true );
if ( ! is_array( $charged ) ) {
$charged = array();
}

$charged[] = $tx_id;

$charged = array_values( array_unique( $charged ) );
if ( count( $charged ) > 50 ) {
$charged = array_slice( $charged, -50 );
}

update_user_meta( $user->ID, 'minlpg_credit_charged_tx_ids', $charged );
}

$limit_raw = get_user_meta( $user->ID, 'minlpg_credit_limit', true );
$limit_num = (float) str_replace( ',', '.', (string) $limit_raw );

$success = true;
$payload = array(
'balance'           => $new_balance,
'balance_formatted' => number_format( $new_balance, 2, ',', ' ' ),
'limit'             => $limit_num,
'limit_formatted'   => number_format( $limit_num, 0, ',', ' ' ),
'charged_amount'    => $amount_num,
'tx_id'             => $tx_id,
);

} while ( false );

} finally {
if ( $has_lock ) {
$wpdb->get_var( $wpdb->prepare( 'SELECT RELEASE_LOCK(%s)', $lock_name ) );
}
}

if ( $success ) {
wp_send_json_success( $payload );
}

wp_send_json_error( $payload, $http_code );
}
}
add_action( 'wp_ajax_minlpg_credit_charge', 'minlpg_ajax_credit_charge' );





/**
 * SHARED COMPONENT:
 * Render a single dispenser card (pump) for a given station.
 *
 * context:
 *  - owner           → full kontroll, rapporter + pris + start/stopp + betalingsvalg
 *  - business        → bedriftkunde (NY: armer dispenser + terminalbetaling)
