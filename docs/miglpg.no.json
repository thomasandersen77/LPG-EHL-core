if ( ! function_exists( 'minlpg_mine_kunder_shortcode' ) ) {

function minlpg_mine_kunder_shortcode() {

if ( ! function_exists( 'minlpg_require_role' ) ) {
return '<p>Konfigurasjonsfeil: minlpg_require_role mangler.</p>';
}

// Kun stasjonseier / admin
list( $ok, $user_or_msg ) = minlpg_require_role(
array( 'stasjonseier', 'lpg_admin', 'administrator' )
);
if ( ! $ok ) {
return $user_or_msg;
}

/** @var WP_User $current */
$current     = $user_or_msg;
$station_id  = (int) $current->ID;
$kk_nonce    = wp_create_nonce( 'minlpg_klippekort_add' );
$kk_ajax_url = admin_url( 'admin-ajax.php' );

/*
         * 1) Kreditt-godkjenning (Godkjenn / Avslå)
         */
if (
isset( $_POST['minlpg_credit_action'], $_POST['minlpg_credit_user'], $_POST['minlpg_credit_nonce'] ) &&
wp_verify_nonce( $_POST['minlpg_credit_nonce'], 'minlpg_credit_action' )
) {
$action      = sanitize_text_field( wp_unslash( $_POST['minlpg_credit_action'] ) ); // approve | reject
$customer_id = (int) $_POST['minlpg_credit_user'];

// Sikkerhet: kunden må tilhøre denne stasjonen
$owner_id = (int) get_user_meta( $customer_id, 'minlpg_station_owner', true );
if ( $owner_id === $station_id ) {
$status = ( 'approve' === $action ) ? 'approved' : 'rejected';

update_user_meta( $customer_id, 'minlpg_credit_status', $status );
update_user_meta( $customer_id, 'minlpg_credit_approved_by', $current->ID );
}
}

/*
         * 2) Lagre kundedetaljer fra modal
         */
if (
isset( $_POST['minlpg_customer_save'], $_POST['minlpg_customer_nonce'] ) &&
wp_verify_nonce( $_POST['minlpg_customer_nonce'], 'minlpg_customer_save' )
) {
$customer_id = (int) $_POST['minlpg_customer_save'];
$owner_id    = (int) get_user_meta( $customer_id, 'minlpg_station_owner', true );

if ( $owner_id === $station_id ) {

// Oppdater kjernefelter (e‑post + navn)
$update = array( 'ID' => $customer_id );

if ( ! empty( $_POST['minlpg_email'] ) && is_email( $_POST['minlpg_email'] ) ) {
$update['user_email'] = sanitize_email( wp_unslash( $_POST['minlpg_email'] ) );
}

if ( isset( $_POST['minlpg_first_name'] ) ) {
update_user_meta(
$customer_id,
'first_name',
sanitize_text_field( wp_unslash( $_POST['minlpg_first_name'] ) )
);
}
if ( isset( $_POST['minlpg_last_name'] ) ) {
update_user_meta(
$customer_id,
'last_name',
sanitize_text_field( wp_unslash( $_POST['minlpg_last_name'] ) )
);
}

if ( count( $update ) > 1 ) {
wp_update_user( $update );
}

// Oppdater custom meta
$meta_keys = array(
'minlpg_legal_name',
'minlpg_org_number',
'minlpg_address',
'minlpg_phone',
'minlpg_credit_limit',
'minlpg_credit_balance', // saldo som kan telle ned via API
);

foreach ( $meta_keys as $key ) {
if ( isset( $_POST[ $key ] ) ) {
update_user_meta(
$customer_id,
$key,
sanitize_text_field( wp_unslash( $_POST[ $key ] ) )
);
}
}
}
