/**
 * Multi-step registrering med 4 brukertyper + tilknytning til stasjonseier Shortcode: [minlpg_register]
 */
/**
 * Shortcode: [minlpg_register]
 * Multi-step registration with 4 user types + station owner relation.
 */
function minlpg_register_shortcode() {
if ( is_user_logged_in() ) {
// Already logged in – send to dashboard
$user = wp_get_current_user();
if ( function_exists( 'minlpg_get_dashboard_url_for_user' ) ) {
$target = minlpg_get_dashboard_url_for_user( $user );
} else {
$target = home_url( '/' );
}
return '<p>Du er allerede innlogget. <a href="' . esc_url( $target ) . '">Gå til MinLPG</a>.</p>';
}

$errors   = new WP_Error();
$success  = false;
$user_id  = 0;

// Handle submit
if ( 'POST' === $_SERVER['REQUEST_METHOD'] && isset( $_POST['minlpg_register_nonce'] ) ) {
if ( ! wp_verify_nonce( $_POST['minlpg_register_nonce'], 'minlpg_register' ) ) {
$errors->add( 'nonce', 'Ugyldig forespørsel, prøv igjen.' );
} else {

$user_type   = isset( $_POST['minlpg_user_type'] ) ? sanitize_text_field( $_POST['minlpg_user_type'] ) : '';
$email       = isset( $_POST['minlpg_email'] ) ? sanitize_email( $_POST['minlpg_email'] ) : '';
$full_name   = isset( $_POST['minlpg_full_name'] ) ? sanitize_text_field( $_POST['minlpg_full_name'] ) : '';
$phone       = isset( $_POST['minlpg_phone'] ) ? sanitize_text_field( $_POST['minlpg_phone'] ) : '';
$pass        = isset( $_POST['minlpg_pass'] ) ? $_POST['minlpg_pass'] : '';
$pass2       = isset( $_POST['minlpg_pass2'] ) ? $_POST['minlpg_pass2'] : '';
$station_id  = isset( $_POST['minlpg_station_owner'] ) ? intval( $_POST['minlpg_station_owner'] ) : 0;

// Company fields
$company     = isset( $_POST['minlpg_company'] ) ? sanitize_text_field( $_POST['minlpg_company'] ) : '';
$orgnr       = isset( $_POST['minlpg_orgnr'] ) ? sanitize_text_field( $_POST['minlpg_orgnr'] ) : '';

// Address
$addr        = isset( $_POST['minlpg_addr'] ) ? sanitize_text_field( $_POST['minlpg_addr'] ) : '';
$postnr      = isset( $_POST['minlpg_postnr'] ) ? sanitize_text_field( $_POST['minlpg_postnr'] ) : '';
$poststed    = isset( $_POST['minlpg_poststed'] ) ? sanitize_text_field( $_POST['minlpg_poststed'] ) : '';

// Contact person
$contact_name  = isset( $_POST['minlpg_contact_name'] ) ? sanitize_text_field( $_POST['minlpg_contact_name'] ) : '';
$contact_phone = isset( $_POST['minlpg_contact_phone'] ) ? sanitize_text_field( $_POST['minlpg_contact_phone'] ) : '';

// Credit
$credit_apply  = ! empty( $_POST['minlpg_credit_apply'] ) ? 1 : 0;
$credit_limit  = isset( $_POST['minlpg_credit_limit'] ) ? sanitize_text_field( $_POST['minlpg_credit_limit'] ) : '';

// Basic validation
if ( empty( $user_type ) ) {
$errors->add( 'user_type', 'Du må velge brukertype.' );
}
if ( empty( $email ) || ! is_email( $email ) ) {
$errors->add( 'email', 'Du må oppgi en gyldig e-postadresse.' );
} elseif ( email_exists( $email ) ) {
$errors->add( 'email_exists', 'E-postadressen er allerede i bruk.' );
}
if ( empty( $full_name ) ) {
$errors->add( 'full_name', 'Du må oppgi fullt navn.' );
}
if ( empty( $phone ) ) {
$errors->add( 'phone', 'Du må oppgi mobilnummer / telefon.' );
}
if ( empty( $pass ) || empty( $pass2 ) ) {
$errors->add( 'pass', 'Du må oppgi og gjenta passord.' );
} elseif ( $pass !== $pass2 ) {
$errors->add( 'pass_mismatch', 'Passordene er ikke like.' );
}

// Station owner required
if ( ! $station_id ) {
$errors->add( 'station', 'Du må velge stasjon / stasjonseier.' );
}

// Extra rules per type
switch ( $user_type ) {
case 'priv_levering':
if ( empty( $addr ) || empty( $postnr ) || empty( $poststed ) ) {
$errors->add( 'address', 'Adresse, postnummer og poststed er obligatorisk for levering.' );
}
break;

case 'bedrift_levering':
if ( empty( $company ) || empty( $orgnr ) || empty( $addr ) ) {
$errors->add( 'company', 'Firmanavn, organisasjonsnummer og leveringsadresse er påkrevd.' );
}
if ( empty( $contact_name ) || empty( $contact_phone ) ) {
$errors->add( 'contact', 'Navn og telefon til kontaktperson er påkrevd.' );
}
break;

case 'bedrift_dispenser':
if ( empty( $company ) || empty( $orgnr ) || empty( $addr ) ) {
$errors->add( 'company', 'Firmanavn, organisasjonsnummer og leveringsadresse er påkrevd.' );
}
if ( empty( $contact_name ) || empty( $contact_phone ) ) {
$errors->add( 'contact', 'Navn og telefon til kontaktperson er påkrevd.' );
}
if ( $credit_apply && empty( $credit_limit ) ) {
$errors->add( 'credit', 'Du må oppgi ønsket kredittgrense.' );
}
break;
}

if ( ! $errors->has_errors() ) {
// Create user
$username = sanitize_user( current( explode( '@', $email ) ), true );
if ( username_exists( $username ) ) {
$username .= '_' . wp_generate_password( 4, false );
}

$userdata = array(
'user_login'   => $username,
'user_email'   => $email,
'user_pass'    => $pass,
'display_name' => $full_name,
'role'         => 'lpg_kunde',
);

$user_id = wp_insert_user( $userdata );

if ( is_wp_error( $user_id ) ) {
$errors->add( 'insert', 'Klarte ikke å opprette bruker: ' . $user_id->get_error_message() );
} else {
// Meta
update_user_meta( $user_id, 'minlpg_user_type', $user_type );
update_user_meta( $user_id, 'minlpg_full_name', $full_name );
update_user_meta( $user_id, 'minlpg_phone', $phone );
update_user_meta( $user_id, 'minlpg_station_owner', $station_id );

update_user_meta( $user_id, 'minlpg_addr', $addr );
update_user_meta( $user_id, 'minlpg_postnr', $postnr );
update_user_meta( $user_id, 'minlpg_poststed', $poststed );

update_user_meta( $user_id, 'minlpg_company', $company );
update_user_meta( $user_id, 'minlpg_orgnr', $orgnr );
update_user_meta( $user_id, 'minlpg_contact_name', $contact_name );
update_user_meta( $user_id, 'minlpg_contact_phone', $contact_phone );
update_user_meta( $user_id, 'minlpg_credit_apply', $credit_apply );
update_user_meta( $user_id, 'minlpg_credit_limit', $credit_limit );

$success = true;
}
}
}
}

ob_start();

if ( $success && $user_id ) : ?>
<!-- STEP 3 – Done -->
<div class="minlpg-register minlpg-register--done">
<div class="minlpg-step-header">
<div class="minlpg-step-pill">Steg 3 av 3</div>
<h2>Kontoen er opprettet!</h2>
</div>
