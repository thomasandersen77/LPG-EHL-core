var m = (btn.getAttribute('data-minlpg-pay-method') || '').toString().toLowerCase();
var isActive = (m === method);

minlpgSetClass(btn, 'minlpg-button-accent', isActive);

minlpgSetClass(btn, 'is-active', isActive);

btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
});
}

// Init from dataset (HTML default) or fallback
setActive(card.dataset.minlpgPaymentMethod || 'terminal');

// Click handlers
minlpgEach(payButtons, function (btn) {
if (!btn) return;
btn.addEventListener('click', function () {
setActive(btn.getAttribute('data-minlpg-pay-method') || 'terminal');
});
});

// When arming starts, lock in chosen method for the upcoming fueling window
var armBtn = card.querySelector('[data-minlpg-arm-dispenser]');
if (armBtn && !armBtn._minlpgPayLock) {
armBtn._minlpgPayLock = true;
armBtn.addEventListener('click', function () {
card.dataset.minlpgArmedPaymentMethod = card.dataset.minlpgPaymentMethod || 'terminal';
});
}
});
}

function initCreditChargeAndLiveUpdate() {

function toNumber(raw) {
if (raw === null || raw === undefined) return 0;
var str = String(raw).trim();
if (!str) return 0;

// Fjern "kr" og spaces
str = str.replace(/kr/gi, '').replace(/\s+/g, '');

// Hvis både "." og "," finnes: anta "." er tusenskille → fjern "." og bruk "," som desimal
if (str.indexOf(',') !== -1 && str.indexOf('.') !== -1) {
str = str.replace(/\./g, '').replace(',', '.');
} else {
str = str.replace(',', '.');
}

var num = parseFloat(str);
return isNaN(num) ? 0 : num;
}

function getBusinessWrap(card) {
return minlpgClosest(card, '.minlpg-dashboard-business');
}

function updateCreditUI(card, data) {
var wrap = getBusinessWrap(card) || document.querySelector('.minlpg-dashboard-business');
if (!wrap) return;

var bal = wrap.querySelector('[data-minlpg-credit-balance]');
var lim = wrap.querySelector('[data-minlpg-credit-limit]');

if (bal && data && data.balance_formatted !== undefined) {
bal.textContent = String(data.balance_formatted);
}
if (lim && data && data.limit_formatted !== undefined) {
lim.textContent = String(data.limit_formatted);
}
}

// In-memory dedupe (in addition to server-side idempotency)
var chargedTx = Object.create ? Object.create(null) : {};

function ajaxCharge(card, amount, txId, done, fail) {
done = done || function () {};
fail = fail || function () {};

var wrap = getBusinessWrap(card);
if (!wrap) {
fail(new Error('Kreditt-UI er ikke tilgjengelig på denne siden.'));
return;
}

var ajaxUrl = wrap.getAttribute('data-minlpg-credit-ajax') || '';
var nonce   = wrap.getAttribute('data-minlpg-credit-nonce') || '';
if (!ajaxUrl || !nonce) {
fail(new Error('Kreditt-AJAX er ikke konfigurert.'));
return;
}

var fd = new FormData();
fd.append('action', 'minlpg_credit_charge');
fd.append('nonce', nonce);
fd.append('amount', String(amount));

if (txId) {
fd.append('tx_id', String(txId));
}

// Optional context
if (card) {
fd.append('station_id', card.getAttribute('data-station-id') || '');
fd.append('dispenser_id', card.getAttribute('data-dispenser-id') || '');
}

minlpgPostJSON(ajaxUrl, fd, function (json) {
if (!json || !json.success || !json.data) {
var msg = (json && json.data && json.data.message) ? json.data.message : 'Kunne ikke trekke kreditt.';
fail(new Error(msg));
return;
}
done(json.data);
}, fail);
}

function handleFuelingSettled(detail) {
detail = detail || {};

var stationId   = detail.stationId || detail.station_id || '';
var dispenserId = detail.dispenserId || detail.dispenser_id || '';
var txId        = detail.txId || detail.tx_id || '';

var card = null;

if (stationId && dispenserId) {
card = document.querySelector('.minlpg-pump-card[data-station-id="' + stationId + '"][data-dispenser-id="' + dispenserId + '"]');
}
if (!card) {
// Fallback: typisk bare ett kort på kundesider
card = document.querySelector('.minlpg-dashboard-business .minlpg-pump-card') || null;
}
if (!card) return;

var payment = (detail.paymentMethod || detail.payment_method || '').toString().toLowerCase();
if (!payment) {
// Bruk metode som var valgt da dispenser ble armert
payment = (card.dataset.minlpgArmedPaymentMethod || card.dataset.minlpgPaymentMethod || 'terminal').toString().toLowerCase();
}

if (payment !== 'credit') {
return;
}

var amount = detail.amount;
if (amount === undefined || amount === null || amount === '') {
// Fallback: les fra UI hvis integrasjonen ikke sender beløp direkte
var el = card.querySelector('.minlpg-metric-display-amount');
amount = el ? el.textContent : 0;
}

var numAmount = toNumber(amount);
if (numAmount <= 0) {
if (window.console && console.warn) {
console.warn('MinLPG: ignorerer kreditt-trekk – beløp er ugyldig:', amount);
}
return;
}

if (txId) {
if (chargedTx[txId]) {
return;
}
chargedTx[txId] = true;
}

ajaxCharge(card, numAmount, txId, function (data) {
updateCreditUI(card, data);
}, function (err) {
if (window.console && console.error) console.error(err);
alert('Kreditt kunne ikke trekkes: ' + (err && err.message ? err.message : 'Ukjent feil'));
});
}

// Kun ett eksplisitt event når tanking er avregnet (unngår trekk under live oppdateringer)
document.addEventListener('minlpg:fueling:settled', function (evt) {
handleFuelingSettled(evt && evt.detail ? evt.detail : {});
});

// Expose helper for integrasjoner: window.MinLPG.fuelingSettled({...})
window.MinLPG = window.MinLPG || {};
window.MinLPG.fuelingSettled = function (detail) {
try {
var ev;
if (typeof CustomEvent === 'function') {
ev = new CustomEvent('minlpg:fueling:settled', { detail: detail });
} else {
ev = document.createEvent('CustomEvent');
ev.initCustomEvent('minlpg:fueling:settled', true, true, detail);
}
document.dispatchEvent(ev);
} catch (e) {
// no-op
}
};
}

function initReportsBlocks() {
minlpgEach(document.querySelectorAll('[data-minlpg-reports]'), function (block) {
if (!block || block._minlpgReportsInit) return;
block._minlpgReportsInit = true;

var toggle        = block.querySelector('.minlpg-button-reports-toggle');
var inner         = block.querySelector('.minlpg-reports-inner');
var reportButtons = block.querySelectorAll('[data-minlpg-report-toggle]');
var sections      = block.querySelectorAll('[data-minlpg-report-section]');
var fetchButtons  = block.querySelectorAll('[data-minlpg-report-fetch]');
var resultCards   = block.querySelectorAll('[data-minlpg-report-results]');

if (!toggle || !inner) return;

if (inner.classList) {
inner.classList.add('is-open');
}

toggle.addEventListener('click', function () {
if (inner.classList) {
inner.classList.toggle('is-open');
}
});

// Hovedknapper for Omsetning / Veibruk / Uttak
minlpgEach(reportButtons, function (btn) {
if (!btn) return;
btn.addEventListener('click', function () {
var type     = btn.getAttribute('data-minlpg-report-toggle') || '';
var isActive = btn.classList && btn.classList.contains('is-active');

if (isActive) {
// slå av denne: skjul seksjon + fjern orange
if (btn.classList) {
btn.classList.remove('is-active');
btn.classList.remove('minlpg-button-accent');
}
minlpgEach(sections, function (section) {
if (section && section.getAttribute('data-minlpg-report-section') === type) {
section.style.display = 'none';
}
});
minlpgEach(resultCards, function (card) {
if (card && card.getAttribute('data-minlpg-report-results') === type) {
card.style.display = 'none';
}
});
return;
}

// Sett denne aktiv, andre normal
minlpgEach(reportButtons, function (b) {
if (b && b.classList) {
b.classList.remove('is-active');
b.classList.remove('minlpg-button-accent');
}
});
if (btn.classList) {
btn.classList.add('is-active');
btn.classList.add('minlpg-button-accent');
}

// Vis riktig seksjon, skjul andre
minlpgEach(sections, function (section) {
if (!section) return;
var sType = section.getAttribute('data-minlpg-report-section') || '';
section.style.display = (sType === type) ? 'block' : 'none';
});

// Når man skifter type skjuler vi alle resultater, de må hente på nytt
minlpgEach(resultCards, function (card) {
if (card) card.style.display = 'none';
});
});
});

// "Hent rapporter" → vis resultatlisten for valgt type (demo-front)
minlpgEach(fetchButtons, function (btn) {
if (!btn) return;
btn.addEventListener('click', function () {
var type = btn.getAttribute('data-minlpg-report-fetch') || '';

minlpgEach(resultCards, function (card) {
if (!card) return;
var cType = card.getAttribute('data-minlpg-report-results') || '';
if (cType === type) {
card.style.display = 'block';
}
});
});
});
});
}

function initReceiptsBlocks() {
minlpgEach(document.querySelectorAll('.minlpg-pump-main'), function (main) {
if (!main || main._minlpgReceiptsInit) return;
main._minlpgReceiptsInit = true;

var toggle = main.querySelector('.minlpg-button-receipts-toggle');
var block  = main.querySelector('[data-minlpg-receipts]');
if (!toggle || !block) return;

function minlpgIsHidden(el) {
if (!el) return true;
if (window.getComputedStyle) {
return window.getComputedStyle(el).display === 'none';
}
return el.style.display === 'none';
}

toggle.addEventListener('click', function () {
var isHidden = minlpgIsHidden(block);
block.style.display = isHidden ? 'block' : 'none';
});

var fetchBtn = block.querySelector('[data-minlpg-receipts-fetch]');
var results  = block.querySelector('[data-minlpg-receipts-results]');

if (fetchBtn && results) {
fetchBtn.addEventListener('click', function () {
results.style.display = 'block';
});
}
});
}

function initPriceModal() {
var priceModal = document.getElementById('minlpg-price-modal');
if (!priceModal) return;

var openButtons  = document.querySelectorAll('[data-minlpg-open-price-modal]');
var closeButtons = priceModal.querySelectorAll('[data-minlpg-close-price-modal]');
var saveButton   = priceModal.querySelector('[data-minlpg-save-price]');
var ownerDash    = document.querySelector('.minlpg-dashboard-owner');

var ajaxUrl   = ownerDash ? ownerDash.getAttribute('data-minlpg-price-ajax') : null;
var ajaxNonce = ownerDash ? ownerDash.getAttribute('data-minlpg-price-nonce') : null;

function getCurrentCard() {
// I dag har vi én dispenser, så vi tar den første
return document.querySelector('.minlpg-pump-card');
}

function openModal() {
var card = getCurrentCard();
if (card) {
var medInput  = priceModal.querySelector('#minlpg_price_med');
var utenInput = priceModal.querySelector('#minlpg_price_uten');
if (medInput) {
medInput.value = card.dataset.priceMed || card.getAttribute('data-price-med') || medInput.value;
}
if (utenInput) {
utenInput.value = card.dataset.priceUten || card.getAttribute('data-price-uten') || utenInput.value;
}
}

if (priceModal.classList) {
priceModal.classList.add('is-open');
}
priceModal.setAttribute('aria-hidden', 'false');
}

function closeModal() {
if (priceModal.classList) {
priceModal.classList.remove('is-open');
}
priceModal.setAttribute('aria-hidden', 'true');
}

minlpgEach(openButtons, function (btn) {
if (!btn) return;
btn.addEventListener('click', openModal);
});
minlpgEach(closeButtons, function (btn) {
if (!btn) return;
btn.addEventListener('click', closeModal);
});

if (!saveButton) return;

saveButton.addEventListener('click', function () {
var medInput  = priceModal.querySelector('#minlpg_price_med');
var utenInput = priceModal.querySelector('#minlpg_price_uten');

var medVal  = medInput  ? medInput.value  : '';
var utenVal = utenInput ? utenInput.value : '';

var card        = getCurrentCard();
var stationId   = card ? card.getAttribute('data-station-id')   : '';
var dispenserId = card ? card.getAttribute('data-dispenser-id') : '';

function applyNewPrices(newMed, newUten) {
minlpgEach(document.querySelectorAll('.minlpg-pump-card'), function (c) {
if (!c) return;
if (String(c.getAttribute('data-station-id')) === String(stationId) &&
String(c.getAttribute('data-dispenser-id')) === String(dispenserId)) {
if (newMed)  c.dataset.priceMed  = newMed;
if (newUten) c.dataset.priceUten = newUten;
if (typeof c._minlpgUpdateUI === 'function') {
c._minlpgUpdateUI();
}
}
});
}

// Hvis vi har AJAX-config → lagre til server
if (ajaxUrl && ajaxNonce && stationId && dispenserId) {
var formData = new FormData();
formData.append('action', 'minlpg_save_price');
formData.append('nonce', ajaxNonce);
formData.append('station_id', stationId);
formData.append('dispenser_id', dispenserId);
formData.append('price_med', medVal);
formData.append('price_uten', utenVal);

minlpgPostJSON(ajaxUrl, formData, function (data) {
if (!data || !data.success || !data.data) {
alert(data && data.data ? data.data : 'Kunne ikke lagre prisen.');
return;
}

var newMed  = data.data.price_med;
var newUten = data.data.price_uten;

applyNewPrices(newMed, newUten);
closeModal();
}, function () {
alert('Teknisk feil ved lagring av pris.');
});

return;
}

// Fallback: kun lokal UI-oppdatering (demo)
applyNewPrices(medVal, utenVal);
closeModal();
});
}

function initAdminScrollButtons() {
minlpgEach(document.querySelectorAll('[data-minlpg-scroll]'), function (btn) {
if (!btn) return;
var targetSel = btn.getAttribute('data-minlpg-scroll');
if (!targetSel) return;

btn.addEventListener('click', function () {
var target = document.querySelector(targetSel);
if (target && target.scrollIntoView) {
target.scrollIntoView({ behavior: 'smooth', block: 'start' });
}
});
});
}

function initAdminSearch() {
minlpgEach(document.querySelectorAll('[data-minlpg-admin-search]'), function (input) {
if (!input) return;
var key = input.getAttribute('data-minlpg-admin-search');
if (!key) return;

var table = document.querySelector('[data-minlpg-admin-table="' + key + '"]');
if (!table) return;

var rows = table.querySelectorAll('tbody tr[data-row]');

input.addEventListener('input', function () {
var q = (input.value || '').toLowerCase();
minlpgEach(rows, function (row) {
if (!row) return;
var text = (row.textContent || '').toLowerCase();
row.style.display = (!q || text.indexOf(q) !== -1) ? '' : 'none';
});
});
});
}

