<script>
document.addEventListener('DOMContentLoaded', function () {

// Format helper: 20.9 -> "20,90"
function minlpgFormatNOK(value) {
var num = parseFloat(String(value).replace(',', '.'));
if (isNaN(num)) {
num = 0;
}
return num.toFixed(2).replace('.', ',');
}

// Init each pump card (pris-modus + hoveddisplay)
document.querySelectorAll('.minlpg-pump-card').forEach(function (card) {
var radios       = card.querySelectorAll('input[type="radio"][data-minlpg-avgift="1"]');
var boxes        = card.querySelectorAll('.minlpg-price-box-toggle');
var priceDisplay = card.querySelector('.minlpg-metric-display-price');

function getMode() {
var checked = card.querySelector('input[type="radio"][data-minlpg-avgift="1"]:checked');
return checked ? checked.value : 'med';
}

function getPriceForMode(mode) {
if (mode === 'uten') {
return card.dataset.priceUten || '0';
}
return card.dataset.priceMed || '0';
}

function updateUI() {
var mode = getMode();

// Toggle blå/oransje kort
boxes.forEach(function (box) {
box.classList.toggle('is-active', box.dataset.price === mode);
});

// Oppdater store "Pris, KR/L"-kortet
if (priceDisplay) {
var raw = getPriceForMode(mode);
priceDisplay.textContent = minlpgFormatNOK(raw);
}
}

radios.forEach(function (radio) {
radio.addEventListener('change', updateUI);
});

// eksponer så modal-save kan trigge oppdatering
card._minlpgUpdateUI = updateUI;

// init
updateUI();
});

// Rapporter: toggle visning når man trykker "Rapporter" + per-type seksjoner
document.querySelectorAll('[data-minlpg-reports]').forEach(function (block) {
var toggle        = block.querySelector('.minlpg-button-reports-toggle');
var inner         = block.querySelector('.minlpg-reports-inner');
var reportButtons = block.querySelectorAll('[data-minlpg-report-toggle]');
var sections      = block.querySelectorAll('[data-minlpg-report-section]');
var fetchButtons  = block.querySelectorAll('[data-minlpg-report-fetch]');
var resultCards   = block.querySelectorAll('[data-minlpg-report-results]');

if (!toggle || !inner) return;

inner.classList.add('is-open');

toggle.addEventListener('click', function () {
inner.classList.toggle('is-open');
});

// Hovedknapper for Omsetning / Veibruk / Uttak
reportButtons.forEach(function (btn) {
btn.addEventListener('click', function () {
var type     = btn.getAttribute('data-minlpg-report-toggle') || '';
var isActive = btn.classList.contains('is-active');

if (isActive) {
// slå av denne: skjul seksjon + fjern orange
btn.classList.remove('is-active', 'minlpg-button-accent');
sections.forEach(function (section) {
if (section.getAttribute('data-minlpg-report-section') === type) {
section.style.display = 'none';
}
});
resultCards.forEach(function (card) {
if (card.getAttribute('data-minlpg-report-results') === type) {
card.style.display = 'none';
}
});
return;
}

// Sett denne aktiv, andre normal
reportButtons.forEach(function (b) {
b.classList.remove('is-active', 'minlpg-button-accent');
});
btn.classList.add('is-active', 'minlpg-button-accent');

// Vis riktig seksjon, skjul andre
sections.forEach(function (section) {
var sType = section.getAttribute('data-minlpg-report-section') || '';
section.style.display = (sType === type) ? 'block' : 'none';
});

// Når man skifter type skjuler vi alle resultater, de må hente på nytt
resultCards.forEach(function (card) {
card.style.display = 'none';
});
});
});

// "Hent rapporter" → vis resultatlisten for valgt type (demo-front)
fetchButtons.forEach(function (btn) {
btn.addEventListener('click', function () {
var type = btn.getAttribute('data-minlpg-report-fetch') || '';

resultCards.forEach(function (card) {
var cType = card.getAttribute('data-minlpg-report-results') || '';
if (cType === type) {
card.style.display = 'block';
}
});
});
});
});

// KVITTERINGER: åpne/close blokk + hent-knapp viser liste
document.querySelectorAll('.minlpg-pump-main').forEach(function (main) {
var toggle = main.querySelector('.minlpg-button-receipts-toggle');
var block  = main.querySelector('[data-minlpg-receipts]');
if (!toggle || !block) return;

toggle.addEventListener('click', function () {
var isHidden = (block.style.display === 'none');
block.style.display = isHidden ? 'block' : 'none';
});

var fetchBtn = block.querySelector('[data-minlpg-receipts-fetch]');
var results  = block.querySelector('[data-minlpg-receipts-results]');

if (fetchBtn && results) {
fetchBtn.addEventListener('click', function () {
results.style.display = 'block';
});
}
});

// Endre pris – modal (kun relevant på stasjonseier-siden)
var priceModal = document.getElementById('minlpg-price-modal');
if (priceModal) {
var openButtons  = document.querySelectorAll('[data-minlpg-open-price-modal]');
var closeButtons = priceModal.querySelectorAll('[data-minlpg-close-price-modal]');
var saveButton   = priceModal.querySelector('[data-minlpg-save-price]');
var ownerDash    = document.querySelector('.minlpg-dashboard-owner');

var ajaxUrl  = ownerDash ? ownerDash.getAttribute('data-minlpg-price-ajax') : null;
var ajaxNonce = ownerDash ? ownerDash.getAttribute('data-minlpg-price-nonce') : null;

function getCurrentCard() {
// I dag har vi én dispenser, så vi tar den første
return document.querySelector('.minlpg-pump-card');
}

function openModal() {
var card = getCurrentCard();
if (card) {
var medInput  = priceModal.querySelector('#minlpg_price_med');
var utenInput = priceModal.querySelector('#minlpg_price_uten');
if (medInput) {
medInput.value = card.dataset.priceMed || medInput.value;
}
if (utenInput) {
utenInput.value = card.dataset.priceUten || utenInput.value;
}
}

priceModal.classList.add('is-open');
priceModal.setAttribute('aria-hidden', 'false');
}

function closeModal() {
priceModal.classList.remove('is-open');
priceModal.setAttribute('aria-hidden', 'true');
}

openButtons.forEach(function (btn) {
btn.addEventListener('click', openModal);
});
closeButtons.forEach(function (btn) {
btn.addEventListener('click', closeModal);
});

if (saveButton) {
saveButton.addEventListener('click', function () {
var medInput  = priceModal.querySelector('#minlpg_price_med');
var utenInput = priceModal.querySelector('#minlpg_price_uten');

var medVal  = medInput  ? medInput.value  : '';
var utenVal = utenInput ? utenInput.value : '';

var card        = getCurrentCard();
var stationId   = card ? card.getAttribute('data-station-id')   : '';
var dispenserId = card ? card.getAttribute('data-dispenser-id') : '';

// Hvis vi har AJAX-config → lagre til server
if (ajaxUrl && ajaxNonce && stationId && dispenserId) {
var formData = new FormData();
formData.append('action', 'minlpg_save_price');
formData.append('nonce', ajaxNonce);
formData.append('station_id', stationId);
formData.append('dispenser_id', dispenserId);
formData.append('price_med', medVal);
formData.append('price_uten', utenVal);

fetch(ajaxUrl, {
method: 'POST',
body: formData,
credentials: 'same-origin'
})
.then(function (response) { return response.json(); })
.then(function (data) {
if (!data || !data.success || !data.data) {
alert(data && data.data ? data.data : 'Kunne ikke lagre prisen.');
return;
}

var newMed  = data.data.price_med;
var newUten = data.data.price_uten;

// Oppdater alle kort for samme dispenser (i praksis bare én)
document.querySelectorAll('.minlpg-pump-card').forEach(function (c) {
if (String(c.getAttribute('data-station-id')) === String(stationId) &&
String(c.getAttribute('data-dispenser-id')) === String(dispenserId)) {
c.dataset.priceMed  = newMed;
c.dataset.priceUten = newUten;
if (typeof c._minlpgUpdateUI === 'function') {
c._minlpgUpdateUI();
}
}
});

closeModal();
})
.catch(function () {
alert('Teknisk feil ved lagring av pris.');
});

return;
}

// Fallback: kun lokal UI-oppdatering (demo)
document.querySelectorAll('.minlpg-pump-card').forEach(function (card) {
if (medVal) {
card.dataset.priceMed = medVal;
}
if (utenVal) {
card.dataset.priceUten = utenVal;
}

if (typeof card._minlpgUpdateUI === 'function') {
card._minlpgUpdateUI();
}
});

closeModal();
});
}
}

// ADMIN: kort-knapper som scroller ned til seksjoner
document.querySelectorAll('[data-minlpg-scroll]').forEach(function (btn) {
var targetSel = btn.getAttribute('data-minlpg-scroll');
if (!targetSel) return;

btn.addEventListener('click', function () {
var target = document.querySelector(targetSel);
if (target) {
