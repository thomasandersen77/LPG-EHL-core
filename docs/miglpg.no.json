/**
 * Min LPG – KLIPPEKORT  v1.2
 */
/**
 * Min LPG – KLIPPEKORT CORE (patched 2025-12-16)
 *
 * Lagring:
 *  - Per stasjon: user_meta på stasjonseier (user_id = station_id)
 *      minlpg_klippekort_default  (int)  standard størrelse (antall klipp før gratis)
 *
 *  - Per kunde: user_meta på kunden
 *      minlpg_klippekort_cards (array)
 *      [
 *        station_id => [
 *          'card_no'        => 'K0001000023'  (unik, padding: 4+6)
 *          'legacy_card_no' => 'K123'         (valgfritt, for migrering)
 *          'size'           => 8,
 *          'used'           => 3,             (antall klipp siden sist gratis)
 *        ],
 *      ]
 *
 * Viktige sikkerhetsendringer:
 *  - card_no er ikke lenger "K{station}{user}" (kollisjoner!). Nå: K + 4 siffer stasjon + 6 siffer bruker.
 *  - stasjonseier kan kun registrere klipp/gratis på egne kunder.
 */

if ( ! function_exists( 'minlpg_klippekort_make_card_no' ) ) {
function minlpg_klippekort_make_card_no( $station_id, $user_id ) {
$station_id = (int) $station_id;
$user_id    = (int) $user_id;

// 4 siffer stasjon + 6 siffer bruker (overskytende siffer beholdes, ingen truncation)
return 'K' . sprintf( '%04d', $station_id ) . sprintf( '%06d', $user_id );
}
}


if ( ! function_exists( 'minlpg_klippekort_pretty_card_no' ) ) {
/**
     * Kortere, menneskevennlig visning av kortnummer i UI.
     *
     * Eksempel:
     *  - Lagret (kanonisk): K0093000005
     *  - Vist:             K93-5
     *
     * Viktig: Dette endrer IKKE lagret card_no (ingen migrering). Kun display.
     */
function minlpg_klippekort_pretty_card_no( $card_no ) {
$card_no = strtoupper( trim( (string) $card_no ) );

// Matcher nytt kanonisk format: K + 4 siffer stasjon + 6 siffer bruker
if ( preg_match( '/^K(\d{4})(\d{6})$/', $card_no, $m ) ) {
$station = (int) $m[1]; // drop leading zeros
$user    = (int) $m[2]; // drop leading zeros
return 'K' . $station . '-' . $user;
}

return $card_no;
}
}

/**
 * Batch-migrering av card_no fra gammelt format.
 * Kjører i admin-kontekst i små biter for å unngå trege requests.
 */
if ( ! function_exists( 'minlpg_klippekort_maybe_migrate_cardnos' ) ) {
function minlpg_klippekort_maybe_migrate_cardnos() {

if ( ! is_admin() ) {
return;
}

if ( ! is_user_logged_in() ) {
return;
}

// Kun admin-ish / de med klippekort-cap (rolle fallback hvis cap-cachen ikke er oppdatert enda)
$cu = wp_get_current_user();
$roles = $cu instanceof WP_User ? (array) $cu->roles : array();
$is_station = in_array( 'stasjonseier', $roles, true );
if ( ! current_user_can( 'minlpg_manage_klippekort' ) && ! current_user_can( 'manage_options' ) && ! $is_station ) {
return;
}

if ( get_option( 'minlpg_kk_cardno_migration_done' ) ) {
return;
}

$batch  = 200;
$offset = (int) get_option( 'minlpg_kk_cardno_migration_offset', 0 );

$user_ids = get_users(
array(
'fields'    => 'ID',
'number'    => $batch,
'offset'    => $offset,
'meta_key'  => 'minlpg_klippekort_cards',
'orderby'   => 'ID',
'order'     => 'ASC',
)
);

if ( empty( $user_ids ) ) {
update_option( 'minlpg_kk_cardno_migration_done', 1, false );
delete_option( 'minlpg_kk_cardno_migration_offset' );
return;
}

foreach ( $user_ids as $user_id ) {
$all = get_user_meta( $user_id, 'minlpg_klippekort_cards', true );
if ( ! is_array( $all ) ) {
continue;
}

$changed = false;

foreach ( $all as $station_id => $card ) {
if ( ! is_array( $card ) ) {
continue;
}

$station_id_int = (int) $station_id;

$old_expected = 'K' . $station_id_int . (int) $user_id;
$new_no       = minlpg_klippekort_make_card_no( $station_id_int, $user_id );

$current_no = isset( $card['card_no'] ) ? (string) $card['card_no'] : '';

if ( '' === $current_no || $current_no === $old_expected ) {
// behold gammel som legacy hvis den finnes
if ( '' !== $current_no && empty( $card['legacy_card_no'] ) ) {
$card['legacy_card_no'] = $current_no;
}
$card['card_no'] = $new_no;
$all[ $station_id_int ] = $card;
$changed = true;
}
}

if ( $changed ) {
update_user_meta( $user_id, 'minlpg_klippekort_cards', $all );
}
}

update_option( 'minlpg_kk_cardno_migration_offset', $offset + $batch, false );
}

add_action( 'admin_init', 'minlpg_klippekort_maybe_migrate_cardnos' );
}

/**
 * Hent standard størrelse på klippekort for en stasjon.
 */
function minlpg_get_station_klippekort_size( $station_id ) {
$station_id = (int) $station_id;
if ( ! $station_id ) {
return 8;
}

$size = (int) get_user_meta( $station_id, 'minlpg_klippekort_default', true );
if ( $size < 2 ) {
$size = 8;
}

return $size;
}

/**
 * Oppdater standard klippekort-størrelse for en stasjon.
 */
function minlpg_update_station_klippekort_size( $station_id, $size ) {
$station_id = (int) $station_id;
$size       = (int) $size;

if ( ! $station_id ) {
return false;
}

if ( $size < 2 ) {
$size = 2;
}

return (bool) update_user_meta( $station_id, 'minlpg_klippekort_default', $size );
}

/**
 * Hent status for kundens klippekort på en stasjon.
 * Oppretter kortet hvis det mangler.
 */
function minlpg_get_klippekort_status( $user_id, $station_id ) {
$user_id    = (int) $user_id;
$station_id = (int) $station_id;

$size = minlpg_get_station_klippekort_size( $station_id );

$empty = array(
'card_no'    => '',
'size'       => $size,
'used'       => 0,
'remaining'  => $size,
'free_ready' => false,
);

if ( ! $user_id || ! $station_id ) {
return $empty;
}

$all = get_user_meta( $user_id, 'minlpg_klippekort_cards', true );
if ( ! is_array( $all ) ) {
$all = array();
}

$changed = false;

if ( ! isset( $all[ $station_id ] ) || ! is_array( $all[ $station_id ] ) ) {
$all[ $station_id ] = array(
'card_no' => minlpg_klippekort_make_card_no( $station_id, $user_id ),
'size'    => $size,
'used'    => 0,
);
$changed = true;
}

$card = $all[ $station_id ];

// card_no migrering / fallback
$old_expected = 'K' . $station_id . $user_id;
if ( empty( $card['card_no'] ) || ( isset( $card['card_no'] ) && (string) $card['card_no'] === $old_expected ) ) {
if ( ! empty( $card['card_no'] ) && empty( $card['legacy_card_no'] ) ) {
$card['legacy_card_no'] = (string) $card['card_no'];
}
$card['card_no'] = minlpg_klippekort_make_card_no( $station_id, $user_id );
$changed = true;
}

// Synk størrelse med stasjonsinnstillingen
$card['size'] = $size;

// Total used (kan være høyere enn size)
$total_used = isset( $card['used'] ) ? max( 0, (int) $card['used'] ) : 0;
$size_int   = max( 1, (int) $card['size'] );

$used_display = min( $total_used, $size_int );
$remaining    = max( 0, $size_int - $used_display );
$free_ready   = ( $total_used >= $size_int );

$card['used']       = $used_display;
$card['remaining']  = $remaining;
$card['free_ready'] = $free_ready;

// Lagre endringer dersom vi migrerte/oppdaterte
if ( $changed ) {
$all[ $station_id ] = $card;
update_user_meta( $user_id, 'minlpg_klippekort_cards', $all );
}

return $card;
}

/**
 * Registrer ett klipp (betalt fylling) for en kunde på en stasjon.
 */
function minlpg_register_klipp( $user_id, $station_id ) {
$user_id    = (int) $user_id;
$station_id = (int) $station_id;

if ( ! $user_id || ! $station_id ) {
return false;
}

$all = get_user_meta( $user_id, 'minlpg_klippekort_cards', true );
if ( ! is_array( $all ) ) {
$all = array();
}

$size = minlpg_get_station_klippekort_size( $station_id );

if ( ! isset( $all[ $station_id ] ) || ! is_array( $all[ $station_id ] ) ) {
$all[ $station_id ] = array(
'card_no' => minlpg_klippekort_make_card_no( $station_id, $user_id ),
'size'    => $size,
'used'    => 0,
);
} else {
// card_no migrering / fallback
$old_expected = 'K' . $station_id . $user_id;
if ( empty( $all[ $station_id ]['card_no'] ) || (string) $all[ $station_id ]['card_no'] === $old_expected ) {
if ( ! empty( $all[ $station_id ]['card_no'] ) && empty( $all[ $station_id ]['legacy_card_no'] ) ) {
$all[ $station_id ]['legacy_card_no'] = (string) $all[ $station_id ]['card_no'];
}
$all[ $station_id ]['card_no'] = minlpg_klippekort_make_card_no( $station_id, $user_id );
}
}

$current_used = isset( $all[ $station_id ]['used'] ) ? (int) $all[ $station_id ]['used'] : 0;

// Synk størrelse med stasjonsinnstillingen hver gang.
$all[ $station_id ]['size'] = $size;
$all[ $station_id ]['used'] = max( 0, $current_used ) + 1;

return (bool) update_user_meta( $user_id, 'minlpg_klippekort_cards', $all );
}

/**
 * Registrer gratis fylling (resetter used=0).
 */
function minlpg_register_klippekort_free( $user_id, $station_id ) {
$user_id    = (int) $user_id;
$station_id = (int) $station_id;

if ( ! $user_id || ! $station_id ) {
return false;
}

$all = get_user_meta( $user_id, 'minlpg_klippekort_cards', true );
if ( ! is_array( $all ) ) {
$all = array();
}

$size = minlpg_get_station_klippekort_size( $station_id );

if ( ! isset( $all[ $station_id ] ) || ! is_array( $all[ $station_id ] ) ) {
$all[ $station_id ] = array(
'card_no' => minlpg_klippekort_make_card_no( $station_id, $user_id ),
'size'    => $size,
'used'    => 0,
);
} else {
$old_expected = 'K' . $station_id . $user_id;
if ( empty( $all[ $station_id ]['card_no'] ) || (string) $all[ $station_id ]['card_no'] === $old_expected ) {
if ( ! empty( $all[ $station_id ]['card_no'] ) && empty( $all[ $station_id ]['legacy_card_no'] ) ) {
$all[ $station_id ]['legacy_card_no'] = (string) $all[ $station_id ]['card_no'];
}
$all[ $station_id ]['card_no'] = minlpg_klippekort_make_card_no( $station_id, $user_id );
}

$all[ $station_id ]['size'] = $size;
$all[ $station_id ]['used'] = 0;
}

return (bool) update_user_meta( $user_id, 'minlpg_klippekort_cards', $all );
}

/**
 * Internt: valider at stasjonseier kan operere på kunden.
 */
if ( ! function_exists( 'minlpg_klippekort_can_manage_customer' ) ) {
function minlpg_klippekort_can_manage_customer( $station_id, $customer_id, $is_adminish ) {
$station_id  = (int) $station_id;
$customer_id = (int) $customer_id;

if ( $is_adminish ) {
return true;
}

$owner = (int) get_user_meta( $customer_id, 'minlpg_station_owner', true );
return ( $owner === $station_id );
}
}

/**
 * AJAX: stasjonseier registrerer ett klipp på valgt kunde.
 */
function minlpg_ajax_klippekort_add_clip() {

if ( ! is_user_logged_in() ) {
wp_send_json_error( 'Du må være innlogget.' );
}

$current = wp_get_current_user();
$roles   = (array) $current->roles;

$is_adminish = function_exists( 'minlpg_is_adminish' ) ? minlpg_is_adminish( $current ) : ( in_array( 'administrator', $roles, true ) || in_array( 'lpg_admin', $roles, true ) );
$is_station  = in_array( 'stasjonseier', $roles, true );

if ( ! $is_adminish && ! $is_station ) {
wp_send_json_error( 'Du har ikke tilgang.' );
}

// Cap gate (pro-level) + rolle fallback
if ( ! $is_adminish && ! current_user_can( 'minlpg_manage_klippekort' ) && ! $is_station ) {
wp_send_json_error( 'Du har ikke tilgang.' );
}

// Nonce
$nonce = isset( $_POST['nonce'] ) ? sanitize_text_field( wp_unslash( $_POST['nonce'] ) ) : '';
if ( ! wp_verify_nonce( $nonce, 'minlpg_klippekort_add' ) ) {
wp_send_json_error( 'Ugyldig forespørsel.' );
}

$user_id = isset( $_POST['user_id'] ) ? (int) $_POST['user_id'] : 0;

// station_id er låst for stasjonseier
$posted_station_id = isset( $_POST['station_id'] ) ? (int) $_POST['station_id'] : 0;
$station_id        = $is_adminish ? $posted_station_id : (int) $current->ID;

if ( ! $user_id || ! $station_id ) {
wp_send_json_error( 'Mangler bruker eller stasjon.' );
}

// Validate station_id er stasjonseier
$station_user = get_user_by( 'id', $station_id );
if ( ! ( $station_user instanceof WP_User ) || ! in_array( 'stasjonseier', (array) $station_user->roles, true ) ) {
wp_send_json_error( 'Ugyldig stasjon.' );
}

// Kunde må tilhøre stasjonen (med mindre admin)
if ( ! minlpg_klippekort_can_manage_customer( $station_id, $user_id, $is_adminish ) ) {
wp_send_json_error( 'Kunden tilhører ikke denne stasjonen.' );
}

if ( ! minlpg_register_klipp( $user_id, $station_id ) ) {
wp_send_json_error( 'Kunne ikke registrere klipp.' );
}

// Audit
if ( function_exists( 'minlpg_audit_log_event' ) ) {
minlpg_audit_log_event(
'klippekort_add_clip',
array(
'station_id'     => $station_id,
'target_user_id' => $user_id,
)
);
}

$card = minlpg_get_klippekort_status( $user_id, $station_id );
wp_send_json_success( $card );
}
add_action( 'wp_ajax_minlpg_klippekort_add_clip', 'minlpg_ajax_klippekort_add_clip' );

/**
 * AJAX: stasjonseier registrerer gratis fylling (resetter klipp).
 */
function minlpg_ajax_klippekort_register_free() {

if ( ! is_user_logged_in() ) {
wp_send_json_error( 'Du må være innlogget.' );
}

$current = wp_get_current_user();
$roles   = (array) $current->roles;

$is_adminish = function_exists( 'minlpg_is_adminish' ) ? minlpg_is_adminish( $current ) : ( in_array( 'administrator', $roles, true ) || in_array( 'lpg_admin', $roles, true ) );
$is_station  = in_array( 'stasjonseier', $roles, true );

if ( ! $is_adminish && ! $is_station ) {
wp_send_json_error( 'Du har ikke tilgang.' );
}

// Cap gate
if ( ! current_user_can( 'minlpg_manage_klippekort' ) && ! $is_adminish ) {
wp_send_json_error( 'Du har ikke tilgang.' );
}

// Nonce
$nonce = isset( $_POST['nonce'] ) ? sanitize_text_field( wp_unslash( $_POST['nonce'] ) ) : '';
if ( ! wp_verify_nonce( $nonce, 'minlpg_klippekort_free' ) ) {
wp_send_json_error( 'Ugyldig forespørsel.' );
}

$user_id = isset( $_POST['user_id'] ) ? (int) $_POST['user_id'] : 0;

$posted_station_id = isset( $_POST['station_id'] ) ? (int) $_POST['station_id'] : 0;
$station_id        = $is_adminish ? $posted_station_id : (int) $current->ID;

if ( ! $user_id || ! $station_id ) {
wp_send_json_error( 'Mangler bruker eller stasjon.' );
}

$station_user = get_user_by( 'id', $station_id );
if ( ! ( $station_user instanceof WP_User ) || ! in_array( 'stasjonseier', (array) $station_user->roles, true ) ) {
wp_send_json_error( 'Ugyldig stasjon.' );
}

if ( ! minlpg_klippekort_can_manage_customer( $station_id, $user_id, $is_adminish ) ) {
wp_send_json_error( 'Kunden tilhører ikke denne stasjonen.' );
}

if ( ! minlpg_register_klippekort_free( $user_id, $station_id ) ) {
wp_send_json_error( 'Kunne ikke registrere gratis fylling.' );
}

// Audit
if ( function_exists( 'minlpg_audit_log_event' ) ) {
minlpg_audit_log_event(
'klippekort_register_free',
array(
'station_id'     => $station_id,
'target_user_id' => $user_id,
)
);
}

$card = minlpg_get_klippekort_status( $user_id, $station_id );
wp_send_json_success( $card );
}
add_action( 'wp_ajax_minlpg_klippekort_register_free', 'minlpg_ajax_klippekort_register_free' );

/**
 * Badge og blokk-rendering (uendret UI).
 */
function minlpg_render_klippekort_badge( $user_id, $station_id ) {
$card = minlpg_get_klippekort_status( $user_id, $station_id );

if ( ! $card['size'] ) {
$text = '–';
} else {
$text = sprintf( '%d / %d', (int) $card['used'], (int) $card['size'] );
if ( ! empty( $card['free_ready'] ) ) {
$text .= ' (gratis fylling tilgjengelig)';
}
}

printf(
'<span class="minlpg-klippekort-badge" data-minlpg-klippekort-badge="%d">%s</span>',
(int) $user_id,
esc_html( $text )
);
}

function minlpg_render_klippekort_block_for_customer( $user_id, $station_id ) {
$card = minlpg_get_klippekort_status( $user_id, $station_id );
?>
<div class="minlpg-card minlpg-klippekort-card">
<span class="minlpg-status-label minlpg-station-summary-label">KLIPPEKORT</span>

<div class="minlpg-station-summary-body" style="margin-top:.6rem;">
<div class="minlpg-station-summary-meta">
<span title="<?php echo esc_attr( 'Fullt kortnr: ' . (string) $card['card_no'] ); ?>">
Kortnr: <?php echo esc_html( minlpg_klippekort_pretty_card_no( $card['card_no'] ) ); ?>.
</span>
<span>Størrelse: <?php echo esc_html( $card['size'] ); ?> fyllinger</span>
<span>Brukt: <?php echo esc_html( $card['used'] ); ?></span>
<span>Gjenstår: <?php echo esc_html( $card['remaining'] ); ?></span>
</div>

<?php if ( $card['free_ready'] ) : ?>
<p class="minlpg-klippekort-info">
Neste fylling på denne stasjonen er gratis.
</p>
<?php else : ?>
<p style="margin-top:.35rem;font-size:0.8rem;line-height:1.4;color:var(--minlpg-text-muted);">
Etter <?php echo esc_html( $card['size'] ); ?> registrerte klipp
får du én gratis fylling.
</p>
<?php endif; ?>
</div>
</div>
<?php
}