<script>
(function () {
var wrap = document.getElementById('minlpg-priv-picker-<?php echo esc_js( $uid ); ?>');
if (!wrap) return;

var changeBtn  = wrap.querySelector('[data-minlpg-change-station]');
var panel      = wrap.querySelector('[data-minlpg-panel]');
var form       = wrap.querySelector('[data-minlpg-station-form]');
var searchInput = wrap.querySelector('[data-minlpg-station-search]');
var selectEl    = wrap.querySelector('[data-minlpg-station-select]');

var nearestBtn  = document.getElementById('minlpg_nearest_btn_<?php echo esc_js( $uid ); ?>');
var nearestName = document.getElementById('minlpg_nearest_name_<?php echo esc_js( $uid ); ?>');
var nearestDist = document.getElementById('minlpg_nearest_dist_<?php echo esc_js( $uid ); ?>');

if (!panel || !form || !selectEl) {
return;
}

function haversineKm(lat1, lng1, lat2, lng2) {
var R = 6371;
var toRad = function (x) { return x * Math.PI / 180; };
var dLat = toRad(lat2 - lat1);
var dLng = toRad(lng2 - lng1);
var a = Math.sin(dLat/2) * Math.sin(dLat/2) +
Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *
Math.sin(dLng/2) * Math.sin(dLng/2);
var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
return R * c;
}

function formatKm(km) {
if (typeof km !== 'number' || isNaN(km)) return '';
// Norwegian formatting: 49,6
return km.toFixed(1).replace('.', ',');
}

function getOptionByValue(val) {
try {
return selectEl.querySelector('option[value="' + String(val).replace(/"/g, '') + '"]');
} catch (e) {
return null;
}
}

function setAndSubmitStation(stationId) {
if (!stationId) return;
var opt = getOptionByValue(stationId);
if (opt && opt.disabled) {
return;
}
selectEl.value = String(stationId);
form.submit();
}

function computeNearestFromCoords(lat, lng) {
var best = null;
Array.prototype.forEach.call(selectEl.querySelectorAll('option'), function (opt) {
if (!opt || opt.value === '0') return;
if (opt.disabled) return; // skip inactive

var lat2 = parseFloat(opt.getAttribute('data-lat') || '');
var lng2 = parseFloat(opt.getAttribute('data-lng') || '');
if (isNaN(lat2) || isNaN(lng2)) return;

var d = haversineKm(lat, lng, lat2, lng2);
if (best === null || d < best.dist) {
best = {
id: opt.value,
name: opt.getAttribute('data-name') || (opt.textContent || '').trim(),
dist: d
};
}
});
return best;
}

function updateNearestUI(best) {
if (!best) return;

if (nearestName) {
nearestName.textContent = best.name;
}
if (nearestDist) {
nearestDist.textContent = '(ca. ' + formatKm(best.dist) + ' km)';
}
if (nearestBtn) {
nearestBtn.setAttribute('data-nearest-id', best.id);
nearestBtn.disabled = false;
nearestBtn.classList.remove('is-disabled');
}
}

function tryGeoUpdate(passiveOnly, onDone) {
if (!navigator || !navigator.geolocation) {
if (typeof onDone === 'function') onDone(null);
return;
}

// passiveOnly = true -> only update if permission is already granted
if (passiveOnly && navigator.permissions && navigator.permissions.query) {
navigator.permissions.query({ name: 'geolocation' }).then(function (p) {
if (!p || p.state !== 'granted') {
if (typeof onDone === 'function') onDone(null);
return;
}

navigator.geolocation.getCurrentPosition(function (pos) {
var lat = pos && pos.coords ? pos.coords.latitude : null;
var lng = pos && pos.coords ? pos.coords.longitude : null;
if (lat === null || lng === null) {
if (typeof onDone === 'function') onDone(null);
return;
}
var best = computeNearestFromCoords(lat, lng);
updateNearestUI(best);
if (typeof onDone === 'function') onDone(best);
}, function () {
if (typeof onDone === 'function') onDone(null);
}, { enableHighAccuracy: true, timeout: 7000, maximumAge: 60000 });

}).catch(function () {
if (typeof onDone === 'function') onDone(null);
});

return;
}

// active (may prompt)
navigator.geolocation.getCurrentPosition(function (pos) {
var lat = pos && pos.coords ? pos.coords.latitude : null;
var lng = pos && pos.coords ? pos.coords.longitude : null;
if (lat === null || lng === null) {
if (typeof onDone === 'function') onDone(null);
return;
}
var best = computeNearestFromCoords(lat, lng);
updateNearestUI(best);
if (typeof onDone === 'function') onDone(best);
}, function () {
if (typeof onDone === 'function') onDone(null);
}, { enableHighAccuracy: true, timeout: 7000, maximumAge: 60000 });
}

function filterStations(query) {
var q = (query || '').toLowerCase().trim();
var options = selectEl.querySelectorAll('option');

var visible = [];
Array.prototype.forEach.call(options, function (opt) {
if (!opt) return;

if (opt.value === '0') {
opt.hidden = false;
opt.style.display = '';
return;
}

var text    = (opt.textContent || '').toLowerCase();
var code    = (opt.getAttribute('data-code') || '').toLowerCase();
var address = (opt.getAttribute('data-address') || '').toLowerCase();
var name    = (opt.getAttribute('data-name') || '').toLowerCase();
var haystack = text + ' ' + code + ' ' + address + ' ' + name + ' ' + opt.value;

var hide = q && haystack.indexOf(q) === -1;
opt.hidden = hide;
opt.style.display = hide ? 'none' : '';

if (!hide) {
visible.push(opt);
}
});

// Auto-select only if exactly one match AND it is not disabled
if (visible.length === 1 && !visible[0].disabled) {
selectEl.value = visible[0].value;
}
}

// Toggle panel
if (changeBtn) {
changeBtn.addEventListener('click', function () {
var isHidden = (panel.style.display === 'none' || panel.style.display === '');
panel.style.display = isHidden ? 'block' : 'none';

// Trigger real GPS (may prompt) on user click
tryGeoUpdate(false, function () {
// no-op
});

if (isHidden && searchInput) {
searchInput.focus();
}
});
}

// Search filter
if (searchInput) {
searchInput.addEventListener('input', function () {
filterStations(this.value);
});
}

// Nearest button: prefer real GPS, then submit selection
if (nearestBtn) {
nearestBtn.addEventListener('click', function () {
var fallbackId = this.getAttribute('data-nearest-id');

// Trigger real GPS (may prompt) on this click
tryGeoUpdate(false, function (best) {
if (best && best.id) {
setAndSubmitStation(best.id);
return;
}

if (fallbackId) {
setAndSubmitStation(fallbackId);
}
});
});
}

// Passive GPS update on load (only if already granted; no prompt)
tryGeoUpdate(true, function () {
// no-op
});

// Initial normalisation (no filter)
filterStations('');

})();
</script>
<?php
minlpg_print_pump_script();

return ob_get_clean();
}
}

