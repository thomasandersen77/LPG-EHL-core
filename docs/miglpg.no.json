/**
 * Helper: require login + specific role(s)
 */
if ( ! function_exists( 'minlpg_require_role' ) ) {
function minlpg_require_role( $allowed_roles = array() ) {

if ( ! is_user_logged_in() ) {
// Ikke innlogget → la tema / plugin vise standard "Du må være innlogget"-melding
return array( false, '' );
}

$user  = wp_get_current_user();
$roles = (array) $user->roles;

if ( ! empty( $allowed_roles ) ) {
$has_role = false;
foreach ( $allowed_roles as $role ) {
if ( in_array( $role, $roles, true ) ) {
$has_role = true;
break;
}
}

if ( ! $has_role ) {
return array( false, '<p>Du har ikke tilgang til denne siden.</p>' );
}
}

return array( true, $user );
}
}

/**
 * Helper: pen etikett for WP-roller i UI.
 */
if ( ! function_exists( 'minlpg_pretty_role_label' ) ) {
function minlpg_pretty_role_label( $role_slug ) {
switch ( $role_slug ) {
case 'administrator':
return 'Administrator';
case 'lpg_admin':
return 'LPG‑admin';
case 'stasjonseier':
return 'Stasjonseier';
case 'lpg_kunde':
return 'Kunde';
case 'bedrift':
return 'Bedrift';
case 'minlpg_driver':
return 'Sjåfør';
default:
return $role_slug;
}
}
}

/**
 * Min LPG – Stasjons-ID (S001, S002, ...)
 *
 * One source of truth:
 *  - Only users with role: stasjonseier can have a station code
 *  - Stored in user_meta: minlpg_station_code
 *  - Sequence stored in option: minlpg_station_code_seq
 *  - Uses MySQL GET_LOCK to avoid duplicates during concurrency / bulk import
 *  - WP-admin: admin can set/override on Add New User + Edit User.
 *    Leave empty to auto-assign next available code.
 */

if ( ! function_exists( 'minlpg_station_is_owner' ) ) {
function minlpg_station_is_owner( $user_id ) {
$u = get_user_by( 'id', (int) $user_id );
return ( $u instanceof WP_User ) && in_array( 'stasjonseier', (array) $u->roles, true );
}
}

if ( ! function_exists( 'minlpg_station_code_normalize' ) ) {
/**
     * Normalize station code input.
     * Accepts: S008, s8, 8, 008
     * Returns: S008 (or S1000 etc) or '' if invalid.
     */
function minlpg_station_code_normalize( $raw ) {
$raw = strtoupper( trim( (string) $raw ) );
if ( '' === $raw ) {
return '';
}

// Allow "S###" or just digits.
if ( preg_match( '/^S?\s*(\d+)$/', $raw, $m ) ) {
$num = (int) $m[1];
if ( $num <= 0 ) {
return '';
}
$num_str = (string) $num;
return 'S' . str_pad( $num_str, 3, '0', STR_PAD_LEFT );
}

return '';
}
}

if ( ! function_exists( 'minlpg_station_code_exists' ) ) {
/**
     * Check if a station code exists for any user (optionally excluding a user).
     */
function minlpg_station_code_exists( $code, $exclude_user_id = 0 ) {
global $wpdb;

$code            = (string) $code;
$exclude_user_id = (int) $exclude_user_id;

if ( '' === $code ) {
return false;
}

if ( $exclude_user_id > 0 ) {
$found = $wpdb->get_var(
$wpdb->prepare(
"SELECT user_id FROM {$wpdb->usermeta} WHERE meta_key = %s AND meta_value = %s AND user_id <> %d LIMIT 1",
'minlpg_station_code',
$code,
$exclude_user_id
)
);
} else {
$found = $wpdb->get_var(
$wpdb->prepare(
"SELECT user_id FROM {$wpdb->usermeta} WHERE meta_key = %s AND meta_value = %s LIMIT 1",
'minlpg_station_code',
$code
)
);
}

return ! empty( $found );
}
}

if ( ! function_exists( 'minlpg_station_code_get_max_used_for_owners' ) ) {
/**
     * Get max numeric station code used among stasjonseier users.
     */
function minlpg_station_code_get_max_used_for_owners() {
global $wpdb;

$code_key = 'minlpg_station_code';
$caps_key = $wpdb->prefix . 'capabilities';

$sql = $wpdb->prepare(
"
SELECT MAX(CAST(SUBSTRING(um_code.meta_value, 2) AS UNSIGNED))
FROM {$wpdb->usermeta} um_code
INNER JOIN {$wpdb->usermeta} um_caps
ON um_caps.user_id = um_code.user_id
AND um_caps.meta_key = %s
WHERE um_code.meta_key = %s
AND um_code.meta_value REGEXP '^S[0-9]+$'
AND um_caps.meta_value LIKE %s
",
$caps_key,
$code_key,
'%"stasjonseier"%'
);

$max = (int) $wpdb->get_var( $sql );
return max( 0, $max );
}
}

if ( ! function_exists( 'minlpg_station_code_peek_next' ) ) {
/**
     * Best-effort preview of the next auto-generated station code.
     */
function minlpg_station_code_peek_next() {
$max_used = minlpg_station_code_get_max_used_for_owners();
$seq      = (int) get_option( 'minlpg_station_code_seq', 0 );
$next     = max( $seq, $max_used ) + 1;
return 'S' . str_pad( (string) $next, 3, '0', STR_PAD_LEFT );
}
}

if ( ! function_exists( 'minlpg_station_code_set_for_user' ) ) {
/**
     * Set/override station code for a user (admin only in UI, but function is generic).
     * Returns the stored code on success, or '' on failure.
     */
function minlpg_station_code_set_for_user( $user_id, $code_raw ) {
global $wpdb;

$user_id = (int) $user_id;
if ( ! $user_id ) {
return '';
}

// Only station owners can have station codes.
if ( ! minlpg_station_is_owner( $user_id ) ) {
return '';
}

$code = minlpg_station_code_normalize( $code_raw );
if ( '' === $code ) {
return '';
}

// Mutex lock to avoid duplicates (important for bulk import + concurrency)
$lock_name = 'minlpg_station_code_seq_lock';
$locked    = $wpdb->get_var( $wpdb->prepare( 'SELECT GET_LOCK(%s, 10)', $lock_name ) );
$has_lock  = ( '1' === (string) $locked );

try {
// Uniqueness check (exclude current user)
if ( minlpg_station_code_exists( $code, $user_id ) ) {
return '';
}

// Persist
update_user_meta( $user_id, 'minlpg_station_code', $code );

// Keep option in sync (never decreases)
if ( preg_match( '/^S(\d+)$/', $code, $m ) ) {
$num = (int) $m[1];
$seq = (int) get_option( 'minlpg_station_code_seq', 0 );
if ( $num > $seq ) {
update_option( 'minlpg_station_code_seq', $num, false );
}
}

return $code;

} finally {
if ( $has_lock ) {
$wpdb->get_var( $wpdb->prepare( 'SELECT RELEASE_LOCK(%s)', $lock_name ) );
}
}
}
}

if ( ! function_exists( 'minlpg_get_station_code' ) ) {
/**
     * Get (or create) station code for a station owner.
     */
function minlpg_get_station_code( $station_user_id ) {
global $wpdb;

$station_user_id = (int) $station_user_id;
if ( ! $station_user_id ) {
return '';
}

// Only station owners can have a station code.
if ( ! minlpg_station_is_owner( $station_user_id ) ) {
return '';
}

$existing = get_user_meta( $station_user_id, 'minlpg_station_code', true );
if ( $existing ) {
$normalized = minlpg_station_code_normalize( $existing );
if ( $normalized && $normalized !== $existing ) {
update_user_meta( $station_user_id, 'minlpg_station_code', $normalized );
return $normalized;
}
// If it's non-empty but non-standard, don't destroy it silently.
return (string) $existing;
}

// Mutex lock to avoid duplicates (important for bulk import + concurrency)
$lock_name = 'minlpg_station_code_seq_lock';
$locked    = $wpdb->get_var( $wpdb->prepare( 'SELECT GET_LOCK(%s, 10)', $lock_name ) );
$has_lock  = ( '1' === (string) $locked );

try {
// Re-check after lock
$existing = get_user_meta( $station_user_id, 'minlpg_station_code', true );
if ( $existing ) {
return (string) $existing;
}

// Sync the sequence with actual max used among station owners.
$max_used = minlpg_station_code_get_max_used_for_owners();
$seq      = (int) get_option( 'minlpg_station_code_seq', 0 );

$next = max( $seq, $max_used ) + 1;

// Safety: ensure uniqueness even if old data polluted other users.
$tries = 0;
do {
$code = 'S' . str_pad( (string) $next, 3, '0', STR_PAD_LEFT );
if ( ! minlpg_station_code_exists( $code ) ) {
break;
}
$next++;
$tries++;
} while ( $tries < 200 );

update_option( 'minlpg_station_code_seq', (int) $next, false );
update_user_meta( $station_user_id, 'minlpg_station_code', $code );

return $code;

} finally {
if ( $has_lock ) {
$wpdb->get_var( $wpdb->prepare( 'SELECT RELEASE_LOCK(%s)', $lock_name ) );
}
}
}
}

/**
 * Assign station code immediately when a station owner is created / gets role.
 */
if ( ! function_exists( 'minlpg_station_code_assign_if_needed' ) ) {
function minlpg_station_code_assign_if_needed( $user_id ) {
$user_id = (int) $user_id;
if ( ! $user_id ) {
return;
}

// If we are in WP-admin user creation, allow manual code.
$manual = '';
if ( isset( $_POST['minlpg_station_code'] ) ) {
$manual = sanitize_text_field( wp_unslash( $_POST['minlpg_station_code'] ) );
}

if ( minlpg_station_is_owner( $user_id ) ) {
if ( '' !== $manual ) {
$set = minlpg_station_code_set_for_user( $user_id, $manual );
if ( '' !== $set ) {
return;
}
}

// Fallback: auto-assign.
minlpg_get_station_code( $user_id );
}
}
}
