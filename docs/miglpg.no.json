<?php
$sid   = (int) $station_user->ID;
$label = minlpg_get_station_label( $sid );
?>
<option value="<?php echo esc_attr( $sid ); ?>"
<?php selected( $current_station, $sid ); ?>>
<?php echo esc_html( $label ); ?>
</option>
<?php endforeach; ?>
</select>
<p class="description">
Sjåføren vil se ordre for denne stasjonen i sitt dashboard.
</p>
</td>
</tr>
</table>
<?php
}
