<script>
document.addEventListener('DOMContentLoaded', function () {
const root  = document.querySelector('.minlpg-dashboard-customers');
if (!root) return;

const table = root.querySelector('.minlpg-customers-table');
const rows  = table ? Array.from(table.querySelectorAll('[data-customer-row]')) : [];
const searchInput = root.querySelector('[data-minlpg-customer-search]');

// Live-søk i tabellen
if (searchInput && rows.length) {
searchInput.addEventListener('input', function () {
const q = this.value.trim().toLowerCase();
rows.forEach(function (row) {
const haystack = (row.getAttribute('data-search') || '');
row.style.display = !q || haystack.indexOf(q) !== -1 ? '' : 'none';
});
});
}

// Klikk på rad => åpne modal (men ikke når man trykker på knapper/lenker)
rows.forEach(function (row) {
row.addEventListener('click', function (event) {
if (event.target.closest('button, a, input, label, form')) {
return;
}
const id    = row.getAttribute('data-customer-id');
const modal = document.getElementById('minlpg-customer-modal-' + id);
if (modal) {
modal.classList.add('is-open');
modal.setAttribute('aria-hidden', 'false');
}
});
});

// Åpne via "Detaljer"-knapp
root.querySelectorAll('[data-minlpg-open-customer]').forEach(function (btn) {
btn.addEventListener('click', function (event) {
event.stopPropagation();
