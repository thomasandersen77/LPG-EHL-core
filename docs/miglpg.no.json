/**
 * KUNDE / DRIVER DASHBOARD – shortcode: [minlpg_kunde]
 *
 * Router:
 *   user_type = bedrift_dispenser  → minlpg_kunde_bedrift_dispenser_shortcode()
 *   user_type = priv_butikk        → minlpg_kunde_privat_dispenser_shortcode()
 *   user_type = bedrift_levering   → minlpg_kunde_bedrift_flasker_shortcode()
 *   user_type = priv_levering      → minlpg_kunde_privat_flasker_shortcode()
 *   role = sjafør / driver         → minlpg_driver_dashboard_shortcode()
 *   annet                          → enkel fallback‑side
 */
function minlpg_customer_dashboard_shortcode() {
// 1) Hvis ikke innlogget: vis innloggingsskjema på samme URL
if ( ! is_user_logged_in() ) {
// Bruk egen [minlpg_login]-shortcode hvis den finnes, ellers standard WP-skjema
if ( shortcode_exists( 'minlpg_login' ) ) {
return do_shortcode( '[minlpg_login]' );
}

ob_start();
wp_login_form();
return ob_get_clean();
}

// 2) Når brukeren er innlogget – sjekk at rollen er en av våre "portal"-roller
$roles_allowed = array(
'lpg_kunde',
'lpg_admin',
'administrator',
'sjafor',
'lpg_driver',
'driver',
'minlpg_driver',
'stasjonseier',
);

list( $ok, $data ) = minlpg_require_role( $roles_allowed );
if ( ! $ok ) {
return $data;
}

/** @var WP_User $user */
$user  = $data;
$roles = (array) $user->roles;

$user_type = get_user_meta( $user->ID, 'minlpg_user_type', true );

// 3) Sjåfør-rollen rutes til sjåfør‑dashboardet
$driver_roles = array( 'sjafor', 'lpg_driver', 'driver', 'minlpg_driver' );
$is_driver    = ! empty( array_intersect( $driver_roles, $roles ) );

if ( $is_driver ) {

// NEW: Use the route-planner as the driver dashboard (synced blocks + actions)
if ( shortcode_exists( 'minlpg_driver_route_planner' ) ) {
return do_shortcode( '[minlpg_driver_route_planner]' );
}

// Fallbacks (in case shortcode is disabled for some reason)
if ( function_exists( 'minlpg_driver_route_planner_shortcode' ) ) {
return minlpg_driver_route_planner_shortcode();
}

if ( function_exists( 'minlpg_driver_dashboard_shortcode' ) ) {
return minlpg_driver_dashboard_shortcode();
}

return '';
}


// 4) Stasjonseier kan få sitt eget dashboard her hvis du ønsker at de også skal bruke Kundeportal
if ( in_array( 'stasjonseier', $roles, true ) && function_exists( 'minlpg_owner_dashboard_shortcode' ) ) {
return minlpg_owner_dashboard_shortcode();
}

// 5) Kunden rutes videre etter type

// Bedrift – flasker / CO₂ levering
if ( 'bedrift_levering' === $user_type && function_exists( 'minlpg_kunde_bedrift_flasker_shortcode' ) ) {
return minlpg_kunde_bedrift_flasker_shortcode();
}

// Privat – flasker / CO₂ levering
if ( 'priv_levering' === $user_type && function_exists( 'minlpg_kunde_privat_flasker_shortcode' ) ) {
return minlpg_kunde_privat_flasker_shortcode();
}

// Bedrift – dispenser
if ( 'bedrift_dispenser' === $user_type && function_exists( 'minlpg_kunde_bedrift_dispenser_shortcode' ) ) {
return minlpg_kunde_bedrift_dispenser_shortcode();
}

// Privat – butikk & dispenser
if ( 'priv_butikk' === $user_type && function_exists( 'minlpg_kunde_privat_dispenser_shortcode' ) ) {
return minlpg_kunde_privat_dispenser_shortcode();
}

// 6) Fallback: enkel standard kundeportal
ob_start(); ?>
