if ( ! function_exists( 'minlpg_driver_station_profile_field' ) ) {
function minlpg_driver_station_profile_field( $user ) {

if ( ! ( $user instanceof WP_User ) ) {
return;
}

$roles     = (array) $user->roles;
$is_driver = array_intersect(
array( 'sjafor', 'lpg_driver', 'driver', 'minlpg_driver' ),
$roles
);

if ( empty( $is_driver ) ) {
return;
}

$current_station = (int) get_user_meta( $user->ID, 'minlpg_driver_station', true );

$stations = get_users(
array(
'role'    => 'stasjonseier',
'orderby' => 'display_name',
'order'   => 'ASC',
'number'  => 9999,
)
);
?>
<h2>Min LPG – levering / sjåfør</h2>
