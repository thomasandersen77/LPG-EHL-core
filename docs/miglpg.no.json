/** ---------------------------
 *  Helpers
 * --------------------------- */
if ( ! function_exists( 'minlpg_routeplanner_clean_address' ) ) {
function minlpg_routeplanner_clean_address( $addr ) {
$addr = wp_strip_all_tags( (string) $addr );
$addr = str_replace( array( "\r\n", "\n", "\r" ), ', ', $addr );
$addr = preg_replace( '/\s+/', ' ', $addr );
$addr = trim( $addr, " \t\n\r\0\x0B," );
return $addr;
}
}

if ( ! function_exists( 'minlpg_routeplanner_normalize_address' ) ) {
function minlpg_routeplanner_normalize_address( $addr ) {
$a = strtolower( minlpg_routeplanner_clean_address( $addr ) );
$a = preg_replace( '/\s+/', ' ', $a );
return trim( $a );
}
}

if ( ! function_exists( 'minlpg_routeplanner_format_duration' ) ) {
function minlpg_routeplanner_format_duration( $seconds ) {
$seconds = (int) $seconds;
if ( $seconds <= 0 ) {
return '–';
}
$h = (int) floor( $seconds / 3600 );
$m = (int) floor( ( $seconds % 3600 ) / 60 );

if ( $h > 0 ) {
return sprintf( '%dh %02dm', $h, $m );
}
return sprintf( '%dm', $m );
}
}

if ( ! function_exists( 'minlpg_routeplanner_format_distance' ) ) {
function minlpg_routeplanner_format_distance( $meters ) {
$meters = (int) $meters;
if ( $meters <= 0 ) {
return '–';
}
$km = $meters / 1000;
return number_format_i18n( $km, 1 ) . ' km';
}
}

if ( ! function_exists( 'minlpg_routeplanner_status_label' ) ) {
function minlpg_routeplanner_status_label( $status ) {
$status = (string) $status;
if ( 'new' === $status ) {
return 'Ny';
}
if ( 'accepted' === $status ) {
return 'Tildelt sjåfør';
}
if ( 'delivered' === $status ) {
return 'Levert';
}
return $status ? $status : '–';
}
}

/**
 * Google Directions API optimizer.
 * Returns: array( ok => bool, order => array indexes, distance_m => int, duration_s => int, error => string )
 */
if ( ! function_exists( 'minlpg_routeplanner_optimize_google' ) ) {
function minlpg_routeplanner_optimize_google( $origin, $destination, array $waypoints, $key ) {
$origin      = minlpg_routeplanner_clean_address( $origin );
$destination = minlpg_routeplanner_clean_address( $destination );
$key         = trim( (string) $key );

if ( ! $origin || ! $destination ) {
return array( 'ok' => false, 'error' => 'Missing origin/destination.' );
}
if ( count( $waypoints ) < 2 ) {
return array( 'ok' => true, 'order' => array_keys( $waypoints ), 'distance_m' => 0, 'duration_s' => 0 );
}
if ( ! $key ) {
return array( 'ok' => false, 'error' => 'No Google API key configured.' );
}

$waypoints_clean = array_map( 'minlpg_routeplanner_clean_address', $waypoints );
$waypoints_param = 'optimize:true|' . implode( '|', $waypoints_clean );

$url = add_query_arg(
array(
'origin'      => $origin,
'destination' => $destination,
'waypoints'   => $waypoints_param,
'mode'        => 'driving',
'region'      => 'no',
'language'    => 'en',
'key'         => $key,
),
'https://maps.googleapis.com/maps/api/directions/json'
);

$cache_key = 'minlpg_route_' . md5( $url );
$cached    = get_transient( $cache_key );
if ( is_array( $cached ) ) {
return $cached;
}

$response = wp_remote_get(
$url,
array(
'timeout' => 20,
)
);

if ( is_wp_error( $response ) ) {
return array( 'ok' => false, 'error' => $response->get_error_message() );
}

$body = wp_remote_retrieve_body( $response );
$data = json_decode( $body, true );

if ( ! is_array( $data ) || empty( $data['status'] ) ) {
return array( 'ok' => false, 'error' => 'Invalid response from Google.' );
}

if ( 'OK' !== $data['status'] ) {
$msg = 'Google status: ' . $data['status'];
if ( ! empty( $data['error_message'] ) ) {
$msg .= ' – ' . $data['error_message'];
}
return array( 'ok' => false, 'error' => $msg );
}

$route = isset( $data['routes'][0] ) ? $data['routes'][0] : array();

$order = isset( $route['waypoint_order'] ) && is_array( $route['waypoint_order'] )
? $route['waypoint_order']
: array();

$distance_m = 0;
$duration_s = 0;

if ( ! empty( $route['legs'] ) && is_array( $route['legs'] ) ) {
foreach ( $route['legs'] as $leg ) {
$distance_m += (int) ( $leg['distance']['value'] ?? 0 );
$duration_s += (int) ( $leg['duration']['value'] ?? 0 );
}
}

$result = array(
'ok'         => true,
'order'      => $order,
'distance_m' => $distance_m,
'duration_s' => $duration_s,
);

set_transient( $cache_key, $result, 10 * MINUTE_IN_SECONDS );

return $result;
}
}

/** Build Google Maps “open route” link */
if ( ! function_exists( 'minlpg_routeplanner_build_maps_link' ) ) {
function minlpg_routeplanner_build_maps_link( $origin, $destination, array $ordered_waypoints ) {
$origin      = minlpg_routeplanner_clean_address( $origin );
$destination = minlpg_routeplanner_clean_address( $destination );

$params = array(
'api'         => 1,
'origin'      => $origin,
'destination' => $destination,
'travelmode'  => 'driving',
);

if ( ! empty( $ordered_waypoints ) ) {
$params['waypoints'] = implode( '|', array_map( 'minlpg_routeplanner_clean_address', $ordered_waypoints ) );
}

return 'https://www.google.com/maps/dir/?' . http_build_query( $params );
}
}

/** Very simple fallback ordering (postcode + address) */
if ( ! function_exists( 'minlpg_routeplanner_fallback_sort_stops' ) ) {
function minlpg_routeplanner_fallback_sort_stops( array $stops ) {
usort( $stops, function ( $a, $b ) {
$ap = 9999;
$bp = 9999;

if ( preg_match( '/\b(\d{4})\b/', (string) $a['address'], $m ) ) {
$ap = (int) $m[1];
}
if ( preg_match( '/\b(\d{4})\b/', (string) $b['address'], $m ) ) {
$bp = (int) $m[1];
}

if ( $ap !== $bp ) {
return $ap <=> $bp;
}

return strcmp(
minlpg_routeplanner_normalize_address( $a['address'] ),
minlpg_routeplanner_normalize_address( $b['address'] )
);
} );

return $stops;
}
}

/** ---------------------------
 *  Shortcode
 * --------------------------- */
if ( ! function_exists( 'minlpg_driver_route_planner_shortcode' ) ) {
function minlpg_driver_route_planner_shortcode() {

// Render-once guard (prevents duplicates if shortcode appears twice on same page)
static $rendered = false;
if ( $rendered ) {
return '';
}
$rendered = true;

// Only show for driver roles (INVISIBLE for others)
$driver_roles = array( 'sjafor', 'lpg_driver', 'driver', 'minlpg_driver' );

if ( ! is_user_logged_in() ) {
return '';
}

$user  = wp_get_current_user();
$roles = (array) $user->roles;

if ( empty( array_intersect( $driver_roles, $roles ) ) ) {
return '';
}

$station_id = (int) get_user_meta( $user->ID, 'minlpg_driver_station', true );
if ( ! $station_id ) {
return '<div class="minlpg-alert">Ingen stasjon er koblet til denne sjåføren ennå (minlpg_driver_station).</div>';
}

// Pick date (GET)
$selected_date = current_time( 'Y-m-d' );
if ( isset( $_GET['minlpg_route_date'] ) ) {
$d = sanitize_text_field( wp_unslash( $_GET['minlpg_route_date'] ) );
if ( preg_match( '/^\d{4}-\d{2}-\d{2}$/', $d ) ) {
$selected_date = $d;
}
}

// Station address = route origin
$station_address = (string) get_user_meta( $station_id, 'minlpg_address', true );
$station_address = minlpg_routeplanner_clean_address( $station_address );

// Notice after actions
$notice = '';

$action_nonce = wp_create_nonce( 'minlpg_routeplanner_' . (int) $user->ID );

/** ---------------------------
		 *  PRO ACTION HANDLER (POST)
		 * --------------------------- */
if ( isset( $_POST['minlpg_rp_action'], $_POST['minlpg_routeplanner_nonce'] ) ) {

$nonce_ok = wp_verify_nonce(
sanitize_text_field( wp_unslash( $_POST['minlpg_routeplanner_nonce'] ) ),
'minlpg_routeplanner_' . (int) $user->ID
);

if ( $nonce_ok ) {

$action = sanitize_key( wp_unslash( $_POST['minlpg_rp_action'] ) );

$post_date = $selected_date;
if ( isset( $_POST['minlpg_route_date'] ) ) {
$tmp = sanitize_text_field( wp_unslash( $_POST['minlpg_route_date'] ) );
if ( preg_match( '/^\d{4}-\d{2}-\d{2}$/', $tmp ) ) {
$post_date = $tmp;
}
}

// Helper: check order belongs to station/date
$order_matches_station_date = function ( $order_id ) use ( $station_id, $post_date ) {
$order_id = (int) $order_id;
if ( ! $order_id ) {
return false;
}
$oid_station = (int) get_post_meta( $order_id, '_minlpg_order_station', true );
$oid_date    = (string) get_post_meta( $order_id, '_minlpg_delivery_date', true );
return ( $oid_station === (int) $station_id ) && ( $oid_date === (string) $post_date );
};

// 1) Take all NEW orders for the date
if ( 'take_all' === $action ) {

$order_ids = get_posts(
array(
'post_type'      => 'minlpg_delivery',
'posts_per_page' => 500,
'fields'         => 'ids',
'meta_query'     => array(
'relation' => 'AND',
array(
'key'   => '_minlpg_order_station',
'value' => $station_id,
),
array(
'key'   => '_minlpg_delivery_date',
'value' => $post_date,
),
array(
'key'   => '_minlpg_order_status',
'value' => 'new',
),
),
)
);

$taken = 0;
foreach ( $order_ids as $oid ) {
$oid = (int) $oid;
if ( ! $oid ) {
continue;
}

$current_status = (string) get_post_meta( $oid, '_minlpg_order_status', true );
if ( 'new' !== $current_status ) {
continue;
}

update_post_meta( $oid, '_minlpg_order_status', 'accepted' );
update_post_meta( $oid, '_minlpg_order_driver', (int) $user->ID );
$taken++;
}

$notice = $taken > 0
? sprintf( 'Tildelte %d ordre til deg (status: accepted).', $taken )
: 'Ingen nye ordre å tildele for valgt dato.';
}

// 1b) Take ONE new order (per row)
if ( 'take_one' === $action && isset( $_POST['minlpg_order_id'] ) ) {

$oid = (int) sanitize_text_field( wp_unslash( $_POST['minlpg_order_id'] ) );

if ( ! $order_matches_station_date( $oid ) ) {
$notice = 'Ugyldig ordre (feil stasjon/dato).';
} else {
$current_status = (string) get_post_meta( $oid, '_minlpg_order_status', true );
if ( 'new' !== $current_status ) {
$notice = 'Denne ordren er ikke lenger tilgjengelig (ikke status: new).';
} else {
update_post_meta( $oid, '_minlpg_order_status', 'accepted' );
update_post_meta( $oid, '_minlpg_order_driver', (int) $user->ID );
$notice = 'Ordre tildelt deg (accepted).';
}
}
}

// 2) Mark all MY accepted orders for date as delivered
if ( 'deliver_all' === $action ) {

$order_ids = get_posts(
array(
'post_type'      => 'minlpg_delivery',
'posts_per_page' => 500,
'fields'         => 'ids',
'meta_query'     => array(
'relation' => 'AND',
array(
'key'   => '_minlpg_order_station',
'value' => $station_id,
),
array(
'key'   => '_minlpg_delivery_date',
'value' => $post_date,
),
array(
'key'   => '_minlpg_order_driver',
'value' => (int) $user->ID,
),
array(
'key'   => '_minlpg_order_status',
'value' => 'accepted',
),
),
)
);

$done = 0;
foreach ( $order_ids as $oid ) {
$oid = (int) $oid;
if ( ! $oid ) {
continue;
}

update_post_meta( $oid, '_minlpg_order_status', 'delivered' );
update_post_meta( $oid, '_minlpg_delivered_at', current_time( 'mysql' ) );
$done++;
}

$notice = $done > 0
? sprintf( 'Markerte %d ordre som levert.', $done )
: 'Ingen ordre (status: accepted) å markere som levert for valgt dato.';
}

// 2b) Mark ONE of my accepted orders as delivered
if ( 'deliver_one' === $action && isset( $_POST['minlpg_order_id'] ) ) {

$oid = (int) sanitize_text_field( wp_unslash( $_POST['minlpg_order_id'] ) );

if ( ! $order_matches_station_date( $oid ) ) {
$notice = 'Ugyldig ordre (feil stasjon/dato).';
} else {
$current_status = (string) get_post_meta( $oid, '_minlpg_order_status', true );
$current_drv    = (int) get_post_meta( $oid, '_minlpg_order_driver', true );

if ( 'accepted' !== $current_status || (int) $user->ID !== $current_drv ) {
$notice = 'Du kan ikke levere denne ordren (ikke tildelt deg eller feil status).';
} else {
update_post_meta( $oid, '_minlpg_order_status', 'delivered' );
update_post_meta( $oid, '_minlpg_delivered_at', current_time( 'mysql' ) );
$notice = 'Ordre markert som levert.';
}
}
}

// 3) Move ONE of my accepted orders for date to another date
if ( 'move_one' === $action && isset( $_POST['minlpg_order_id'] ) ) {

$oid = (int) sanitize_text_field( wp_unslash( $_POST['minlpg_order_id'] ) );

$new_date = '';
if ( isset( $_POST['minlpg_move_date'] ) ) {
$tmp = sanitize_text_field( wp_unslash( $_POST['minlpg_move_date'] ) );
if ( preg_match( '/^\d{4}-\d{2}-\d{2}$/', $tmp ) ) {
$new_date = $tmp;
}
}

if ( ! $new_date ) {
$notice = 'Velg en gyldig ny dato (YYYY-MM-DD).';
} elseif ( ! $order_matches_station_date( $oid ) ) {
$notice = 'Ugyldig ordre (feil stasjon/dato).';
} else {
$current_status = (string) get_post_meta( $oid, '_minlpg_order_status', true );
$current_drv    = (int) get_post_meta( $oid, '_minlpg_order_driver', true );

if ( 'accepted' !== $current_status || (int) $user->ID !== $current_drv ) {
$notice = 'Du kan ikke flytte denne ordren (ikke tildelt deg eller feil status).';
} else {

update_post_meta( $oid, '_minlpg_delivery_date', $new_date );

// Audit trail (doesn't break any existing logic)
update_post_meta( $oid, '_minlpg_rescheduled_from', $post_date );
update_post_meta( $oid, '_minlpg_rescheduled_to', $new_date );
update_post_meta( $oid, '_minlpg_rescheduled_by', (int) $user->ID );
update_post_meta( $oid, '_minlpg_rescheduled_at', current_time( 'mysql' ) );

$notice = sprintf(
'Flyttet ordre #%d fra %s til %s.',
$oid,
esc_html( $post_date ),
esc_html( $new_date )
);
}
}
}

// 4) Move all MY accepted orders for date to another date
if ( 'move_all' === $action ) {

$new_date = '';
if ( isset( $_POST['minlpg_move_date'] ) ) {
$tmp = sanitize_text_field( wp_unslash( $_POST['minlpg_move_date'] ) );
if ( preg_match( '/^\d{4}-\d{2}-\d{2}$/', $tmp ) ) {
$new_date = $tmp;
}
}

if ( ! $new_date ) {
$notice = 'Velg en gyldig ny dato (YYYY-MM-DD).';
} else {

$order_ids = get_posts(
array(
'post_type'      => 'minlpg_delivery',
'posts_per_page' => 500,
'fields'         => 'ids',
'meta_query'     => array(
'relation' => 'AND',
array(
'key'   => '_minlpg_order_station',
'value' => $station_id,
),
array(
'key'   => '_minlpg_delivery_date',
'value' => $post_date,
),
array(
'key'   => '_minlpg_order_driver',
'value' => (int) $user->ID,
),
array(
'key'   => '_minlpg_order_status',
'value' => 'accepted',
),
),
)
);

$moved = 0;
foreach ( $order_ids as $oid ) {
$oid = (int) $oid;
if ( ! $oid ) {
continue;
}

update_post_meta( $oid, '_minlpg_delivery_date', $new_date );

// Audit trail (doesn't break any existing logic)
update_post_meta( $oid, '_minlpg_rescheduled_from', $post_date );
update_post_meta( $oid, '_minlpg_rescheduled_to', $new_date );
update_post_meta( $oid, '_minlpg_rescheduled_by', (int) $user->ID );
update_post_meta( $oid, '_minlpg_rescheduled_at', current_time( 'mysql' ) );

$moved++;
}

$notice = $moved > 0
? sprintf( 'Flyttet %d ordre fra %s til %s.', $moved, esc_html( $post_date ), esc_html( $new_date ) )
: 'Ingen av dine ordre (status: accepted) å flytte for valgt dato.';

// After moving ALL, show the new date automatically
$selected_date = $new_date;
}
}

} else {
$notice = 'Ugyldig forespørsel (nonce). Oppdater siden og prøv igjen.';
}
}

/** ---------------------------
		 *  Load orders for this date
		 * --------------------------- */

// NEW orders (date)
$new_orders = get_posts(
array(
'post_type'      => 'minlpg_delivery',
'posts_per_page' => 500,
'meta_key'       => '_minlpg_created_at',
'orderby'        => 'meta_value',
'order'          => 'ASC',
'meta_query'     => array(
'relation' => 'AND',
array(
'key'   => '_minlpg_order_station',
'value' => $station_id,
),
array(
'key'   => '_minlpg_delivery_date',
'value' => $selected_date,
),
array(
'key'   => '_minlpg_order_status',
'value' => 'new',
),
),
)
);

// MY orders (accepted + delivered)
$my_orders = get_posts(
array(
'post_type'      => 'minlpg_delivery',
'posts_per_page' => 500,
'meta_key'       => '_minlpg_created_at',
'orderby'        => 'meta_value',
'order'          => 'ASC',
'meta_query'     => array(
'relation' => 'AND',
array(
'key'   => '_minlpg_order_station',
'value' => $station_id,
),
array(
'key'   => '_minlpg_delivery_date',
'value' => $selected_date,
),
array(
'key'   => '_minlpg_order_driver',
'value' => (int) $user->ID,
),
array(
'key'     => '_minlpg_order_status',
'value'   => array( 'accepted', 'delivered' ),
'compare' => 'IN',
),
),
)
);

// Orders used for route planning (new + accepted, but we skip accepted by other drivers in stop-building)
$route_orders = get_posts(
array(
'post_type'      => 'minlpg_delivery',
'posts_per_page' => 500,
'meta_key'       => '_minlpg_created_at',
'orderby'        => 'meta_value',
'order'          => 'ASC',
'meta_query'     => array(
'relation' => 'AND',
array(
'key'   => '_minlpg_order_station',
'value' => $station_id,
),
array(
'key'   => '_minlpg_delivery_date',
'value' => $selected_date,
),
array(
'key'     => '_minlpg_order_status',
'value'   => array( 'new', 'accepted' ),
'compare' => 'IN',
),
),
)
);

$new_count = is_array( $new_orders ) ? count( $new_orders ) : 0;

$my_accept_count = 0;
if ( is_array( $my_orders ) ) {
foreach ( $my_orders as $o ) {
$st = (string) get_post_meta( (int) $o->ID, '_minlpg_order_status', true );
if ( 'accepted' === $st ) {
$my_accept_count++;
}
}
}

/** ---------------------------
		 *  Build stops (group by address)
		 * --------------------------- */
$stops_by_addr = array(); // normalized => [ address => raw, orders => [ids...] ]

foreach ( $route_orders as $order ) {
$order_id = (int) $order->ID;

$status    = (string) get_post_meta( $order_id, '_minlpg_order_status', true );
$order_drv = (int) get_post_meta( $order_id, '_minlpg_order_driver', true );

// Skip orders accepted by another driver
if ( 'accepted' === $status && $order_drv && $order_drv !== (int) $user->ID ) {
continue;
}

$addr_raw = (string) get_post_meta( $order_id, '_minlpg_delivery_address', true );
$addr_raw = minlpg_routeplanner_clean_address( $addr_raw );

if ( ! $addr_raw ) {
continue;
}

$key = minlpg_routeplanner_normalize_address( $addr_raw );

if ( ! isset( $stops_by_addr[ $key ] ) ) {
$stops_by_addr[ $key ] = array(
'address' => $addr_raw,
'orders'  => array(),
);
}
$stops_by_addr[ $key ]['orders'][] = $order_id;
}

$stops = array_values( $stops_by_addr );

// Default ordering (fallback)
$ordered_stops = minlpg_routeplanner_fallback_sort_stops( $stops );

// Try Google optimization if possible
$key = minlpg_routeplanner_get_google_key();

$route_error   = '';
$total_dist_m  = 0;
$total_dur_s   = 0;
$used_google   = false;

if ( $station_address && count( $stops ) >= 2 && $key ) {
$waypoints = array_map(
function ( $s ) {
return $s['address'];
},
$stops
);

$google = minlpg_routeplanner_optimize_google( $station_address, $station_address, $waypoints, $key );

if ( ! empty( $google['ok'] ) && ! empty( $google['order'] ) && is_array( $google['order'] ) ) {
$used_google  = true;
$total_dist_m = (int) ( $google['distance_m'] ?? 0 );
$total_dur_s  = (int) ( $google['duration_s'] ?? 0 );

$tmp = array();
foreach ( $google['order'] as $idx ) {
if ( isset( $stops[ $idx ] ) ) {
$tmp[] = $stops[ $idx ];
}
}
if ( ! empty( $tmp ) ) {
$ordered_stops = $tmp;
}
} else {
$route_error = (string) ( $google['error'] ?? 'Route optimization failed.' );
}
} elseif ( count( $stops ) >= 2 && ! $station_address ) {
$route_error = 'Missing station address (minlpg_address on station owner).';
} elseif ( count( $stops ) >= 2 && ! $key ) {
$route_error = 'No Google API key configured (using fallback sorting).';
}

// Build final Maps link (even with fallback order)
$ordered_waypoints = array_map(
function ( $s ) {
return $s['address'];
},
$ordered_stops
);

$maps_url = '';
if ( $station_address && ! empty( $ordered_waypoints ) ) {
$maps_url = minlpg_routeplanner_build_maps_link( $station_address, $station_address, $ordered_waypoints );
}

// Station label
$station_label = function_exists( 'minlpg_get_station_label' )
? minlpg_get_station_label( $station_id )
: 'Station #' . $station_id;

ob_start();
?>
