/**
 * Hjelpefunksjon (v2): finn riktig dashboard for bruker basert på rolle
 * NB: Eget navn for å unngå "Cannot redeclare" mot eksisterende snippets.
 */
if ( ! function_exists( 'minlpg_get_dashboard_url_for_user_v2' ) ) {
function minlpg_get_dashboard_url_for_user_v2( $user ) {
if ( ! $user || ! isset( $user->roles ) ) {
return home_url( '/' );
}

$roles = (array) $user->roles;

// Admin / LPG‑admin → eget admin‑panel
if ( in_array( 'administrator', $roles, true ) || in_array( 'lpg_admin', $roles, true ) ) {
return home_url( '/admin-panel/' );
}

// Stasjonseier → stasjonseier‑dashboard
if ( in_array( 'stasjonseier', $roles, true ) ) {
return home_url( '/stasjonseier/' );
}

// Sjåfør → kundeportalen (router sjåfør videre)
$driver_roles = array( 'sjafor', 'lpg_driver', 'driver', 'minlpg_driver' );
if ( ! empty( array_intersect( $driver_roles, $roles ) ) ) {
return home_url( '/kundeportal/' );
}

// Vanlig LPG‑kunde → kundeportalen
if ( in_array( 'lpg_kunde', $roles, true ) ) {
return home_url( '/kundeportal/' );
}

// Fallback
return home_url( '/' );
}
}

/**
 * Backend-tilgang: kun administrator eller lpg_admin (rolle-sjekk)
 */
if ( ! function_exists( 'minlpg_is_backend_allowed_user_v2' ) ) {
function minlpg_is_backend_allowed_user_v2( $user = null ) {
// Administrators kan alltid via capability
if ( current_user_can( 'manage_options' ) ) {
return true;
}

if ( ! ( $user instanceof WP_User ) ) {
$user = wp_get_current_user();
}

$roles = $user ? (array) $user->roles : array();

return in_array( 'administrator', $roles, true ) || in_array( 'lpg_admin', $roles, true );
}
}

/**
 * 1) Forsiden:
 *    - Ikke innlogget → til login
 *    - Innlogget      → til riktig dashboard
 */
add_action( 'template_redirect', function () {
if ( is_admin() || ! is_front_page() ) {
return;
}

if ( function_exists( 'is_customize_preview' ) && is_customize_preview() ) {
return;
}

if ( ! is_user_logged_in() ) {
wp_safe_redirect( wp_login_url() );
exit;
}

$user   = wp_get_current_user();
$target = minlpg_get_dashboard_url_for_user_v2( $user );

// Unngå redirect-loop hvis forsiden faktisk er dashboardet
$current_path = isset( $_SERVER['REQUEST_URI'] ) ? parse_url( $_SERVER['REQUEST_URI'], PHP_URL_PATH ) : '';
$target_path  = parse_url( $target, PHP_URL_PATH );

if ( $target && $target_path && untrailingslashit( (string) $current_path ) !== untrailingslashit( (string) $target_path ) ) {
wp_safe_redirect( $target );
exit;
}
} );

/**
 * 2) Etter innlogging:
 *    Overstyr login_redirect slik at alle havner på riktig dashboard
 */
add_filter( 'login_redirect', function ( $redirect_to, $request, $user ) {
if ( is_wp_error( $user ) || ! ( $user instanceof WP_User ) ) {
return $redirect_to;
}

return minlpg_get_dashboard_url_for_user_v2( $user );
}, 10, 3 );

/**
 * 3) Skjul admin‑bar for alle unntatt administrator / lpg_admin
 */
