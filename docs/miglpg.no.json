/**
 * ADMIN DASHBOARD – shortcode: [minlpg_admin]
 */
function minlpg_admin_dashboard_shortcode() {
list( $ok, $data ) = minlpg_require_role( array( 'administrator', 'lpg_admin' ) );
if ( ! $ok ) {
return $data;
}

/** @var WP_User $user */
$user = $data;

// Admin AJAX + nonce (stasjonsstatus)
$admin_ajax_url      = admin_url( 'admin-ajax.php' );
$station_status_nonce = wp_create_nonce( 'minlpg_station_status' );

// Alle stasjonseiere (stasjoner)
$station_owners = get_users(
array(
'role'    => 'stasjonseier',
'orderby' => 'display_name',
'order'   => 'ASC',
'number'  => 9999,
)
);
$station_count = is_array( $station_owners ) ? count( $station_owners ) : 0;

// Alle andre brukere (kunder osv.) – ekskluder stasjonseier + adminroller
$all_users = get_users(
array(
'orderby' => 'display_name',
'order'   => 'ASC',
'number'  => 9999,
