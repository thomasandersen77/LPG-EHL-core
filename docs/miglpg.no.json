/**
 * Min LPG – Privatkunde – butikk & dispenser v2.1
 */
if ( ! function_exists( 'minlpg_geo_distance_km' ) ) {
/**
     * Beregn avstand mellom to koordinater (Haversine), i kilometer.
     */
function minlpg_geo_distance_km( $lat1, $lon1, $lat2, $lon2 ) {
$earth_radius = 6371; // km

$lat1 = deg2rad( (float) $lat1 );
$lon1 = deg2rad( (float) $lon1 );
$lat2 = deg2rad( (float) $lat2 );
$lon2 = deg2rad( (float) $lon2 );

$dlat = $lat2 - $lat1;
// Correct: lon2 - lon1
$dlon = $lon2 - $lon1;

$a = sin( $dlat / 2 ) * sin( $dlat / 2 ) +
cos( $lat1 ) * cos( $lat2 ) *
sin( $dlon / 2 ) * sin( $dlon / 2 );

$c = 2 * atan2( sqrt( $a ), sqrt( 1 - $a ) );

return $earth_radius * $c;
}
}

/**
 * Min LPG – Privatkunde butikk & dispenser
 * Shortcode: [minlpg_kunde_privat_dispenser]
 */
if ( ! function_exists( 'minlpg_kunde_privat_dispenser_shortcode' ) ) {
function minlpg_kunde_privat_dispenser_shortcode() {
list( $ok, $data ) = minlpg_require_role( array( 'lpg_kunde', 'lpg_admin', 'administrator' ) );
if ( ! $ok ) {
return $data;
}

/** @var WP_User $user */
$user = $data;

$user_type = get_user_meta( $user->ID, 'minlpg_user_type', true );
if ( 'priv_butikk' !== $user_type ) {
return '<p>Dette panelet gjelder bare for «Privatkunde – butikk &amp; dispenser».</p>';
}

$notice_html = '';

// Hent gjeldende valgt stasjon fra user_meta
$selected_station = (int) get_user_meta( $user->ID, 'minlpg_selected_station', true );

// Oppdater stasjon fra POST (blokker INACTIVE)
if ( isset( $_POST['minlpg_station_select'] ) && is_user_logged_in() ) {
$new_station = isset( $_POST['minlpg_station_select'] ) ? (int) $_POST['minlpg_station_select'] : 0;

if ( $new_station > 0 ) {
$station_user = get_user_by( 'id', $new_station );
$is_station_owner = ( $station_user instanceof WP_User ) && in_array( 'stasjonseier', (array) $station_user->roles, true );

$status = 'active';
if ( $is_station_owner ) {
if ( function_exists( 'minlpg_get_station_status' ) ) {
$status = minlpg_get_station_status( $new_station );
} else {
$raw = get_user_meta( $new_station, 'minlpg_station_status', true );
$raw = strtolower( trim( (string) $raw ) );
$status = ( 'inactive' === $raw ) ? 'inactive' : 'active';
}
}

if ( ! $is_station_owner ) {
$notice_html = '<p style="margin-top:.8rem;opacity:.85;">Ugyldig stasjon.</p>';
} elseif ( 'inactive' === $status ) {
// Block even if someone POSTs manually
$notice_html = '<p style="margin-top:.8rem;opacity:.85;">Denne stasjonen er inaktiv og kan ikke velges akkurat nå.</p>';
} else {
update_user_meta( $user->ID, 'minlpg_selected_station', $new_station );
$selected_station = $new_station;
}
}
}

// Liste over alle stasjonseiere
$station_users = get_users(
array(
'role'    => 'stasjonseier',
'number'  => 300,
'orderby' => 'display_name',
'order'   => 'ASC',
)
);

// Bygg én "source of truth" liste for UI + geolokasjon
$stations = array();
foreach ( $station_users as $su ) {
$sid = (int) $su->ID;

// Status
if ( function_exists( 'minlpg_get_station_status' ) ) {
$status = minlpg_get_station_status( $sid );
} else {
$raw = get_user_meta( $sid, 'minlpg_station_status', true );
$raw = strtolower( trim( (string) $raw ) );
$status = ( 'inactive' === $raw ) ? 'inactive' : 'active';
}
$is_active = ( 'active' === $status );

// Code + meta
$code = function_exists( 'minlpg_get_station_code' ) ? minlpg_get_station_code( $sid ) : (string) get_user_meta( $sid, 'minlpg_station_code', true );
$addr = (string) get_user_meta( $sid, 'minlpg_address', true );
$lat  = get_user_meta( $sid, 'minlpg_lat', true );
$lng  = get_user_meta( $sid, 'minlpg_lng', true );

$stations[ $sid ] = array(
'id'     => $sid,
'name'   => (string) $su->display_name,
'code'   => (string) $code,
'addr'   => (string) $addr,
'status' => $status,
'active' => $is_active,
'lat'    => ( '' === (string) $lat ) ? '' : (string) $lat,
'lng'    => ( '' === (string) $lng ) ? '' : (string) $lng,
);
}

/**
         * Geolocation (server fallback): "Geolocation IP Detection" plugin.
         */
$user_coords = null;
if ( function_exists( 'geoip_detect2_get_info_from_current_ip' ) ) {
try {
$geo = geoip_detect2_get_info_from_current_ip();
if ( ! empty( $geo->location->latitude ) && ! empty( $geo->location->longitude ) ) {
$user_coords = array(
'lat' => (float) $geo->location->latitude,
'lng' => (float) $geo->location->longitude,
);
}
} catch ( Exception $e ) {
$user_coords = null;
}
}

$nearest_station_id   = 0;
$nearest_station_name = '';
$nearest_distance_km  = null;

// Finn nærmeste stasjon basert på server coords (kun ACTIVE stasjoner)
if ( $user_coords ) {
foreach ( $stations as $st ) {
if ( empty( $st['active'] ) ) {
continue;
}

$lat = $st['lat'];
$lng = $st['lng'];
if ( '' === (string) $lat || '' === (string) $lng ) {
continue;
}

$distance = minlpg_geo_distance_km(
$user_coords['lat'],
$user_coords['lng'],
(float) $lat,
(float) $lng
);

if ( null === $nearest_distance_km || $distance < $nearest_distance_km ) {
$nearest_distance_km  = $distance;
$nearest_station_id   = (int) $st['id'];
$nearest_station_name = (string) $st['name'];
}
}
}

// Info om valgt stasjon
$station_name   = 'Ingen stasjon valgt';
$station_legal  = '';
$station_org    = '';
$station_addr   = '';
$station_code   = '';
$station_status = 'active';

if ( $selected_station && isset( $stations[ $selected_station ] ) ) {
$su = get_user_by( 'id', $selected_station );
if ( $su instanceof WP_User ) {
$station_name  = (string) $su->display_name;
$station_legal = (string) get_user_meta( $selected_station, 'minlpg_legal_name', true );
$station_org   = (string) get_user_meta( $selected_station, 'minlpg_org_number', true );
$station_addr  = (string) get_user_meta( $selected_station, 'minlpg_address', true );
$station_code  = function_exists( 'minlpg_get_station_code' ) ? (string) minlpg_get_station_code( $selected_station ) : '';

$station_status = isset( $stations[ $selected_station ]['status'] ) ? (string) $stations[ $selected_station ]['status'] : 'active';
$station_status = ( 'inactive' === $station_status ) ? 'inactive' : 'active';
}
} elseif ( $selected_station ) {
// Selected station no longer exists or not station owner
$selected_station = 0;
}

$has_station       = ( $selected_station > 0 );
$station_is_active = ( $has_station && 'active' === $station_status );

// Unique wrapper to avoid collisions
$uid = function_exists( 'wp_rand' ) ? wp_rand( 1000, 999999 ) : mt_rand( 1000, 999999 );

// Station status pill UI
$status_label = $station_is_active ? 'ACTIVE' : 'INACTIVE';
$pill_class   = $station_is_active ? 'minlpg-status-ok' : 'minlpg-status-off';

ob_start(); ?>
