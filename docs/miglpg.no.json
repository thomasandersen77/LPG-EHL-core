// ADMIN: toggling av stasjonsstatus (ACTIVE/INACTIVE)
var adminWrap     = document.querySelector('.minlpg-dashboard-admin');
var adminAjaxUrl  = adminWrap ? (adminWrap.dataset.minlpgAdminAjax || '') : '';
var statusNonce   = adminWrap ? (adminWrap.dataset.minlpgStationStatusNonce || '') : '';

if (adminAjaxUrl && statusNonce) {
document.querySelectorAll('[data-minlpg-station-toggle]').forEach(function (toggleBtn) {
toggleBtn.addEventListener('click', function () {
var stationId = toggleBtn.getAttribute('data-minlpg-station-toggle');
if (!stationId) return;

var current = toggleBtn.getAttribute('data-current-status') || 'active';
var target  = (current === 'active') ? 'inactive' : 'active';

var oldText = toggleBtn.textContent;
toggleBtn.disabled = true;
toggleBtn.textContent = 'Lagrer...';

var fd = new FormData();
fd.append('action', 'minlpg_set_station_status');
fd.append('nonce', statusNonce);
fd.append('station_id', stationId);
fd.append('status', target);

fetch(adminAjaxUrl, {
method: 'POST',
credentials: 'same-origin',
body: fd
})
.then(function (r) { return r.json(); })
.then(function (json) {
if (!json || !json.success) {
var msg = (json && json.data && json.data.message) ? json.data.message : 'Ukjent feil';
throw new Error(msg);
}

var newStatus = json.data.status;
var newLabel  = json.data.label;
var pillClass = json.data.pill_class;

// Oppdater status-pill i tabellen
var pill = document.querySelector('[data-minlpg-station-status-pill="' + stationId + '"]');
if (pill) {
pill.textContent = newLabel;
pill.classList.remove('minlpg-status-ok', 'minlpg-status-off', 'minlpg-status-offline');
if (pillClass) {
pill.classList.add(pillClass);
}
}

// Hold "Åpne"-knappen oppdatert for detaljvisning
var openBtn = document.querySelector('button[data-minlpg-open="station"][data-station-id="' + stationId + '"]');
if (openBtn && openBtn.dataset) {
openBtn.dataset.stationStatus = newStatus;
}

// Oppdater toggle-knappen
toggleBtn.setAttribute('data-current-status', newStatus);

if (newStatus === 'active') {
toggleBtn.textContent = 'Deaktiver';
toggleBtn.classList.remove('minlpg-button-green');
toggleBtn.classList.add('minlpg-button-red');
} else {
toggleBtn.textContent = 'Aktiver';
toggleBtn.classList.remove('minlpg-button-red');
toggleBtn.classList.add('minlpg-button-green');
}
})
.catch(function (err) {
console.error(err);
toggleBtn.textContent = oldText;
alert('Kunne ikke oppdatere status: ' + err.message);
})
.finally(function () {
toggleBtn.disabled = false;
});
});
});
}

}
});
</script>
<?php
}
