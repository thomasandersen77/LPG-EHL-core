</div>

</form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
const form = document.getElementById('minlpg-register-form');
if (!form) return;

const step1   = form.querySelector('.minlpg-reg-step[data-step="1"]');
const step2   = form.querySelector('.minlpg-reg-step[data-step="2"]');
const nextBtn = document.getElementById('minlpg-next-step');
const prevBtn = document.getElementById('minlpg-prev-step');

const typeRadios = form.querySelectorAll('input[name="minlpg_user_type"]');
const typeCards  = form.querySelectorAll('.minlpg-user-type-card');

function getSelectedType() {
let val = '';
typeRadios.forEach(function (r) {
if (r.checked) val = r.value;
});
return val;
}

function updateStep2Fields() {
const t = getSelectedType();
const addrGroup   = form.querySelectorAll('.minlpg-group-addr');
const bedriftGrp  = form.querySelectorAll('.minlpg-group-bedrift');
const creditGroup = form.querySelectorAll('.minlpg-group-credit');

const addrTitle   = form.querySelector('.minlpg-section-title--addr');
const bedriftTitle= form.querySelector('.minlpg-section-title--bedrift');
const creditTitle = form.querySelector('.minlpg-section-title--credit');

// Hide all optional groups
addrGroup.forEach(el => el.style.display = 'none');
bedriftGrp.forEach(el => el.style.display = 'none');
creditGroup.forEach(el => el.style.display = 'none');
if (addrTitle) addrTitle.style.display = 'none';
if (bedriftTitle) bedriftTitle.style.display = 'none';
if (creditTitle) creditTitle.style.display = 'none';

if (t === 'priv_levering') {
addrGroup.forEach(el => el.style.display = 'block');
if (addrTitle) addrTitle.style.display = 'block';
}
if (t === 'bedrift_levering' || t === 'bedrift_dispenser') {
bedriftGrp.forEach(el => el.style.display = 'block');
addrGroup.forEach(el => el.style.display = 'block');
if (addrTitle) addrTitle.style.display = 'block';
if (bedriftTitle) bedriftTitle.style.display = 'block';
}
if (t === 'bedrift_dispenser') {
creditGroup.forEach(el => el.style.display = 'block');
if (creditTitle) creditTitle.style.display = 'block';
}
}

// Highlight card + enable Next when user selects a type
typeRadios.forEach(function (radio) {
radio.addEventListener('change', function () {
if (nextBtn) nextBtn.disabled = false;

typeCards.forEach(function (card) {
card.classList.toggle('is-selected', card.contains(radio) && radio.checked);
});
});
});

if (nextBtn) {
nextBtn.addEventListener('click', function () {
const type = getSelectedType();
if (!type) {
alert('Velg brukertype for å gå videre.');
return;
}
updateStep2Fields();
if (step1) step1.style.display = 'none';
if (step2) step2.style.display = 'block';
window.scrollTo({ top: form.offsetTop - 40, behavior: 'smooth' });
});
}

if (prevBtn) {
prevBtn.addEventListener('click', function () {
if (step2) step2.style.display = 'none';
if (step1) step1.style.display = 'block';
window.scrollTo({ top: form.offsetTop - 40, behavior: 'smooth' });
});
}
});
</script>
<?php

return ob_get_clean();
}
