/**
 * Helper: finn stasjon (stasjonseier‑ID) for en kunde
 */
if ( ! function_exists( 'minlpg_get_station_for_customer' ) ) {
function minlpg_get_station_for_customer( $user_id ) {
$user_id = (int) $user_id;
if ( ! $user_id ) {
return 0;
}

$station_id = (int) get_user_meta( $user_id, 'minlpg_station_owner', true );

// fallback: hvis kunden er stasjonseier selv
if ( ! $station_id ) {
$user = get_user_by( 'id', $user_id );
if ( $user instanceof WP_User && in_array( 'stasjonseier', (array) $user->roles, true ) ) {
$station_id = $user_id;
}
}

return $station_id;
}
}

/**
 * Helper: label for stasjon – bruker eksisterende header‑helper fra dashboard core hvis den finnes
 */
if ( ! function_exists( 'minlpg_get_station_label' ) ) {
function minlpg_get_station_label( $station_id ) {
$station_id = (int) $station_id;
if ( ! $station_id ) {
return 'Ukjent stasjon';
}

if ( function_exists( 'minlpg_get_station_header_data' ) ) {
$h     = minlpg_get_station_header_data( $station_id );
$label = $h['station_name'];
if ( ! empty( $h['station_code'] ) ) {
$label .= ' – ' . $h['station_code'];
}
return $label ? $label : 'Stasjon #' . $station_id;
}

$u = get_user_by( 'id', $station_id );
