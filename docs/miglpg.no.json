minlpg_print_pump_script();
}


$defaults = array(
'station_id'    => 0,
'dispenser_id'  => 'main',
'price_med'     => '18.90',
'price_uten'    => '14.50',
'status'        => 'online',
'context'       => 'owner',   // 'owner', 'business', 'business_privat'
'receipts'      => array(),
'reports'       => array(),
);

$config = wp_parse_args( $config, $defaults );

$station_id   = (int) $config['station_id'];
