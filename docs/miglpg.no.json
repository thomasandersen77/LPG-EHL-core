/**
 * Automatically geocode a station user when its profile is saved,
 * if it has an address and missing coords.
 */
function minlpg_geocode_station_on_profile_save( $user_id, $old_user_data = null ) {
if ( ! current_user_can( 'manage_options' ) ) {
// Only auto-geocode when an admin is saving station profiles.
return;
}

$user = get_userdata( $user_id );
if ( ! $user || ! in_array( 'stasjonseier', (array) $user->roles, true ) ) {
return;
}

$lat = get_user_meta( $user_id, 'minlpg_lat', true );
$lng = get_user_meta( $user_id, 'minlpg_lng', true );
if ( '' !== $lat && '' !== $lng ) {
// Already has coords, do nothing.
return;
}

$address = get_user_meta( $user_id, 'minlpg_address', true );
if ( '' === trim( (string) $address ) ) {
return;
}

$result = minlpg_geocode_station_user( $user_id, false );
// You could log $result if you want; for now we keep it silent.
}
add_action( 'profile_update', 'minlpg_geocode_station_on_profile_save', 10, 2 );

