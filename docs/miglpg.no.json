var modal      = card.querySelector('[data-minlpg-fueling-modal]');
var countdown  = modal ? modal.querySelector('[data-minlpg-fueling-countdown]') : null;
var closeBtns  = modal ? modal.querySelectorAll('[data-minlpg-fueling-close]') : [];
var backdrop   = modal ? modal.querySelector('.minlpg-fueling-backdrop') : null;

var state = {
expiresAt: 0,
interval: null
};

function openModal() {
if (!modal) return;
modal.classList.add('is-open');
modal.setAttribute('aria-hidden', 'false');
}

function closeModal() {
if (!modal) return;
modal.classList.remove('is-open');
modal.setAttribute('aria-hidden', 'true');
}

function updateCountdown() {
if (!state.expiresAt) return;

var remainingMs  = state.expiresAt - Date.now();
var remainingSec = Math.ceil(remainingMs / 1000);
if (remainingSec < 0) remainingSec = 0;

if (countdown) {
countdown.textContent = formatMMSS(remainingSec);
}

if (remainingSec <= 0) {
if (state.interval) {
clearInterval(state.interval);
state.interval = null;
}
state.expiresAt = 0;

if (msg) {
msg.style.display = 'none';
}
closeModal();
}
}

function start2MinWindow() {
state.expiresAt = Date.now() + (2 * 60 * 1000);

if (msg) {
msg.style.display = 'block';
}

openModal();
updateCountdown();

if (state.interval) {
clearInterval(state.interval);
}
state.interval = setInterval(updateCountdown, 1000);
}

if (armBtn) {
armBtn.addEventListener('click', function () {
start2MinWindow();
});
}

if (backdrop) {
backdrop.addEventListener('click', function () {
closeModal();
});
}

for (var i = 0; i < closeBtns.length; i++) {
closeBtns[i].addEventListener('click', function () {
closeModal();
});
}
}

if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', init);
} else {
init();
}
})();
</script>
<?php endif; ?>

</article>
<?php
}
}

