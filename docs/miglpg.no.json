/**
 * Shortcode: [minlpg_login_links]
 */
// Helper: same dashboard URL logic we already use elsewhere
if (!function_exists('minlpg_get_dashboard_url_for_user')) {
function minlpg_get_dashboard_url_for_user($user) {
if (!$user || !isset($user->roles)) {
return home_url('/');
}

$roles = (array) $user->roles;

if (in_array('administrator', $roles, true) || in_array('lpg_admin', $roles, true)) {
return home_url('/admin-panel/');
} elseif (in_array('stasjonseier', $roles, true)) {
return home_url('/stasjonseier/');
} elseif (in_array('lpg_kunde', $roles, true)) {
return home_url('/kundeportal/');
}

return home_url('/');
}
}

/**
 * Force all "Register" links (wp_registration_url / register_url)
 * to go to our custom registration page with [minlpg_register].
 *
 * Change '/registrering/' if your registration page has a different slug.
 */
add_filter('register_url', function ($url) {
return home_url('/registrering/');
});

// Shortcode: [minlpg_login_links]
function minlpg_login_links_shortcode() {

if (is_user_logged_in()) {
$logout = wp_logout_url(home_url('/'));

// Only show "Logg ut" when logged in
$html  = '<span class="minlpg-login-links">';
$html .= '<a href="' . esc_url($logout) . '">Logg ut</a>';
$html .= '</span>';

return $html;

} else {
$login    = wp_login_url();        // LoginPress-styled login page
$register = wp_registration_url(); // Now points to /registrering/ via the filter above

$html  = '<span class="minlpg-login-links">';
$html .= '<a href="' . esc_url($login) . '">Logg inn</a>';
$html .= ' | <a href="' . esc_url($register) . '">Registrer</a>';
$html .= '</span>';

return $html;
}
}
add_shortcode('minlpg_login_links', 'minlpg_login_links_shortcode');

