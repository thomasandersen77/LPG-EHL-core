<?php if ( $done_url ) : ?>
<a class="minlpg-button minlpg-button-small" href="<?php echo esc_url( $done_url ); ?>">
Markér som levert
</a>
<?php else : ?>
<span class="minlpg-tag-muted">–</span>
<?php endif; ?>
</td>
