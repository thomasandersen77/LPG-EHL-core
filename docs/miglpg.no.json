/**
 * Lagre valgt stasjon for sjåfør
 */
if ( ! function_exists( 'minlpg_driver_station_profile_save' ) ) {
function minlpg_driver_station_profile_save( $user_id ) {
if ( ! current_user_can( 'edit_user', $user_id ) ) {
return;
}

if ( isset( $_POST['minlpg_driver_station'] ) ) {
$station_id = (int) $_POST['minlpg_driver_station'];
if ( $station_id < 0 ) {
$station_id = 0;
}
update_user_meta( $user_id, 'minlpg_driver_station', $station_id );
}
}
}
add_action( 'personal_options_update', 'minlpg_driver_station_profile_save' );
add_action( 'edit_user_profile_update', 'minlpg_driver_station_profile_save' );
add_action( 'user_register', 'minlpg_driver_station_profile_save' );

/**
 * Sjåfør‑dashboard
 * Shortcode: [minlpg_sjafor_flasker]
 */
if ( ! function_exists( 'minlpg_driver_dashboard_shortcode' ) ) {
function minlpg_driver_dashboard_shortcode() {

if ( ! function_exists( 'minlpg_require_role' ) ) {
return '<p>Konfigurasjonsfeil: minlpg_require_role mangler.</p>';
}

$driver_roles = array( 'sjafor', 'lpg_driver', 'driver', 'minlpg_driver' );

list( $ok, $data ) = minlpg_require_role(
array_merge( $driver_roles, array( 'lpg_admin', 'administrator' ) )
);

if ( ! $ok ) {
return $data;
}

/** @var WP_User $user */
$user = $data;

$station_id = (int) get_user_meta( $user->ID, 'minlpg_driver_station', true );
if ( ! $station_id ) {
return '<p>Ingen stasjon er koblet til denne sjåføren enda. Gå til brukerprofilen i WP‑admin og velg «Tilknyttet stasjon».</p>';
}

// Håndter enkle statusendringer via GET (?minlpg_delivery_action=accept/deliver&order_id=..)
if (
isset( $_GET['minlpg_delivery_action'], $_GET['order_id'], $_GET['_wpnonce'] )
) {
$action  = sanitize_key( wp_unslash( $_GET['minlpg_delivery_action'] ) );
$order_id = (int) $_GET['order_id'];

if ( $order_id && in_array( $action, array( 'accept', 'deliver' ), true ) ) {
if ( wp_verify_nonce( sanitize_text_field( wp_unslash( $_GET['_wpnonce'] ) ), 'minlpg_delivery_action_' . $order_id ) ) {
$current_station = (int) get_post_meta( $order_id, '_minlpg_order_station', true );
if ( $current_station === $station_id ) {
if ( 'accept' === $action ) {
update_post_meta( $order_id, '_minlpg_order_status', 'accepted' );
update_post_meta( $order_id, '_minlpg_order_driver', $user->ID );
} elseif ( 'deliver' === $action ) {
update_post_meta( $order_id, '_minlpg_order_status', 'delivered' );
update_post_meta( $order_id, '_minlpg_order_driver', $user->ID );
update_post_meta( $order_id, '_minlpg_delivered_at', current_time( 'mysql' ) );
}
}
}
}
}

