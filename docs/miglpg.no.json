/**
 * Min LPG – Station coordinates
 */
/**
 * Min LPG – automatic coordinates for station users (role: stasjonseier)
 *
 * - Adds a Tools-page in wp-admin: "Min LPG – Station coordinates"
 *   where you can bulk-geocode all stations that have an address.
 * - Automatically geocodes a station when its user profile is saved,
 *   if it has an address and minlpg_lat / minlpg_lng are empty.
 *
 * Coordinates are stored as user_meta:
 *   minlpg_lat  (float)
 *   minlpg_lng  (float)
 */

/**
 * Geocode an address using OpenStreetMap Nominatim.
 *
 * IMPORTANT: Replace the email below with a real email address
 * that can receive contact in case of abuse (Nominatim policy).
 */
function minlpg_geocode_address_osm( $address ) {
$address = trim( (string) $address );
if ( '' === $address ) {
return false;
}

// Always assume Norway if country is not explicitly in the string.
$lower = function_exists( 'mb_strtolower' )
? mb_strtolower( $address, 'UTF-8' )
: strtolower( $address );

if ( false === strpos( $lower, 'norway' ) && false === strpos( $lower, 'norge' ) ) {
$address .= ', Norway';
}

// Use ONE real email here (Nominatim requirement)
$contact_email = 'support@minlpg.no'; // TODO: change to your real email

$url = add_query_arg(
array(
'q'      => $address,
'format' => 'jsonv2',
'limit'  => 1,
'email'  => $contact_email,
),
'https://nominatim.openstreetmap.org/search'
);

$response = wp_remote_get(
$url,
array(
'timeout' => 10,
'headers' => array(
'User-Agent' => 'MinLPG/1.0 (' . $contact_email . ')',
),
)
);

if ( is_wp_error( $response ) ) {
return false;
}

$body = wp_remote_retrieve_body( $response );
if ( ! $body ) {
return false;
}

$data = json_decode( $body, true );
if ( ! is_array( $data ) || empty( $data[0]['lat'] ) || empty( $data[0]['lon'] ) ) {
return false;
}

return array(
'lat' => (float) $data[0]['lat'],
'lng' => (float) $data[0]['lon'],
);
}

/**
 * Geocode one station user if it has an address and missing coords.
 *
 * @param int $user_id
 * @param bool $force If true, overwrite existing coords.
 * @return array{status:string,message:string}
 */
function minlpg_geocode_station_user( $user_id, $force = false ) {
$user = get_userdata( $user_id );
if ( ! $user ) {
return array(
'status'  => 'error',
'message' => "User {$user_id} not found",
);
}

if ( ! in_array( 'stasjonseier', (array) $user->roles, true ) ) {
return array(
'status'  => 'skipped',
'message' => "{$user->display_name}: not a stasjonseier",
);
}

$address = get_user_meta( $user_id, 'minlpg_address', true );
if ( '' === trim( (string) $address ) ) {
return array(
'status'  => 'skipped',
'message' => "{$user->display_name}: no minlpg_address set",
);
}

$lat = get_user_meta( $user_id, 'minlpg_lat', true );
$lng = get_user_meta( $user_id, 'minlpg_lng', true );

if ( ! $force && '' !== $lat && '' !== $lng ) {
return array(
'status'  => 'skipped',
'message' => "{$user->display_name}: already has coords ({$lat}, {$lng})",
);
}

$coords = minlpg_geocode_address_osm( $address );
if ( ! $coords ) {
return array(
'status'  => 'error',
'message' => "{$user->display_name}: geocoding FAILED for address \"{$address}\"",
);
}

update_user_meta( $user_id, 'minlpg_lat', $coords['lat'] );
update_user_meta( $user_id, 'minlpg_lng', $coords['lng'] );

return array(
'status'  => 'ok',
'message' => "{$user->display_name}: set coords to ({$coords['lat']}, {$coords['lng']})",
);
}

/**
 * Bulk-geocode all station users from wp-admin (Tools page).
 */
function minlpg_geocode_all_stations( $force = false ) {
$results = array();

$station_users = get_users(
array(
'role'    => 'stasjonseier',
'number'  => 500,
'orderby' => 'display_name',
'order'   => 'ASC',
)
);

foreach ( $station_users as $su ) {
$results[] = minlpg_geocode_station_user( $su->ID, $force );
}

return $results;
}

