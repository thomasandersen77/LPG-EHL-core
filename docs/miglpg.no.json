if ( ! function_exists( 'minlpg_is_adminish' ) ) {
function minlpg_is_adminish( $user = null ) {
if ( null === $user ) {
$user = wp_get_current_user();
} elseif ( is_numeric( $user ) ) {
$user = get_user_by( 'id', (int) $user );
}

if ( ! ( $user instanceof WP_User ) ) {
return false;
}

$roles = (array) $user->roles;
return in_array( 'administrator', $roles, true ) || in_array( 'lpg_admin', $roles, true );
}
}

if ( ! function_exists( 'minlpg_is_station_owner' ) ) {
function minlpg_is_station_owner( $user = null ) {
if ( null === $user ) {
$user = wp_get_current_user();
} elseif ( is_numeric( $user ) ) {
$user = get_user_by( 'id', (int) $user );
}

if ( ! ( $user instanceof WP_User ) ) {
return false;
}

$roles = (array) $user->roles;
return in_array( 'stasjonseier', $roles, true );
}
}

if ( ! function_exists( 'minlpg_get_client_ip' ) ) {
function minlpg_get_client_ip() {
// Best effort – bak en proxy kan dette være feil uten riktig proxy-konfig.
$candidates = array(
'HTTP_CF_CONNECTING_IP',
'HTTP_X_FORWARDED_FOR',
'HTTP_X_REAL_IP',
'REMOTE_ADDR',
);

foreach ( $candidates as $key ) {
if ( empty( $_SERVER[ $key ] ) ) {
continue;
}

$val = (string) $_SERVER[ $key ];
if ( 'HTTP_X_FORWARDED_FOR' === $key ) {
// kan være "ip, ip, ip"
$parts = array_map( 'trim', explode( ',', $val ) );
$val   = $parts ? (string) $parts[0] : $val;
}

$val = trim( $val );
if ( filter_var( $val, FILTER_VALIDATE_IP ) ) {
return $val;
}
}

return '';
}
}

/**
