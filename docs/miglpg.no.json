/**
 * Min LPG – Bulk registrering av stasjoner (ADMIN ONLY)
 */
/**
 * Min LPG – Bulk registrering av stasjoner (ADMIN ONLY)
 *
 * Shortcode:
 *   [minlpg_station_bulk_register]
 *
 * Støtter:
 *   - CSV (kommaseparert eller semikolon)
 *   - XLSX (Excel)
 *
 * Forventede kolonner (header-rad) – Norsk/Engelsk varianter støttes:
 *   - Stasjon / Station
 *   - Selskap / Juridisk navn / Legal name
 *   - Adresse / Address
 *   - Region
 *   - Org.nr / Organisasjonsnummer / Org number
 *   - Coordinates / Koordinater
 *   - Telefonnummer / Telefon / Phone
 *   - E-post / Email
 *   - Web / Website
 *
 * Importen oppretter/oppdaterer WP-brukere med rolle: stasjonseier.
 * Data lagres som:
 *   - display_name: stasjonsnavn
 *   - user_email: login-epost (valgfritt – se skjema)
 *   - user_meta:
 *       minlpg_legal_name
 *       minlpg_org_number
 *       minlpg_address
 *       minlpg_region
 *       minlpg_lat / minlpg_lng
 *       minlpg_station_phone
 *       minlpg_station_web
 *       minlpg_station_contact_email
 *       minlpg_station_status  (settes til 'active' på nye)
 */

/* ---------------------------------
 * Admin-gate
 * --------------------------------- */
if ( ! function_exists( 'minlpg_bulk_require_admin' ) ) {
function minlpg_bulk_require_admin() {
if ( ! is_user_logged_in() ) {
return array( false, '<p>Du må være innlogget for å bruke denne siden.</p>' );
}

$user  = wp_get_current_user();
$roles = $user ? (array) $user->roles : array();

if ( in_array( 'administrator', $roles, true ) || in_array( 'lpg_admin', $roles, true ) ) {
return array( true, $user );
}

return array( false, '<p>Du har ikke tilgang til denne siden.</p>' );
}
}

/* ---------------------------------
 * Header-normalisering
 * --------------------------------- */
if ( ! function_exists( 'minlpg_bulk_normalize_header' ) ) {
function minlpg_bulk_normalize_header( $header ) {
$h = (string) $header;
$h = trim( $h );

// Remove UTF-8 BOM (common in CSV)
$h = preg_replace( '/^\xEF\xBB\xBF/', '', $h );

// Lowercase, and “flatten” Norwegian chars a bit for matching.
if ( function_exists( 'mb_strtolower' ) ) {
$h = mb_strtolower( $h, 'UTF-8' );
} else {
$h = strtolower( $h );
}

$h = str_replace(
array( 'ø', 'å', 'æ', '–', '‑', '—' ),
array( 'o', 'a', 'ae', '-', '-', '-' ),
$h
);

// Remove everything except letters/numbers
$h = preg_replace( '/[^a-z0-9]+/i', '', $h );

return $h;
}
}

/* ---------------------------------
 * Map headers -> internal keys
 * --------------------------------- */
if ( ! function_exists( 'minlpg_bulk_map_headers' ) ) {
function minlpg_bulk_map_headers( array $headers ) {
$map = array();

$known = array(
// station name
'stasjon'      => 'station_name',
'station'      => 'station_name',
'stasjonnavn'  => 'station_name',
'stationname'  => 'station_name',
'navn'         => 'station_name',

// legal/company
'selskap'      => 'legal_name',
'juridisknavn' => 'legal_name',
'legalname'    => 'legal_name',
'company'      => 'legal_name',

// address
'adresse'      => 'address',
'address'      => 'address',

// region
'region'       => 'region',

// org number
'orgnr'               => 'org_number',
'orgnummer'           => 'org_number',
'organisasjonsnummer' => 'org_number',
'orgnumber'           => 'org_number',

// coordinates
'coordinates'  => 'coordinates',
'koordinater'  => 'coordinates',
'coord'        => 'coordinates',
'gps'          => 'coordinates',

// phone
'telefonnummer' => 'phone',
'telefon'       => 'phone',
'phone'         => 'phone',
'mobile'        => 'phone',

// email
'epost'        => 'email',
'email'        => 'email',
'e'            => 'email', // rare CSV exports

// web
'web'          => 'web',
'website'      => 'web',
'nettside'     => 'web',
'url'          => 'web',
);

foreach ( $headers as $idx => $h ) {
$norm = minlpg_bulk_normalize_header( $h );
if ( isset( $known[ $norm ] ) ) {
$map[ $known[ $norm ] ] = (int) $idx;
}
}

return $map;
}
}

/* ---------------------------------
 * CSV helpers
 * --------------------------------- */
if ( ! function_exists( 'minlpg_bulk_detect_csv_delimiter' ) ) {
function minlpg_bulk_detect_csv_delimiter( $first_line ) {
$candidates = array( ';', ',', "\t" );
$best = ',';
$best_count = -1;

foreach ( $candidates as $d ) {
$count = substr_count( (string) $first_line, $d );
if ( $count > $best_count ) {
$best = $d;
$best_count = $count;
}
}

return $best;
}
}

if ( ! function_exists( 'minlpg_bulk_parse_csv' ) ) {
function minlpg_bulk_parse_csv( $path ) {
$rows = array();

$fh = fopen( $path, 'r' );
if ( ! $fh ) {
return array( false, 'Klarte ikke å lese CSV-filen.' );
}

$first = fgets( $fh );
if ( false === $first ) {
fclose( $fh );
return array( false, 'CSV-filen ser tom ut.' );
}

$delimiter = minlpg_bulk_detect_csv_delimiter( $first );
rewind( $fh );

while ( ( $data = fgetcsv( $fh, 0, $delimiter ) ) !== false ) {
$rows[] = array_map(
function ( $v ) {
return is_string( $v ) ? trim( $v ) : $v;
},
$data
);
}

fclose( $fh );

return array( true, $rows );
}
}

/* ---------------------------------
 * Coordinates parser: "59.4177 / 10.6951" -> [lat, lng]
 * --------------------------------- */
if ( ! function_exists( 'minlpg_bulk_parse_coordinates' ) ) {
function minlpg_bulk_parse_coordinates( $value ) {
$value = (string) $value;
$value = trim( $value );

if ( '' === $value ) {
return array( null, null );
}

// Replace comma decimal? (rare, but possible)
$value = str_replace( ',', '.', $value );

preg_match_all( '/-?\d+(?:\.\d+)?/', $value, $m );
$nums = isset( $m[0] ) ? $m[0] : array();

if ( count( $nums ) >= 2 ) {
$lat = (float) $nums[0];
$lng = (float) $nums[1];

// Basic sanity
if ( $lat < -90 || $lat > 90 || $lng < -180 || $lng > 180 ) {
return array( null, null );
}

return array( $lat, $lng );
}

return array( null, null );
}
}

/* ---------------------------------
 * XLSX helpers (minimal reader – no external libs)
 * --------------------------------- */
if ( ! function_exists( 'minlpg_bulk_xlsx_col_to_index' ) ) {
function minlpg_bulk_xlsx_col_to_index( $letters ) {
$letters = strtoupper( (string) $letters );
$len = strlen( $letters );
$n = 0;
for ( $i = 0; $i < $len; $i++ ) {
$c = ord( $letters[ $i ] );
if ( $c < 65 || $c > 90 ) {
continue;
}
$n = $n * 26 + ( $c - 64 );
}
return $n - 1; // zero-based
}
}

if ( ! function_exists( 'minlpg_bulk_parse_xlsx' ) ) {
function minlpg_bulk_parse_xlsx( $path ) {
if ( ! class_exists( 'ZipArchive' ) ) {
return array( false, 'ZipArchive mangler på serveren (trengs for XLSX).' );
}

$zip = new ZipArchive();
if ( true !== $zip->open( $path ) ) {
return array( false, 'Klarte ikke å åpne XLSX-filen.' );
}

// Shared strings
$shared = array();
$shared_xml = $zip->getFromName( 'xl/sharedStrings.xml' );
if ( $shared_xml ) {
$sx = @simplexml_load_string( $shared_xml );
if ( $sx && isset( $sx->si ) ) {
foreach ( $sx->si as $si ) {
$txt = '';
if ( isset( $si->t ) ) {
$txt = (string) $si->t;
} elseif ( isset( $si->r ) ) {
foreach ( $si->r as $r ) {
if ( isset( $r->t ) ) {
$txt .= (string) $r->t;
}
}
}
$shared[] = $txt;
}
}
}

// Find first worksheet
$sheet_name = 'xl/worksheets/sheet1.xml';
if ( false === $zip->locateName( $sheet_name ) ) {
for ( $i = 0; $i < $zip->numFiles; $i++ ) {
$name = $zip->getNameIndex( $i );
if ( preg_match( '#^xl/worksheets/sheet\d+\.xml$#', $name ) ) {
$sheet_name = $name;
break;
}
}
}

$sheet_xml = $zip->getFromName( $sheet_name );
$zip->close();

if ( ! $sheet_xml ) {
return array( false, 'Fant ingen worksheet i XLSX-filen.' );
}

$sx = @simplexml_load_string( $sheet_xml );
if ( ! $sx ) {
return array( false, 'Klarte ikke å lese worksheet-XML (XLSX).' );
}

$rows_out = array();

if ( isset( $sx->sheetData ) && isset( $sx->sheetData->row ) ) {
foreach ( $sx->sheetData->row as $row ) {
$row_vals  = array();

if ( isset( $row->c ) ) {
foreach ( $row->c as $c ) {
$ref = isset( $c['r'] ) ? (string) $c['r'] : '';
if ( ! $ref ) {
continue;
}

preg_match( '/^([A-Z]+)\d+$/i', $ref, $mm );
$col_letters = isset( $mm[1] ) ? $mm[1] : '';
$col_index   = minlpg_bulk_xlsx_col_to_index( $col_letters );

$type = isset( $c['t'] ) ? (string) $c['t'] : '';
$val  = '';

if ( 'inlineStr' === $type && isset( $c->is ) && isset( $c->is->t ) ) {
$val = (string) $c->is->t;
} elseif ( isset( $c->v ) ) {
$raw = (string) $c->v;
if ( 's' === $type ) {
$idx = (int) $raw;
$val = isset( $shared[ $idx ] ) ? (string) $shared[ $idx ] : '';
} else {
$val = $raw;
}
}

$row_vals[ $col_index ] = $val;
}
}

if ( ! empty( $row_vals ) ) {
ksort( $row_vals );
$max_col = max( array_keys( $row_vals ) );
$full = array();
for ( $i = 0; $i <= $max_col; $i++ ) {
$full[] = isset( $row_vals[ $i ] ) ? trim( (string) $row_vals[ $i ] ) : '';
}
$rows_out[] = $full;
}
}
}

if ( empty( $rows_out ) ) {
return array( false, 'XLSX-filen inneholder ingen rader.' );
}

return array( true, $rows_out );
}
}

/* ---------------------------------
 * Convert raw rows -> normalized station rows
 * --------------------------------- */
if ( ! function_exists( 'minlpg_bulk_rows_to_stations' ) ) {
function minlpg_bulk_rows_to_stations( array $rows ) {
$rows = array_values( $rows );

if ( empty( $rows ) || empty( $rows[0] ) ) {
return array( false, 'Filen inneholder ingen data.' );
}

$headers = $rows[0];
$map     = minlpg_bulk_map_headers( $headers );

// Required: station_name
if ( ! isset( $map['station_name'] ) ) {
return array( false, 'Mangler kolonne: Stasjon / Station.' );
}

$stations = array();

for ( $i = 1; $i < count( $rows ); $i++ ) {
$r = $rows[ $i ];
if ( ! is_array( $r ) ) {
continue;
}

$station_name = isset( $map['station_name'] ) && isset( $r[ $map['station_name'] ] )
? trim( (string) $r[ $map['station_name'] ] )
: '';

// Skip empty lines
if ( '' === $station_name ) {
continue;
}

$email  = ( isset( $map['email'] )        && isset( $r[ $map['email'] ] ) )        ? trim( (string) $r[ $map['email'] ] )        : '';
$legal  = ( isset( $map['legal_name'] )   && isset( $r[ $map['legal_name'] ] ) )   ? trim( (string) $r[ $map['legal_name'] ] )   : '';
$addr   = ( isset( $map['address'] )      && isset( $r[ $map['address'] ] ) )      ? trim( (string) $r[ $map['address'] ] )      : '';
$reg    = ( isset( $map['region'] )       && isset( $r[ $map['region'] ] ) )       ? trim( (string) $r[ $map['region'] ] )       : '';
$org    = ( isset( $map['org_number'] )   && isset( $r[ $map['org_number'] ] ) )   ? trim( (string) $r[ $map['org_number'] ] )   : '';
$coords = ( isset( $map['coordinates'] )  && isset( $r[ $map['coordinates'] ] ) )  ? trim( (string) $r[ $map['coordinates'] ] )  : '';
$phone  = ( isset( $map['phone'] )        && isset( $r[ $map['phone'] ] ) )        ? trim( (string) $r[ $map['phone'] ] )        : '';
$web    = ( isset( $map['web'] )          && isset( $r[ $map['web'] ] ) )          ? trim( (string) $r[ $map['web'] ] )          : '';

list( $lat, $lng ) = minlpg_bulk_parse_coordinates( $coords );

$stations[] = array(
'row'          => $i + 1, // 1-based in excel + header
'station_name' => $station_name,
'legal_name'   => $legal,
'org_number'   => $org,
'address'      => $addr,
'region'       => $reg,
'email'        => $email,
'phone'        => $phone,
'web'          => $web,
'coords_raw'   => $coords,
'lat'          => $lat,
'lng'          => $lng,
);
}

if ( empty( $stations ) ) {
return array( false, 'Ingen stasjoner å importere (kun tomme rader?).' );
}

return array( true, $stations );
}
}

/* ---------------------------------
 * Login-email generator
 * --------------------------------- */
if ( ! function_exists( 'minlpg_bulk_generate_login_email' ) ) {
function minlpg_bulk_generate_login_email( $station_name ) {
$host = parse_url( home_url( '/' ), PHP_URL_HOST );
$host = $host ? $host : 'example.local';

$slug = sanitize_title( (string) $station_name );
if ( '' === $slug ) {
$slug = 'station';
}

$suffix = strtolower( wp_generate_password( 6, false, false ) );

$email = $slug . '-' . $suffix . '@' . $host;

return sanitize_email( $email );
}
}

/* ---------------------------------
 * Create or update station owner user
 * --------------------------------- */
if ( ! function_exists( 'minlpg_bulk_upsert_station_owner' ) ) {
function minlpg_bulk_upsert_station_owner( array $row, array $opts ) {

$use_email_as_login = ! empty( $opts['use_email_as_login'] );
$update_existing    = ! empty( $opts['update_existing'] );
$send_email         = ! empty( $opts['send_email'] );

$station_name  = sanitize_text_field( $row['station_name'] );
$contact_email = sanitize_email( $row['email'] );

$login_email = $contact_email;
if ( ! $use_email_as_login ) {
$login_email = minlpg_bulk_generate_login_email( $station_name );
}

// Validate login email
if ( ! $login_email || ! is_email( $login_email ) ) {
return array( 'status' => 'error', 'message' => 'Ugyldig e-post (login).' );
}

$existing_id = email_exists( $login_email );

if ( $existing_id && ! $update_existing ) {
return array( 'status' => 'skip', 'message' => 'E-post finnes allerede (oppdatering deaktivert).' );
}

if ( $existing_id ) {
$u = get_user_by( 'id', $existing_id );
if ( ! ( $u instanceof WP_User ) ) {
return array( 'status' => 'error', 'message' => 'Fant bruker, men klarte ikke å laste den.' );
}

$roles = (array) $u->roles;
if ( ! in_array( 'stasjonseier', $roles, true ) ) {
return array( 'status' => 'error', 'message' => 'E-post finnes, men brukeren er ikke stasjonseier.' );
}

// Update display name
wp_update_user(
array(
'ID'           => $existing_id,
'display_name' => $station_name,
)
);

// Meta
if ( ! empty( $row['legal_name'] ) ) {
update_user_meta( $existing_id, 'minlpg_legal_name', sanitize_text_field( $row['legal_name'] ) );
}
if ( ! empty( $row['org_number'] ) ) {
update_user_meta( $existing_id, 'minlpg_org_number', sanitize_text_field( $row['org_number'] ) );
}
if ( ! empty( $row['address'] ) ) {
update_user_meta( $existing_id, 'minlpg_address', sanitize_text_field( $row['address'] ) );
}
if ( ! empty( $row['region'] ) ) {
update_user_meta( $existing_id, 'minlpg_region', sanitize_text_field( $row['region'] ) );
}
if ( ! empty( $row['phone'] ) ) {
update_user_meta( $existing_id, 'minlpg_station_phone', sanitize_text_field( $row['phone'] ) );
}
if ( ! empty( $row['web'] ) ) {
update_user_meta( $existing_id, 'minlpg_station_web', sanitize_text_field( $row['web'] ) );
}
if ( $contact_email ) {
update_user_meta( $existing_id, 'minlpg_station_contact_email', $contact_email );
}

if ( isset( $row['lat'] ) && null !== $row['lat'] && isset( $row['lng'] ) && null !== $row['lng'] ) {
update_user_meta( $existing_id, 'minlpg_lat', (float) $row['lat'] );
update_user_meta( $existing_id, 'minlpg_lng', (float) $row['lng'] );
}

// Make sure it has a station code
$station_code = function_exists( 'minlpg_get_station_code' )
? minlpg_get_station_code( $existing_id )
: get_user_meta( $existing_id, 'minlpg_station_code', true );

return array(
'status'       => 'updated',
'user_id'      => $existing_id,
'station_code' => $station_code,
'message'      => 'Oppdatert.',
'login_email'  => $login_email,
);
}

// CREATE NEW USER
$user_login = sanitize_user( current( explode( '@', $login_email ) ), true );
if ( ! $user_login ) {
$user_login = 'station_' . strtolower( wp_generate_password( 6, false, false ) );
}
if ( username_exists( $user_login ) ) {
$user_login .= '_' . strtolower( wp_generate_password( 4, false, false ) );
}

$password = wp_generate_password( 18, true, true );

$user_id = wp_insert_user(
array(
'user_login'   => $user_login,
'user_email'   => $login_email,
'user_pass'    => $password,
'display_name' => $station_name,
'role'         => 'stasjonseier',
)
);

if ( is_wp_error( $user_id ) ) {
return array( 'status' => 'error', 'message' => $user_id->get_error_message() );
}

// Meta
if ( ! empty( $row['legal_name'] ) ) {
update_user_meta( $user_id, 'minlpg_legal_name', sanitize_text_field( $row['legal_name'] ) );
}
if ( ! empty( $row['org_number'] ) ) {
update_user_meta( $user_id, 'minlpg_org_number', sanitize_text_field( $row['org_number'] ) );
}
if ( ! empty( $row['address'] ) ) {
update_user_meta( $user_id, 'minlpg_address', sanitize_text_field( $row['address'] ) );
}
if ( ! empty( $row['region'] ) ) {
update_user_meta( $user_id, 'minlpg_region', sanitize_text_field( $row['region'] ) );
}
if ( ! empty( $row['phone'] ) ) {
update_user_meta( $user_id, 'minlpg_station_phone', sanitize_text_field( $row['phone'] ) );
}
if ( ! empty( $row['web'] ) ) {
update_user_meta( $user_id, 'minlpg_station_web', sanitize_text_field( $row['web'] ) );
}
if ( $contact_email ) {
update_user_meta( $user_id, 'minlpg_station_contact_email', $contact_email );
}

if ( isset( $row['lat'] ) && null !== $row['lat'] && isset( $row['lng'] ) && null !== $row['lng'] ) {
update_user_meta( $user_id, 'minlpg_lat', (float) $row['lat'] );
update_user_meta( $user_id, 'minlpg_lng', (float) $row['lng'] );
}

// Default to ACTIVE
update_user_meta( $user_id, 'minlpg_station_status', 'active' );

// Assign station code if system supports it
$station_code = function_exists( 'minlpg_get_station_code' )
? minlpg_get_station_code( $user_id )
: get_user_meta( $user_id, 'minlpg_station_code', true );

// Optional: send welcome email (only makes sense if login email is real)
if ( $send_email && $use_email_as_login && function_exists( 'wp_new_user_notification' ) ) {
wp_new_user_notification( $user_id, null, 'user' );
}

return array(
'status'       => 'created',
'user_id'      => $user_id,
'station_code' => $station_code,
'message'      => 'Opprettet.',
'login_email'  => $login_email,
);
}
}

/* ---------------------------------
 * Shortcode UI (CLEAN LAYOUT)
 * --------------------------------- */
if ( ! function_exists( 'minlpg_station_bulk_register_shortcode' ) ) {
function minlpg_station_bulk_register_shortcode() {

list( $ok, $data ) = minlpg_bulk_require_admin();
if ( ! $ok ) {
return $data;
}

$error  = '';
$notice = '';
$notice_class = 'minlpg-alert--ok';

$results = array();
$preview = array();

// Sticky form values (so checkboxes don't "jump back" after POST)
$sticky_use_email_as_login = true;
$sticky_update_existing    = true;
$sticky_send_email         = false;

if ( 'POST' === $_SERVER['REQUEST_METHOD'] && isset( $_POST['minlpg_bulk_import_nonce'] ) ) {
$sticky_use_email_as_login = ! empty( $_POST['minlpg_use_email_as_login'] );
$sticky_update_existing    = ! empty( $_POST['minlpg_update_existing'] );
$sticky_send_email         = ! empty( $_POST['minlpg_send_email'] );
}

// Handle POST
if ( 'POST' === $_SERVER['REQUEST_METHOD'] && isset( $_POST['minlpg_bulk_import_nonce'] ) ) {
$nonce = sanitize_text_field( wp_unslash( $_POST['minlpg_bulk_import_nonce'] ) );

if ( ! wp_verify_nonce( $nonce, 'minlpg_bulk_import_stations' ) ) {
$error = 'Ugyldig sikkerhetstoken. Prøv igjen.';
} elseif ( empty( $_FILES['minlpg_bulk_file']['name'] ) ) {
$error = 'Du må velge en fil (CSV eller XLSX).';
} else {

$action = isset( $_POST['minlpg_bulk_action'] ) ? sanitize_text_field( wp_unslash( $_POST['minlpg_bulk_action'] ) ) : 'preview';
if ( 'import' !== $action ) {
$action = 'preview';
}

$use_email_as_login = $sticky_use_email_as_login;
$update_existing    = $sticky_update_existing;
$send_email         = $sticky_send_email;

// Upload file to temp
if ( ! function_exists( 'wp_handle_upload' ) ) {
require_once ABSPATH . 'wp-admin/includes/file.php';
}

$uploaded = wp_handle_upload(
$_FILES['minlpg_bulk_file'],
array( 'test_form' => false )
);

if ( isset( $uploaded['error'] ) ) {
$error = 'Opplasting feilet: ' . esc_html( $uploaded['error'] );
} else {
$file_path = $uploaded['file'];
$ext = strtolower( pathinfo( $file_path, PATHINFO_EXTENSION ) );

if ( 'csv' === $ext ) {
list( $ok2, $rows_or_err ) = minlpg_bulk_parse_csv( $file_path );
} elseif ( 'xlsx' === $ext ) {
list( $ok2, $rows_or_err ) = minlpg_bulk_parse_xlsx( $file_path );
} else {
$ok2 = false;
$rows_or_err = 'Ugyldig filtype. Bruk CSV eller XLSX.';
}

// Clean up upload
if ( is_file( $file_path ) ) {
@unlink( $file_path );
}

if ( ! $ok2 ) {
$error = (string) $rows_or_err;
} else {
list( $ok3, $stations_or_err ) = minlpg_bulk_rows_to_stations( $rows_or_err );

if ( ! $ok3 ) {
$error = (string) $stations_or_err;
} else {

$stations = $stations_or_err;

// Detect duplicates in file (only matters when we use email as login)
$seen = array();
$dupes = array(); // email => true
if ( $use_email_as_login ) {
foreach ( $stations as $s ) {
$k = strtolower( trim( (string) $s['email'] ) );
if ( '' === $k ) {
continue;
}
if ( isset( $seen[ $k ] ) ) {
$dupes[ $k ] = true;
} else {
$seen[ $k ] = true;
}
}
}

// Build PREVIEW rows (always)
foreach ( $stations as $s ) {
$login_email = $use_email_as_login
? sanitize_email( $s['email'] )
: minlpg_bulk_generate_login_email( $s['station_name'] );

$row_action = 'CREATE';
$row_msg    = '';

if ( $use_email_as_login ) {
$raw = strtolower( trim( (string) $s['email'] ) );
if ( '' === $raw ) {
$row_action = 'ERROR';
$row_msg    = 'Mangler e-post i raden (påkrevd når "bruk e-post som login" er aktiv).';
} elseif ( isset( $dupes[ $raw ] ) ) {
$row_action = 'ERROR';
$row_msg    = 'Duplikat e-post i filen (må være unik per stasjon).';
}
}

if ( 'ERROR' !== $row_action ) {
if ( ! $login_email || ! is_email( $login_email ) ) {
$row_action = 'ERROR';
$row_msg    = 'Ugyldig e-post (login).';
} else {
$existing_id = email_exists( $login_email );
if ( $existing_id ) {
$row_action = $update_existing ? 'UPDATE' : 'SKIP';
$row_msg    = $update_existing ? 'Vil oppdatere eksisterende.' : 'Vil hoppe over (oppdatering av).';
}
}
}

$preview[] = array(
'row'    => $s['row'],
'name'   => $s['station_name'],
'email'  => $login_email,
'action' => $row_action,
'msg'    => $row_msg,
);
}

// If user requested IMPORT, run it – but refuse if duplicates exist under email-as-login
if ( 'import' === $action ) {

if ( $use_email_as_login && ! empty( $dupes ) ) {
$error = 'Import stoppet: Filen inneholder dupliserte e-poster. ' .
'Enten må du rette filen, eller slå av "Bruk e-post som login".';
} else {

$opts = array(
'use_email_as_login' => $use_email_as_login,
'update_existing'    => $update_existing,
'send_email'         => $send_email,
);

foreach ( $stations as $s ) {
$res = minlpg_bulk_upsert_station_owner( $s, $opts );

$results[] = array(
'row'    => $s['row'],
'name'   => $s['station_name'],
'email'  => isset( $res['login_email'] ) ? $res['login_email'] : '',
'code'   => isset( $res['station_code'] ) ? $res['station_code'] : '',
'status' => isset( $res['status'] ) ? strtoupper( (string) $res['status'] ) : 'UNKNOWN',
'msg'    => isset( $res['message'] ) ? (string) $res['message'] : '',
);
}

// Summary notice
$counts = array(
'CREATED' => 0,
'UPDATED' => 0,
'SKIP'    => 0,
'ERROR'   => 0,
);
foreach ( $results as $r ) {
$st = strtoupper( (string) $r['status'] );
if ( isset( $counts[ $st ] ) ) {
$counts[ $st ]++;
}
}

$notice = sprintf(
'Import fullført: %d opprettet, %d oppdatert, %d hoppet over, %d feil.',
(int) $counts['CREATED'],
(int) $counts['UPDATED'],
(int) $counts['SKIP'],
(int) $counts['ERROR']
);
$notice_class = ( $counts['ERROR'] > 0 ) ? 'minlpg-alert--error' : 'minlpg-alert--ok';
}
}
}
}
}
}
}

ob_start(); ?>

