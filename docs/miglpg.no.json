$type = get_user_meta( $user_id, 'minlpg_user_type', true );

switch ( $type ) {
case 'priv_butikk':
return 'Privatkunde – butikk & dispenser';
case 'priv_levering':
return 'Privatkunde – levering av flasker';
case 'bedrift_levering':
return 'Bedrift – flasker / CO₂ levering';
case 'bedrift_dispenser':
return 'Bedrift – dispenserfylling';
default:
return 'Ukjent type';
}
}

