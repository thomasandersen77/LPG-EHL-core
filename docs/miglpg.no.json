}

/**
 * Helper to build a secure download URL for en kvittering / rapport.
 *
 * Når API-et gir deg en kvitterings‑URL eller et rapport‑URL,
 * kan du bare sende den inn her.
 *
 * NYTT:
 *  - valgfri $station_id gjør at vi kan lage en PDF-template med header for stasjonen.
 *  - valgfri $period (tekst) gjør at PDF-templaten kan vise "Valgt periode" i headeren.
 */

/**
 * Bygg en sikker nedlastingslenke til kvittering/rapport.
 *
 * Viktig:
 *  - Remote URL sendes ikke lenger via GET-param (src).
 *  - URL lagres serverside i en transient og refereres via "key".
 *  - Download-endpointen validerer host (allowlist) + https.
 */
function minlpg_get_receipt_download_url( $remote_pdf_url, $receipt_id = 'kvittering', $station_id = 0, $period = '' ) {

$query_args = array(
'action'    => 'minlpg_download_receipt',
'_wpnonce'  => wp_create_nonce( 'minlpg_download_receipt' ),
'receipt_id'=> sanitize_key( (string) $receipt_id ),
);

if ( $station_id ) {
$query_args['station_id'] = (int) $station_id;
}

if ( is_string( $period ) && '' !== $period ) {
$query_args['period'] = $period;
}

if ( is_string( $remote_pdf_url ) && '' !== trim( $remote_pdf_url ) ) {
$key = minlpg_receipt_register_remote_url( $remote_pdf_url );
if ( $key ) {
$query_args['key'] = $key;
}
}

return add_query_arg( $query_args, admin_url( 'admin-ajax.php' ) );
}

/**
 * Helper: escape tekst for PDF content stream.
 * Nå med støtte for norske tegn (ÅÆØåæø) via Windows-1252 / WinAnsiEncoding.
 */
if ( ! function_exists( 'minlpg_pdf_escape_text' ) ) {
function minlpg_pdf_escape_text( $text ) {
$text = (string) $text;

// Konverter fra UTF-8 til Windows-1252 (samme som WinAnsiEncoding i PDF).
// //IGNORE = behold tegn som finnes i 1252 (inkl. norske bokstaver),
// dropp kun de som ikke støttes.
if ( function_exists( 'iconv' ) ) {
$converted = @iconv( 'UTF-8', 'Windows-1252//IGNORE', $text );
if ( false !== $converted ) {
$text = $converted;
}
} elseif ( function_exists( 'utf8_decode' ) ) {
// Fallback – ISO-8859-1 ligger tett nok på for våre vestlige tegn.
$text = utf8_decode( $text );
}

// Escape spesialtegn i PDF-strenger
$text = str_replace(
array( '\\', '(', ')' ),
array( '\\\\', '\\(', '\\)' ),
$text
);

// Fjern rare kontrolltegn
$text = preg_replace( '/[^\x09\x0A\x0D\x20-\x7E\x80-\xFF]/', '', $text );

return $text;
}
}


/**
 * Bygg en veldig enkel PDF med kun header (tittel + linjer).
 * Body kan fylles inn senere når API kobles til.
 * Bruker /Helvetica med /WinAnsiEncoding slik at ÅÆØåæø vises riktig.
 */
if ( ! function_exists( 'minlpg_build_simple_pdf' ) ) {
function minlpg_build_simple_pdf( $title, $lines = array() ) {
$title = minlpg_pdf_escape_text( $title );
$lines = array_map( 'minlpg_pdf_escape_text', $lines );

$stream_parts   = array();

// Tittel
$stream_parts[] = 'BT';
$stream_parts[] = '/F1 18 Tf';
$stream_parts[] = '50 800 Td';
$stream_parts[] = '(' . $title . ') Tj';
$stream_parts[] = 'ET';

// Header-linjer
$y = 770;
foreach ( $lines as $line ) {
$stream_parts[] = 'BT';
$stream_parts[] = '/F1 11 Tf';
$stream_parts[] = '50 ' . $y . ' Td';
$stream_parts[] = '(' . $line . ') Tj';
$stream_parts[] = 'ET';
$y -= 16;
}

$stream = implode( "\n", $stream_parts ) . "\n";
$len    = strlen( $stream );

// Minimal PDF-struktur
$pdf     = "%PDF-1.4\n";
$offsets = array();

// 1: Catalog
$offsets[1] = strlen( $pdf );
$pdf       .= "1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n";

// 2: Pages
$offsets[2] = strlen( $pdf );
$pdf       .= "2 0 obj\n<< /Type /Pages /Count 1 /Kids [3 0 R] >>\nendobj\n";

// 5: Font – viktig del: /Encoding /WinAnsiEncoding
$offsets[5] = strlen( $pdf );
$pdf       .= "5 0 obj\n"
. "<< /Type /Font /Subtype /Type1 "
. "/BaseFont /Helvetica "
. "/Encoding /WinAnsiEncoding >>\n"
. "endobj\n";

// 4: Content stream
$offsets[4] = strlen( $pdf );
$pdf       .= "4 0 obj\n<< /Length $len >>\nstream\n$stream\nendstream\nendobj\n";

// 3: Page
$offsets[3] = strlen( $pdf );
$pdf       .= "3 0 obj\n"
. "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] "
. "/Contents 4 0 R "
. "/Resources << /Font << /F1 5 0 R >> >> >>\n"
. "endobj\n";

// xref
$xref_offset = strlen( $pdf );
$pdf        .= "xref\n0 6\n";
$pdf        .= "0000000000 65535 f \n";
for ( $i = 1; $i <= 5; $i++ ) {
$off = isset( $offsets[ $i ] ) ? $offsets[ $i ] : 0;
$pdf .= sprintf( "%010d 00000 n \n", $off );
}

$pdf .= "trailer\n<< /Size 6 /Root 1 0 R >>\n";
$pdf .= "startxref\n" . $xref_offset . "\n%%EOF";

return $pdf;
}
}


/**
 * AJAX handler that proxies a remote PDF and forces download
 *
 * Nå også: hvis station_id er satt, lager vi en tom PDF-template
 * med korrekt stasjons-header.
 */

/**
 * AJAX handler som returnerer PDF som download.
 *
 * Sikkerhet:
 *  - Remote URL kommer ikke direkte fra brukerinput (src er legacy og strengt sjekket).
 *  - Ny standard: "key" -> transient lookup -> allowlist host + https + size limit.
 *  - Streaming til temp-fil for å unngå memory-bombs.
 *
 * Nå også: hvis station_id er satt, lager vi en enkel PDF-template med korrekt header for stasjonen.
 */
function minlpg_ajax_download_receipt() {

if ( ! is_user_logged_in() ) {
wp_die( __( 'Du må være innlogget for å laste ned kvitteringen.', 'minlpg' ) );
}

if ( ! check_ajax_referer( 'minlpg_download_receipt', '_wpnonce', false ) ) {
wp_die( __( 'Ugyldig forespørsel.', 'minlpg' ) );
}

$receipt_id = isset( $_GET['receipt_id'] ) ? sanitize_key( wp_unslash( $_GET['receipt_id'] ) ) : 'kvittering';
$station_id = isset( $_GET['station_id'] ) ? (int) $_GET['station_id'] : 0;
$period     = isset( $_GET['period'] ) ? sanitize_text_field( wp_unslash( $_GET['period'] ) ) : '';

// 1) Server-generert PDF-template (ingen remote fetch)
if ( $station_id ) {
$pdf = '';
if ( function_exists( 'minlpg_generate_simple_receipt_pdf' ) ) {
$pdf = minlpg_generate_simple_receipt_pdf( $station_id, $receipt_id, $period );
}

if ( ! $pdf ) {
wp_die( __( 'Kunne ikke generere kvitterings-PDF.', 'minlpg' ) );
}

$filename = sanitize_file_name( $receipt_id ) . '.pdf';

nocache_headers();
header( 'Content-Type: application/pdf' );
header( 'Content-Disposition: attachment; filename="' . $filename . '"' );
header( 'X-Content-Type-Options: nosniff' );

echo $pdf; // phpcs:ignore WordPress.Security.EscapeOutput.OutputNotEscaped
exit;
}

// 2) Remote PDF via "key" (anbefalt)
$key = isset( $_GET['key'] ) ? sanitize_text_field( wp_unslash( $_GET['key'] ) ) : '';
$remote_url = '';

if ( $key ) {
$remote_url = minlpg_receipt_lookup_remote_url( $key );
}

// 3) Legacy fallback: src=base64(url) – beholdes kun for bakoverkompat, men låses ned.
if ( ! $remote_url && isset( $_GET['src'] ) ) {
$encoded = wp_unslash( $_GET['src'] );
$decoded = base64_decode( rawurldecode( (string) $encoded ), true );
$remote_url = is_string( $decoded ) ? $decoded : '';
}

if ( ! $remote_url ) {
wp_die( __( 'Kvitteringsfil er ikke konfigurert enda.', 'minlpg' ) );
}

if ( ! minlpg_validate_receipt_remote_url( $remote_url ) ) {
wp_die( __( 'Ugyldig eller ikke-tillatt kvitteringskilde.', 'minlpg' ) );
}

$tmp = function_exists( 'wp_tempnam' ) ? wp_tempnam( 'minlpg-receipt' ) : '';
if ( ! $tmp ) {
wp_die( __( 'Kunne ikke forberede nedlasting.', 'minlpg' ) );
}

$args = array(
'timeout'             => 20,
'redirection'         => 3,
'reject_unsafe_urls'  => true,
'stream'              => true,
'filename'            => $tmp,
'limit_response_size' => 15 * 1024 * 1024, // 15MB
);

$response = wp_remote_get( $remote_url, $args );

if ( is_wp_error( $response ) ) {
@unlink( $tmp );
wp_die( __( 'Kunne ikke hente kvitteringen.', 'minlpg' ) );
}

$code = (int) wp_remote_retrieve_response_code( $response );
if ( $code < 200 || $code >= 300 ) {
@unlink( $tmp );
wp_die( sprintf( __( 'Kunne ikke hente kvitteringen (HTTP %d).', 'minlpg' ), $code ) );
}

// Send som PDF uansett content-type (mange API-er sender octet-stream)
$filename = sanitize_file_name( $receipt_id ) . '.pdf';

nocache_headers();
header( 'Content-Type: application/pdf' );
header( 'Content-Disposition: attachment; filename="' . $filename . '"' );
header( 'X-Content-Type-Options: nosniff' );

if ( file_exists( $tmp ) ) {
$size = filesize( $tmp );
if ( false !== $size ) {
header( 'Content-Length: ' . (int) $size );
}
// phpcs:ignore WordPress.WP.AlternativeFunctions.file_system_read_readfile
readfile( $tmp );
@unlink( $tmp );
exit;
}

// fallback
wp_die( __( 'Kunne ikke lese nedlastet fil.', 'minlpg' ) );
}
add_action( 'wp_ajax_minlpg_download_receipt', 'minlpg_ajax_download_receipt' );

/**
 * Helper: hent / oppdater dispenser-priser per stasjon.
 *
 * Lagres i user_meta på stasjonseier:
 *  meta-key: minlpg_dispenser_prices
 *  value: array(
 *      'main' => array( 'med' => 18.9, 'uten' => 14.5 ),
 *      'pump2' => ...
 *  )
 */
if ( ! function_exists( 'minlpg_get_dispenser_prices' ) ) {
function minlpg_get_dispenser_prices( $station_id, $dispenser_id = 'main', $defaults = array() ) {
$station_id   = (int) $station_id;
$dispenser_id = sanitize_title( $dispenser_id );

$defaults = wp_parse_args(
$defaults,
array(
'med'  => '18.90',
'uten' => '14.50',
)
);

if ( ! $station_id || ! $dispenser_id ) {
return $defaults;
}

$all = get_user_meta( $station_id, 'minlpg_dispenser_prices', true );
if ( ! is_array( $all ) || ! isset( $all[ $dispenser_id ] ) || ! is_array( $all[ $dispenser_id ] ) ) {
return $defaults;
}

$prices = wp_parse_args( $all[ $dispenser_id ], $defaults );

// Normaliser til "18.90" / "14.50" (punkt som desimal)
foreach ( $prices as $key => $val ) {
$num            = (float) str_replace( ',', '.', (string) $val );
$prices[ $key ] = number_format( $num, 2, '.', '' );
}

return $prices;
}
}

if ( ! function_exists( 'minlpg_update_dispenser_prices' ) ) {
function minlpg_update_dispenser_prices( $station_id, $dispenser_id, $price_med, $price_uten ) {
$station_id   = (int) $station_id;
$dispenser_id = sanitize_title( $dispenser_id );

if ( ! $station_id || ! $dispenser_id ) {
return false;
}

$all = get_user_meta( $station_id, 'minlpg_dispenser_prices', true );
if ( ! is_array( $all ) ) {
$all = array();
}

$all[ $dispenser_id ] = array(
'med'  => (float) str_replace( ',', '.', (string) $price_med ),
'uten' => (float) str_replace( ',', '.', (string) $price_uten ),
);

return (bool) update_user_meta( $station_id, 'minlpg_dispenser_prices', $all );
}
}

/**
 * AJAX: lagre nye priser fra "Endre pris"-modalen (stasjonseier)
 */

/**
 * AJAX: lagre nye priser fra "Endre pris"-modalen (stasjonseier)
 *
 * Sikkerhet:
 *  - stasjonseier kan kun endre egne priser (station_id blir alltid current user)
 *  - lpg_admin/administrator kan endre for alle stasjoner
 *  - endringer logges i audit-logg
 */
function minlpg_ajax_save_price() {

if ( ! is_user_logged_in() ) {
wp_send_json_error( 'Du må være innlogget for å endre pris.', 401 );
}

$current_user = wp_get_current_user();
$roles        = (array) $current_user->roles;

$is_adminish = minlpg_is_adminish( $current_user );
$is_station  = in_array( 'stasjonseier', $roles, true );

if ( ! $is_adminish && ! $is_station ) {
wp_send_json_error( 'Du har ikke rettigheter til å endre pris.', 403 );
}

// Nonce
$nonce = isset( $_POST['nonce'] ) ? sanitize_text_field( wp_unslash( $_POST['nonce'] ) ) : '';
if ( ! wp_verify_nonce( $nonce, 'minlpg_save_price' ) ) {
wp_send_json_error( 'Ugyldig forespørsel.', 403 );
}

// station_id: stasjonseier kan ikke velge fritt.
$posted_station_id = isset( $_POST['station_id'] ) ? (int) $_POST['station_id'] : 0;
$station_id        = $is_adminish ? $posted_station_id : (int) $current_user->ID;

if ( ! $station_id ) {
wp_send_json_error( 'Mangler stasjon.', 400 );
}

// Sjekk at station_id faktisk er en stasjonseier-konto
$station_user = get_user_by( 'id', $station_id );
if ( ! ( $station_user instanceof WP_User ) || ! in_array( 'stasjonseier', (array) $station_user->roles, true ) ) {
wp_send_json_error( 'Ugyldig stasjon.', 400 );
}

// Pro-level: cap gate (rolle-sjekk er ikke nok i lengden)
// NB: vi lar stasjonseier-rollen være fallback for å unngå "første request"-problemer hvis cap-cachen ikke er oppdatert enda.
if ( ! $is_adminish && ! current_user_can( 'minlpg_manage_station_pricing' ) && ! $is_station ) {
wp_send_json_error( 'Du har ikke tilgang til prisendring.', 403 );
}

$dispenser_id_raw = isset( $_POST['dispenser_id'] ) ? wp_unslash( $_POST['dispenser_id'] ) : 'main';
$dispenser_id     = sanitize_title( (string) $dispenser_id_raw );

// Prisfelter kan være "12,34"
$price_med_raw  = isset( $_POST['price_med'] ) ? wp_unslash( $_POST['price_med'] ) : '';
$price_uten_raw = isset( $_POST['price_uten'] ) ? wp_unslash( $_POST['price_uten'] ) : '';

$price_med  = (float) str_replace( ',', '.', (string) $price_med_raw );
$price_uten = (float) str_replace( ',', '.', (string) $price_uten_raw );

if ( $price_med < 0 || $price_uten < 0 ) {
wp_send_json_error( 'Pris kan ikke være negativ.', 400 );
}

// Hent gamle priser (for audit)
$old_prices = array( 'med' => '', 'uten' => '' );
if ( function_exists( 'minlpg_get_dispenser_prices' ) ) {
$old_prices = minlpg_get_dispenser_prices( $station_id, $dispenser_id, $old_prices );
}

$ok = minlpg_update_dispenser_prices( $station_id, $dispenser_id, $price_med, $price_uten );

if ( ! $ok ) {
wp_send_json_error( 'Kunne ikke lagre pris.', 500 );
}

$new_prices = array(
'med'  => number_format( $price_med, 2, '.', '' ),
'uten' => number_format( $price_uten, 2, '.', '' ),
);

// Audit-logg
if ( function_exists( 'minlpg_audit_log_event' ) ) {
minlpg_audit_log_event(
'price_change',
array(
'station_id'   => $station_id,
'dispenser_id' => $dispenser_id,
'old'          => $old_prices,
'new'          => $new_prices,
)
);
}

wp_send_json_success(
array(
'station_id'   => $station_id,
'dispenser_id' => $dispenser_id,
'price_med'    => $new_prices['med'],
'price_uten'   => $new_prices['uten'],
)
);
}
add_action( 'wp_ajax_minlpg_save_price', 'minlpg_ajax_save_price' );

/**
 * AJAX: set station status (ACTIVE/INACTIVE) – admin only
 * action: minlpg_set_station_status
 */
if ( ! function_exists( 'minlpg_ajax_set_station_status' ) ) {
function minlpg_ajax_set_station_status() {

if ( ! is_user_logged_in() ) {
wp_send_json_error( array( 'message' => 'Ikke innlogget.' ), 401 );
}

// Nonce
$nonce = isset( $_POST['nonce'] ) ? sanitize_text_field( wp_unslash( $_POST['nonce'] ) ) : '';
if ( ! wp_verify_nonce( $nonce, 'minlpg_station_status' ) ) {
wp_send_json_error( array( 'message' => 'Ugyldig sikkerhetstoken.' ), 403 );
}

// Role gate
$user  = wp_get_current_user();
$roles = $user ? (array) $user->roles : array();
if ( ! ( in_array( 'administrator', $roles, true ) || in_array( 'lpg_admin', $roles, true ) ) ) {
wp_send_json_error( array( 'message' => 'Du har ikke tilgang.' ), 403 );
}

$station_id = isset( $_POST['station_id'] ) ? (int) $_POST['station_id'] : 0;
$status     = isset( $_POST['status'] ) ? sanitize_text_field( wp_unslash( $_POST['status'] ) ) : '';

if ( ! $station_id ) {
wp_send_json_error( array( 'message' => 'Mangler station_id.' ), 400 );
}

$station_user = get_user_by( 'id', $station_id );
if ( ! ( $station_user instanceof WP_User ) ) {
wp_send_json_error( array( 'message' => 'Ugyldig stasjon.' ), 404 );
}

$station_roles = (array) $station_user->roles;
if ( ! in_array( 'stasjonseier', $station_roles, true ) ) {
wp_send_json_error( array( 'message' => 'Brukeren er ikke en stasjonseier.' ), 400 );
}

if ( function_exists( 'minlpg_set_station_status' ) ) {
minlpg_set_station_status( $station_id, $status );
} else {
$status = strtolower( trim( (string) $status ) );
$status = ( 'inactive' === $status ) ? 'inactive' : 'active';
update_user_meta( $station_id, 'minlpg_station_status', $status );
}

$new_status = function_exists( 'minlpg_get_station_status' )
? minlpg_get_station_status( $station_id )
: ( ( 'inactive' === strtolower( $status ) ) ? 'inactive' : 'active' );

$label      = ( 'inactive' === $new_status ) ? 'INACTIVE' : 'ACTIVE';
$pill_class = ( 'inactive' === $new_status ) ? 'minlpg-status-off' : 'minlpg-status-ok';

wp_send_json_success(
array(
'station_id'  => $station_id,
'status'      => $new_status,
'label'       => $label,
'pill_class'  => $pill_class,
)
);
}
}
add_action( 'wp_ajax_minlpg_set_station_status', 'minlpg_ajax_set_station_status' );

/**
 * AJAX: trekk kreditt for Bedrift – dispenserfylling
 * action: minlpg_credit_charge
 *
 * Forventet POST:
 *  - nonce  (wp_create_nonce('minlpg_credit_charge'))
 *  - amount (NOK)  f.eks "234.36" eller "234,36"
 *  - tx_id  (valgfri) unik id for fyllingen (idempotens)
 *
 * Oppdaterer:
 *  - user_meta: minlpg_credit_balance
 *  - user_meta: minlpg_credit_charged_tx_ids (array, valgfri)
 */

/**
 * =========================
 * CREDIT (KREDITT)
 *
 * Viktig sikkerhetsendring:
 *  - Portal (browser) kan ikke lenger trekke kreditt basert på beløp fra klienten.
 *  - Portal-endpointen fungerer nå som "SYNC" for bedrift_dispenser (returnerer saldo/limit).
 *  - Reelt trekk må komme fra en betrodd server-til-server hendelse (REST: /minlpg/v1/credit/settle)
 * =========================
 */

if ( ! function_exists( 'minlpg_credit_get_payload' ) ) {
function minlpg_credit_get_payload( $user_id ) {
$user_id = (int) $user_id;

$balance_raw = get_user_meta( $user_id, 'minlpg_credit_balance', true );
$limit_raw   = get_user_meta( $user_id, 'minlpg_credit_limit', true );

$balance_num = (float) str_replace( ',', '.', (string) $balance_raw );
$limit_num   = (float) str_replace( ',', '.', (string) $limit_raw );

return array(
'balance'           => $balance_num,
'balance_formatted' => number_format( $balance_num, 2, ',', ' ' ),
'limit'             => $limit_num,
'limit_formatted'   => number_format( $limit_num, 0, ',', ' ' ),
);
}
}

if ( ! function_exists( 'minlpg_credit_get_shared_secret' ) ) {
function minlpg_credit_get_shared_secret() {
if ( defined( 'MINLPG_DEVICE_SHARED_SECRET' ) && MINLPG_DEVICE_SHARED_SECRET ) {
return (string) MINLPG_DEVICE_SHARED_SECRET;
}
$opt = get_option( 'minlpg_device_shared_secret', '' );
return is_string( $opt ) ? $opt : '';
}
}

if ( ! function_exists( 'minlpg_credit_verify_device_signature' ) ) {
/**
     * Signatur-skjema (HMAC-SHA256):
     *   sig = HMAC( secret, ts|user_id|tx_id|amount|station_id|dispenser_id )
     *
     * Der:
     *  - ts er unix timestamp (sekunder)
     *  - amount er formatert med punktum og 2 desimaler (number_format(...,2,'.',''))
     */
function minlpg_credit_verify_device_signature( array $params ) {
$secret = minlpg_credit_get_shared_secret();
if ( '' === $secret ) {
return false;
}

$ts          = isset( $params['ts'] ) ? (int) $params['ts'] : 0;
$sig         = isset( $params['sig'] ) ? (string) $params['sig'] : '';
$user_id     = isset( $params['user_id'] ) ? (int) $params['user_id'] : 0;
$tx_id       = isset( $params['tx_id'] ) ? (string) $params['tx_id'] : '';
$amount_num  = isset( $params['amount'] ) ? (float) $params['amount'] : 0.0;
$station_id  = isset( $params['station_id'] ) ? (int) $params['station_id'] : 0;
$dispenser_id= isset( $params['dispenser_id'] ) ? (string) $params['dispenser_id'] : '';

if ( $ts <= 0 || ! $sig || $user_id <= 0 || ! $tx_id || $amount_num <= 0 ) {
return false;
}

// Replay-vindu: 5 minutter
$now = time();
if ( abs( $now - $ts ) > 300 ) {
return false;
}

$amount_str = number_format( $amount_num, 2, '.', '' );

$base = $ts . '|' . $user_id . '|' . $tx_id . '|' . $amount_str . '|' . $station_id . '|' . $dispenser_id;
$calc = hash_hmac( 'sha256', $base, $secret );

return hash_equals( $calc, $sig );
}
}

if ( ! function_exists( 'minlpg_credit_apply_charge_internal' ) ) {
/**
     * Trekker kreditt med idempotens på tx_id. Må kalles fra betrodd kilde (REST / admin).
     *
     * @return array [success(bool), payload(array), http_code(int)]
     */
function minlpg_credit_apply_charge_internal( $user_id, $amount_num, $tx_id, array $ctx = array() ) {
global $wpdb;

$user_id    = (int) $user_id;
$amount_num = (float) $amount_num;
$tx_id      = sanitize_text_field( (string) $tx_id );

if ( $user_id <= 0 ) {
return array( false, array( 'message' => 'Mangler bruker.' ), 400 );
}
if ( $amount_num <= 0 ) {
return array( false, array( 'message' => 'Beløp må være større enn 0.' ), 400 );
}
if ( '' === $tx_id ) {
// Tx-id er sterkt anbefalt for idempotens; vi kan generere, men da mister vi idempotens på klient.
$tx_id = 'tx_' . wp_generate_uuid4();
}

$is_adminish = ! empty( $ctx['is_adminish'] );

// Kredittstatus
$status = get_user_meta( $user_id, 'minlpg_credit_status', true );
if ( ! $is_adminish && $status && 'approved' !== $status ) {
return array( false, array( 'message' => 'Kreditt er ikke godkjent enda.' ), 403 );
}

$lock_name = 'minlpg_credit_' . $user_id;
$has_lock  = false;

try {
$got = (int) $wpdb->get_var( $wpdb->prepare( 'SELECT GET_LOCK(%s, 3)', $lock_name ) );
$has_lock = ( 1 === $got );

if ( ! $has_lock ) {
return array( false, array( 'message' => 'Systemet er opptatt. Prøv igjen.' ), 429 );
}

$charged = get_user_meta( $user_id, 'minlpg_credit_charged_tx_ids', true );
if ( ! is_array( $charged ) ) {
$charged = array();
}

if ( in_array( $tx_id, $charged, true ) ) {
$payload = minlpg_credit_get_payload( $user_id );
$payload['already_charged'] = true;
$payload['tx_id'] = $tx_id;
return array( true, $payload, 200 );
}

$balance_raw = get_user_meta( $user_id, 'minlpg_credit_balance', true );
$limit_raw   = get_user_meta( $user_id, 'minlpg_credit_limit', true );

$balance_num = (float) str_replace( ',', '.', (string) $balance_raw );
$limit_num   = (float) str_replace( ',', '.', (string) $limit_raw );

$new_balance = $balance_num - $amount_num;

if ( ! $is_adminish && $new_balance < -0.0001 ) {
return array( false, array( 'message' => 'Ikke nok kreditt tilgjengelig.' ), 400 );
}

// Update saldo
update_user_meta( $user_id, 'minlpg_credit_balance', $new_balance );

// Idempotens-liste: hold den i sjakk (maks 500)
$charged[] = $tx_id;
if ( count( $charged ) > 500 ) {
$charged = array_slice( $charged, -500 );
}
update_user_meta( $user_id, 'minlpg_credit_charged_tx_ids', $charged );

$payload = array(
'balance'           => $new_balance,
'balance_formatted' => number_format( $new_balance, 2, ',', ' ' ),
'limit'             => $limit_num,
'limit_formatted'   => number_format( $limit_num, 0, ',', ' ' ),
'charged_amount'    => $amount_num,
'tx_id'             => $tx_id,
);

// Audit-logg
if ( function_exists( 'minlpg_audit_log_event' ) ) {
$station_id   = isset( $ctx['station_id'] ) ? (int) $ctx['station_id'] : null;
$dispenser_id = isset( $ctx['dispenser_id'] ) ? (string) $ctx['dispenser_id'] : null;

minlpg_audit_log_event(
'credit_charge',
array(
'station_id'      => $station_id,
'dispenser_id'    => $dispenser_id,
'target_user_id'  => $user_id,
'old'             => array( 'balance' => $balance_num ),
'new'             => array( 'balance' => $new_balance ),
'tx_id'           => $tx_id,
'amount'          => $amount_num,
'source'          => isset( $ctx['source'] ) ? (string) $ctx['source'] : 'unknown',
)
);
}

return array( true, $payload, 200 );

} finally {
if ( $has_lock ) {
$wpdb->get_var( $wpdb->prepare( 'SELECT RELEASE_LOCK(%s)', $lock_name ) );
}
}
}
}

/**
 * AJAX: legacy endpoint – nå kun SYNC for bedrift_dispenser (browser kan ikke trekke).
 * Admin kan fortsatt gjøre manuelle trekk for testing/admin (valgfritt user_id).
 */
if ( ! function_exists( 'minlpg_ajax_credit_charge' ) ) {
function minlpg_ajax_credit_charge() {

if ( ! is_user_logged_in() ) {
wp_send_json_error( array( 'message' => 'Ikke innlogget.' ), 401 );
}

// Nonce
$nonce = isset( $_POST['nonce'] ) ? sanitize_text_field( wp_unslash( $_POST['nonce'] ) ) : '';
if ( ! wp_verify_nonce( $nonce, 'minlpg_credit_charge' ) ) {
wp_send_json_error( array( 'message' => 'Ugyldig forespørsel.' ), 403 );
}

$current_user = wp_get_current_user();
$roles        = (array) $current_user->roles;

$is_adminish  = minlpg_is_adminish( $current_user );

$current_user_id = (int) $current_user->ID;
$user_type       = (string) get_user_meta( $current_user_id, 'minlpg_user_type', true );

// Bedrift-dispenser: portal får kun SYNC (ikke trekk)
if ( ! $is_adminish && 'bedrift_dispenser' === $user_type ) {
$payload = minlpg_credit_get_payload( $current_user_id );
$payload['sync_only'] = true;
wp_send_json_success( $payload );
}

// Admin: kan (valgfritt) trekke fra angitt user_id (ellers seg selv)
if ( $is_adminish ) {
$user_id = isset( $_POST['user_id'] ) ? (int) $_POST['user_id'] : $current_user_id;

$amount_raw = isset( $_POST['amount'] ) ? wp_unslash( $_POST['amount'] ) : '';
$amount_num = (float) str_replace( ',', '.', (string) $amount_raw );

$tx_id = isset( $_POST['tx_id'] ) ? sanitize_text_field( wp_unslash( $_POST['tx_id'] ) ) : '';

$station_id   = isset( $_POST['station_id'] ) ? (int) $_POST['station_id'] : 0;
$dispenser_id = isset( $_POST['dispenser_id'] ) ? sanitize_text_field( wp_unslash( $_POST['dispenser_id'] ) ) : '';

list( $ok, $payload, $http ) = minlpg_credit_apply_charge_internal(
$user_id,
$amount_num,
$tx_id,
array(
'is_adminish'  => true,
'station_id'   => $station_id,
'dispenser_id' => $dispenser_id,
'source'       => 'portal_admin',
)
);

if ( $ok ) {
wp_send_json_success( $payload );
}

wp_send_json_error( $payload, $http );
}

// Andre roller skal ikke bruke dette endpointet
wp_send_json_error( array( 'message' => 'Ikke tillatt.' ), 403 );
}
}
add_action( 'wp_ajax_minlpg_credit_charge', 'minlpg_ajax_credit_charge' );

/**
 * REST: betrodd trekk fra dispenser/API (server-to-server).
 * POST /wp-json/minlpg/v1/credit/settle
 */
if ( ! function_exists( 'minlpg_register_credit_rest_routes' ) ) {
function minlpg_register_credit_rest_routes() {
register_rest_route(
'minlpg/v1',
'/credit/settle',
array(
'methods'             => 'POST',
'callback'            => 'minlpg_rest_credit_settle',
'permission_callback' => '__return_true',
'args'                => array(
'ts'          => array( 'required' => true ),
'sig'         => array( 'required' => true ),
'user_id'     => array( 'required' => true ),
'tx_id'       => array( 'required' => true ),
'amount'      => array( 'required' => true ),
'station_id'  => array( 'required' => false ),
'dispenser_id'=> array( 'required' => false ),
),
)
);
}
add_action( 'rest_api_init', 'minlpg_register_credit_rest_routes' );
}

if ( ! function_exists( 'minlpg_rest_credit_settle' ) ) {
function minlpg_rest_credit_settle( WP_REST_Request $request ) {
$params = $request->get_params();

// Verifiser signatur
if ( ! minlpg_credit_verify_device_signature( $params ) ) {
return new WP_REST_Response( array( 'message' => 'Ugyldig signatur.' ), 403 );
}

$user_id     = (int) $params['user_id'];
$tx_id       = (string) $params['tx_id'];
$amount_num  = (float) $params['amount'];
$station_id  = isset( $params['station_id'] ) ? (int) $params['station_id'] : 0;
$dispenser_id= isset( $params['dispenser_id'] ) ? sanitize_text_field( (string) $params['dispenser_id'] ) : '';

list( $ok, $payload, $http ) = minlpg_credit_apply_charge_internal(
$user_id,
$amount_num,
$tx_id,
array(
'is_adminish'  => false,
'station_id'   => $station_id,
'dispenser_id' => $dispenser_id,
'source'       => 'device_api',
)
);

if ( $ok ) {
return new WP_REST_Response( $payload, 200 );
}

return new WP_REST_Response( $payload, $http );
}
}

