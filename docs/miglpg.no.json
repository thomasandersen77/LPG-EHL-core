/*
             * Klippekort – AJAX-håndtering
             */
const ajaxUrl   = root.getAttribute('data-minlpg-klippekort-ajax');
const kkNonce   = root.getAttribute('data-minlpg-klippekort-nonce');
const stationId = root.getAttribute('data-minlpg-klippekort-station');

if (ajaxUrl && kkNonce && stationId) {

function updateKlippekortUI(userId, card) {
if (!card) return;

let txt = card.used + ' / ' + card.size;
if (card.free_ready) {
txt += ' (gratis fylling tilgjengelig)';
}

const badgeSelector = '[data-minlpg-klippekort-badge="' + userId + '"]';
document.querySelectorAll(badgeSelector).forEach(function (el) {
el.textContent = txt;
});

const freeSelector = '[data-minlpg-klippekort-free][data-user-id="' + userId + '"]';
document.querySelectorAll(freeSelector).forEach(function (btn) {
btn.disabled = !card.free_ready;
});
}

function sendKlippekortRequest(action, userId, btn) {
if (!userId) return;

if (btn) {
btn.disabled = true;
}

const formData = new FormData();
formData.append('action', action);
formData.append('nonce', kkNonce);
formData.append('user_id', userId);
formData.append('station_id', stationId);

fetch(ajaxUrl, {
method: 'POST',
body: formData,
credentials: 'same-origin'
})
.then(function (response) { return response.json(); })
.then(function (data) {
if (!data || !data.success || !data.data) {
alert(data && data.data ? data.data : 'Kunne ikke oppdatere klippekort.');
return;
}
updateKlippekortUI(userId, data.data);
})
.catch(function () {
alert('Teknisk feil ved oppdatering av klippekort.');
})
.finally(function () {
if (btn) {
btn.disabled = false;
}
});
}

root.querySelectorAll('[data-minlpg-klippekort-add]').forEach(function (btn) {
btn.addEventListener('click', function (event) {
event.preventDefault();
event.stopPropagation();
const userId = btn.getAttribute('data-user-id');
sendKlippekortRequest('minlpg_klippekort_add_clip', userId, btn);
});
});

root.querySelectorAll('[data-minlpg-klippekort-free]').forEach(function (btn) {
