/**
 * Validate station code on admin profile/user update.
 */
if ( ! function_exists( 'minlpg_station_code_validate' ) ) {
function minlpg_station_code_validate( $errors, $update, $user ) {
if ( ! ( $user instanceof WP_User ) ) {
return;
}

// Only admins can set/override.
if ( ! minlpg_station_code_admin_can_manage( $user->ID ) ) {
return;
}

$is_owner = in_array( 'stasjonseier', (array) $user->roles, true );

$raw = isset( $_POST['minlpg_station_code'] )
? sanitize_text_field( wp_unslash( $_POST['minlpg_station_code'] ) )
: '';

$raw = trim( $raw );
if ( '' === $raw ) {
// Empty is always allowed (auto-assign / keep existing).
return;
}

if ( ! $is_owner ) {
$errors->add( 'minlpg_station_code', 'Stasjons-ID kan kun settes for brukere med rollen Stasjonseier.' );
return;
}

$normalized = minlpg_station_code_normalize( $raw );
if ( '' === $normalized ) {
$errors->add( 'minlpg_station_code', 'Ugyldig Stasjons-ID. Bruk format S001 (eller bare nummer).' );
return;
}

if ( minlpg_station_code_exists( $normalized, $user->ID ) ) {
$errors->add( 'minlpg_station_code', 'Denne Stasjons-ID-en er allerede i bruk.' );
return;
}
}
}
add_action( 'user_profile_update_errors', 'minlpg_station_code_validate', 10, 3 );

/**
 * Save/override station code from admin profile update.
 */
if ( ! function_exists( 'minlpg_station_code_save_profile' ) ) {
function minlpg_station_code_save_profile( $user_id ) {
$user_id = (int) $user_id;
if ( ! $user_id ) {
return;
}

if ( ! minlpg_station_code_admin_can_manage( $user_id ) ) {
return;
}

// Only relevant for station owners.
if ( ! minlpg_station_is_owner( $user_id ) ) {
return;
}

$raw = isset( $_POST['minlpg_station_code'] )
? sanitize_text_field( wp_unslash( $_POST['minlpg_station_code'] ) )
: '';

$raw = trim( $raw );

if ( '' === $raw ) {
// Ensure it exists.
minlpg_get_station_code( $user_id );
return;
}

// Try to set; if it fails (duplicate/invalid), keep existing.
$set = minlpg_station_code_set_for_user( $user_id, $raw );
if ( '' === $set ) {
// Keep existing or auto-generate if empty.
minlpg_get_station_code( $user_id );
}
}
}
