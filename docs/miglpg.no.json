if ( ! minlpg_is_backend_allowed_user_v2( $user ) ) {
show_admin_bar( false );
}
} );

/**
 * 4) Blokker /wp-admin for alle unntatt administrator / lpg_admin
 *    (ajax + admin-post får fortsatt lov)
 */
add_action( 'admin_init', function () {
$user = wp_get_current_user();

if ( minlpg_is_backend_allowed_user_v2( $user ) ) {
return;
}

if ( function_exists( 'wp_doing_ajax' ) && wp_doing_ajax() ) {
return;
