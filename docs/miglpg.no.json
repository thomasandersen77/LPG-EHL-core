<script>
document.addEventListener('DOMContentLoaded', function () {
var searchInput = document.getElementById('minlpg_station_search_<?php echo esc_js( $uid ); ?>');
var selectEl    = document.getElementById('minlpg_station_select_<?php echo esc_js( $uid ); ?>');
var nearestBtn  = document.getElementById('minlpg_nearest_btn_<?php echo esc_js( $uid ); ?>');
var changeBtn   = document.getElementById('minlpg_change_station_<?php echo esc_js( $uid ); ?>');
var panel       = document.getElementById('minlpg_station_panel_<?php echo esc_js( $uid ); ?>');

if (!selectEl) {
return;
}

function filterStations(query) {
var q = (query || '').toLowerCase().trim();
var options = selectEl.querySelectorAll('option');
var visible = [];

Array.prototype.forEach.call(options, function (opt) {
if (opt.value === '0') {
opt.hidden = false;
opt.style.display = '';
return;
}

var text    = (opt.textContent || '').toLowerCase();
var code    = (opt.getAttribute('data-code') || '').toLowerCase();
var address = (opt.getAttribute('data-address') || '').toLowerCase();
var name    = (opt.getAttribute('data-name') || '').toLowerCase();
var haystack = text + ' ' + code + ' ' + address + ' ' + name + ' ' + opt.value;

var hide = q && haystack.indexOf(q) === -1;
opt.hidden = hide;
opt.style.display = hide ? 'none' : '';

if (!hide) {
visible.push(opt);
}
});

// If there are no matches -> reset selection
if (visible.length === 0) {
selectEl.value = '0';
}
// If exactly one station matches, auto-select it
if (visible.length === 1) {
selectEl.value = visible[0].value;
}
}

if (searchInput) {
searchInput.addEventListener('input', function () {
filterStations(this.value);
});
}

if (nearestBtn) {
nearestBtn.addEventListener('click', function () {
var id = this.getAttribute('data-nearest-id');
if (!id) { return; }
selectEl.value = id;
if (searchInput) {
filterStations(searchInput.value);
}
});
}

if (changeBtn && panel) {
changeBtn.addEventListener('click', function () {
var isOpen = panel.getAttribute('data-open') === '1';
if (isOpen) {
panel.style.display = 'none';
panel.setAttribute('data-open', '0');
} else {
panel.style.display = 'block';
panel.setAttribute('data-open', '1');
if (searchInput) {
searchInput.focus();
}
}
});
}

// Initial normalisation (no filter)
filterStations('');
});
</script>
