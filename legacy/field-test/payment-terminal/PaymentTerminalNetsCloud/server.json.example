{
  "bindAddress": "127.0.0.1",
  "bindPort": 8080,
  "databasePath": "./data/payment_terminal.db",
  "receiptStoragePath": "./receipts",
  "receiptRetentionDays": 0,
  "receiptRetentionMaxOperations": 0,
  "financialOperationTimeoutSeconds": 180,
  "adminOperationTimeoutSeconds": 300,
  "enableDiagnostics": false,
  "busyRetry": { "enabled": false, "maxRetrySeconds": 20, "retryDelayMs": 1000 },
  "eventLogPath": null,
  "connectCloud": {
    "environment": "QA",
    "baseUrl": null,
    "username": null,
    "password": null,
    "terminalId": "12345678",
    "ecrIdPrefix": "POS-",
    "operatorIdDefault": "4321",
    "webSocketPath": "/ws/json",
    "loginTimeoutSeconds": 12,
    "openReadyTimeoutSeconds": 60,
    "reconnectBaseDelayMs": 1000,
    "reconnectMaxDelayMs": 30000
  }
}
