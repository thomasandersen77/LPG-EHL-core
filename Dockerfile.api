# Dockerfile for LPG-EHL API
FROM eclipse-temurin:21-jdk-alpine AS build

WORKDIR /build

# Copy Maven wrapper and pom files
COPY .mvn .mvn
COPY mvnw pom.xml ./
COPY lpg-ehl-core/pom.xml lpg-ehl-core/
COPY lpg-ehl-api/pom.xml lpg-ehl-api/
COPY lpg-ehl-emulator/pom.xml lpg-ehl-emulator/

# Download dependencies
RUN ./mvnw dependency:go-offline -pl lpg-ehl-api -am

# Copy source code
COPY lpg-ehl-core/src lpg-ehl-core/src
COPY lpg-ehl-api/src lpg-ehl-api/src

# Build the API module
RUN ./mvnw clean package -pl lpg-ehl-api -am -DskipTests

# Runtime stage
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Install curl for healthcheck
RUN apk add --no-cache curl

# Copy built JAR
COPY --from=build /build/lpg-ehl-api/target/lpg-ehl-api-*.jar app.jar

# Expose API port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8080/actuator/health || exit 1

# Run API
ENTRYPOINT ["java", "-jar", "app.jar"]
